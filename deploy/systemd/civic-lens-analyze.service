[Unit]
Description=Civic Lens analysis pipeline (one-shot)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# On any failure (non-zero exit, kill, timeout), spawn the alerter with
# this unit's name as the %i template arg. The alerter emails a summary
# + last 50 journal lines; requires CIVIC_ALERT_SMTP_* env in
# /etc/civic-lens.env (see .env.example). If the alert env isn't set the
# alerter exits silently so nothing is spammed.
OnFailure=civic-lens-alert@%n.service

[Service]
Type=oneshot
# Root for the docker CLI; the container runs as the unprivileged civic-lens
# UID. Resource caps (MemoryMax 1G equivalent) live on the compose service.
WorkingDirectory=/opt/civic-lens
EnvironmentFile=/etc/civic-lens.env
# Apply pending migrations before every analyze run. deploy.sh migrates on
# deploys, but manual `docker compose run analyze` invocations and image
# pulls outside deploy.sh must never race ahead of the schema (2026-07-10:
# 'no such table: ai_outputs_latest'). Idempotent no-op when current; a
# migration failure aborts the unit before analysis touches the DB. The
# in-runner schema guard (job_runner) is the belt to this suspender for
# invocations that bypass systemd entirely.
ExecStartPre=/bin/sh -c 'docker compose run --rm --quiet-pull ingest migrate --db "${CIVIC_DB_PATH:-/var/lib/civic-lens/data/civic_lens.db}"'
ExecStart=/usr/bin/docker compose run --rm --quiet-pull analyze
# Wall-clock ceiling — hard stop. Paired with the in-runner soft budget
# (CIVIC_BUDGET_SECONDS=6900, set on the compose service) that skips LLM
# stages and jumps to snapshots when wall-clock runs short, so the UI cache
# is always regenerated even when upstream LLM latency is above average.
# The hard ceiling is the safety net for cases the soft budget misses (hung
# TLS handshake, Gemini 500s that retry forever, etc). systemd kills the
# `docker compose run` client; --rm plus docker's signal forwarding tears
# down the container. See docs/audit-trail/infra/ for the budget writeup.
TimeoutStartSec=2h
