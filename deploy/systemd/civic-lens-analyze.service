[Unit]
Description=Civic Lens analysis pipeline (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=civic-lens
Group=civic-lens
WorkingDirectory=/opt/civic-lens
EnvironmentFile=/etc/civic-lens.env
Environment=PYTHONPATH=/opt/civic-lens
ExecStart=/opt/civic-lens/.venv/bin/python -m analysis.src.scheduler.job_runner
# Longer timeout: full pipeline can take 20+ minutes on a cold DB.
TimeoutStartSec=45m

# Hardening (audit §1.14). The LLM client needs outbound HTTPS + DNS.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=~@privileged @debug @module @mount @obsolete @reboot @swap @raw-io @cpu-emulation
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/civic-lens
# Analysis is memory-heavier than the API: narrative clustering + embedding
# fallback + all the aggregators. 1G is conservative for the current volumes
# but cheap insurance.
MemoryMax=1G
CPUQuota=90%
TasksMax=128
