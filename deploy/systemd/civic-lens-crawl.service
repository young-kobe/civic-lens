[Unit]
Description=Civic Lens web crawler (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=civic-lens
Group=civic-lens
# Working dir is the writable data root so relative paths in seeds.yaml
# (raw_dir: data/raw) resolve into /var/lib/civic-lens/data/raw, which is
# under ReadWritePaths. The binary + config are still referenced by
# absolute paths in ExecStart below, so /opt stays read-only.
WorkingDirectory=/var/lib/civic-lens
EnvironmentFile=/etc/civic-lens.env
# Two-phase cycle: `ingest` parses RSS seeds and pushes new URLs onto the
# frontier; `crawl` drains the frontier. Running them as back-to-back
# ExecStart lines inside a single oneshot unit keeps them coupled so a
# scheduled fetch always picks up newly-published articles (walkthrough
# 049 — launch wrap-up).
ExecStart=/opt/civic-lens/civic-ingest ingest \
    --config /opt/civic-lens/data/seeds.yaml \
    --db ${CIVIC_DB_PATH}
ExecStart=/opt/civic-lens/civic-ingest crawl \
    --config /opt/civic-lens/data/seeds.yaml \
    --db ${CIVIC_DB_PATH} \
    --duration 10m

# Hardening (audit §1.14)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=~@privileged @debug @module @mount @obsolete @reboot @swap @raw-io @cpu-emulation
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/civic-lens
MemoryMax=512M
CPUQuota=80%
TasksMax=64
