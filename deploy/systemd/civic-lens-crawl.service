[Unit]
Description=Civic Lens web crawler (one-shot)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
OnFailure=civic-lens-alert@%n.service

[Service]
Type=oneshot
# Runs as root: the docker CLI needs the daemon socket (docker-group access
# is root-equivalent anyway). The workload itself still runs unprivileged —
# the containers drop to the civic-lens UID baked into the images, and the
# systemd sandboxing directives that used to live here are now expressed as
# container isolation + compose mem_limit/cpus caps.
WorkingDirectory=/opt/civic-lens
EnvironmentFile=/etc/civic-lens.env
# Two-phase cycle: `ingest` parses RSS seeds and pushes new URLs onto the
# frontier; `crawl` drains the frontier. Back-to-back ExecStart lines keep
# them coupled so a scheduled fetch always picks up newly-published articles
# (walkthrough 049 — launch wrap-up). `docker compose run --rm` propagates
# the container's exit code, so OnFailure alerting behaves exactly as before.
ExecStart=/usr/bin/docker compose run --rm --quiet-pull ingest ingest \
    --config /app/data/seeds.yaml \
    --db ${CIVIC_DB_PATH}
ExecStart=/usr/bin/docker compose run --rm --quiet-pull ingest crawl \
    --config /app/data/seeds.yaml \
    --db ${CIVIC_DB_PATH} \
    --duration 10m
