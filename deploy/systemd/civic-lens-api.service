[Unit]
Description=Civic Lens API (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=civic-lens
Group=civic-lens
WorkingDirectory=/opt/civic-lens
EnvironmentFile=/etc/civic-lens.env
Environment=PYTHONPATH=/opt/civic-lens
ExecStart=/opt/civic-lens/.venv/bin/uvicorn analysis.src.api.server:app \
    --host ${CIVIC_API_HOST} \
    --port ${CIVIC_API_PORT} \
    --workers 1 \
    --access-log
Restart=on-failure
RestartSec=5s

# Hardening (audit §1.14). uvicorn needs net bind, reads from /opt/civic-lens,
# writes to /var/lib/civic-lens. Nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=~@privileged @debug @module @mount @obsolete @reboot @swap @raw-io @cpu-emulation
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/civic-lens
# Resource caps — uvicorn + pydantic sit comfortably under 256MB. Lifting
# this high enough that a cache-miss live-compute on /narratives with limit
# at the cap doesn't OOM.
MemoryMax=512M
CPUQuota=80%
TasksMax=64

[Install]
WantedBy=multi-user.target
