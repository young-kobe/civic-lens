# No access log exists on purpose: the site blocks have no log directive. The privacy page says that page reads and searches leave no record.
# The default logger keeps error lines for operators. The filter removes every field that names a reader.
{
	admin off
	auto_https off
	http_port {$CIVIC_LENS_CADDY_PORT:8080}
	default_bind 127.0.0.1

	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
			}
		}
	}
}

(noindex) {
	header X-Robots-Tag noindex
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

http://civic-lens.info {
	import noindex
	import security_headers

	root * {$CIVIC_LENS_RELEASE_DIRECTORY}/current
	encode zstd gzip

	header ?Cache-Control "public, max-age=300"

	@manifest path /release.json
	header @manifest Cache-Control "public, max-age=60"

	@photos path_regexp photos ^/photos/[0-9a-f]{64}\.jpg$
	header @photos Cache-Control "public, max-age=31536000, immutable"

	file_server {
		precompressed br gzip
	}

	handle_errors 404 {
		import noindex
		import security_headers
		header Cache-Control "no-store"
		rewrite * /404.html
		file_server
	}

	handle_errors {
		import noindex
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

http://api.civic-lens.info {
	import noindex
	import security_headers

	handle /internal/* {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:{$CIVIC_LENS_API_PORT:8100}
	}
}

http:// {
	import noindex
	import security_headers
	respond 404
}
