# No access log exists on purpose: the site blocks have no log directive. The privacy page says that page reads and searches leave no record.
# The default logger keeps error lines for operators. The filter removes every field that names a reader.
{
	admin off
	auto_https off
	http_port {$CIVIC_LENS_CADDY_PORT:8080}
	default_bind 127.0.0.1

	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
			}
		}
	}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

http://civic-lens.info, http://127.0.0.1 {
	import security_headers

	# The publisher still writes the member photos into the release. Each name holds the hash of its bytes, so a photo never changes.
	@photos path_regexp photos ^/photos/[0-9a-f]{64}\.jpg$
	handle @photos {
		root * {$CIVIC_LENS_RELEASE_DIRECTORY}/current
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The API and its internal routes live on the API host only.
	@api path /v1/* /internal/*
	handle @api {
		respond 404
	}

	# PublicApi serves every page, the shared assets, the sitemap, the robots file, and the not found page at their public paths.
	handle {
		encode zstd gzip
		header {
			+Cache-Control no-transform
			+Vary Accept-Encoding
			defer
		}
		reverse_proxy 127.0.0.1:{$CIVIC_LENS_API_PORT:8100}
	}

	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

http://api.civic-lens.info {
	import security_headers

	@fragments path /v1/zip-districts/*/members
	encode @fragments zstd gzip
	header @fragments {
		+Cache-Control no-transform
		+Vary Accept-Encoding
		defer
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:{$CIVIC_LENS_API_PORT:8100}
	}

	handle {
		respond 404
	}
}

http:// {
	import security_headers
	respond 404
}
