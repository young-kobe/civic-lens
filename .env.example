# Civic Lens Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# LLM Backend Configuration
# ============================================

# LLM Backend: "gemini" (cloud API) or "ollama" (local inference)
CIVIC_LLM_BACKEND=gemini

# Enable LLM features (set to true once configured)
CIVIC_LLM_ENABLED=false

# --------------------------------------------
# Gemini (Google Cloud) Settings
# --------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
CIVIC_GEMINI_API_KEY=
CIVIC_GEMINI_MODEL=gemini-2.0-flash
CIVIC_GEMINI_TEMPERATURE=0.0

# --------------------------------------------
# Ollama (Local Inference) Settings
# --------------------------------------------
# For running on Jetson Orin Nano or other local hardware
# See docs/OLLAMA_SETUP.md for setup instructions

# Ollama server URL (use the Nano's IP for remote access)
CIVIC_OLLAMA_HOST=http://localhost:11434

# Model to use (must be pulled on the Ollama server)
# Recommended for 8GB RAM: llama3.2:3b, phi3:mini, gemma2:2b
CIVIC_OLLAMA_MODEL=llama3.2:3b

# Timeout in seconds (local inference is slower, increase if needed)
CIVIC_OLLAMA_TIMEOUT=120

# ============================================
# Database & Cache
# ============================================
CIVIC_DB_PATH=data/civic_lens.db
CIVIC_CACHE_DIR=data/cache

# ============================================
# API Server
# ============================================
CIVIC_API_HOST=0.0.0.0
CIVIC_API_PORT=8000

# Shared-secret that gates every admin endpoint (/api/run/*, /api/review/*,
# /api/cache-status). Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Visit the UI once with ?admin=<this-value> to persist it to localStorage.
# If unset, the server returns 503 on all gated endpoints.
CIVIC_ADMIN_TOKEN=

# ============================================
# Logging
# ============================================
CIVIC_LOG_LEVEL=INFO
CIVIC_ENVIRONMENT=development
