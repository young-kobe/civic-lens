# Civic Lens Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# LLM Backend Configuration
# ============================================

# LLM Backend: "gemini" (cloud API), "ollama" (local inference), or
# "openai_compat" (any OpenAI-compatible /v1 server — LiteLLM, vLLM, a
# serverless GPU endpoint, or a custom token router)
CIVIC_LLM_BACKEND=gemini

# Enable LLM features (set to true once configured)
CIVIC_LLM_ENABLED=false

# Max concurrent LLM calls per analysis stage. Stages are network-bound
# (~10s/call), so this cuts stage wall-clock roughly linearly. DB writes stay
# serial regardless. Keep at/under the backend's rate limit (Gemini caps
# in-flight remote calls around 10).
CIVIC_LLM_CONCURRENCY=5

# --------------------------------------------
# Gemini (Google Cloud) Settings
# --------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
CIVIC_GEMINI_API_KEY=
CIVIC_GEMINI_MODEL=gemini-3.5-flash
CIVIC_GEMINI_TEMPERATURE=0.0

# --------------------------------------------
# OpenAI-compatible backend Settings
# --------------------------------------------
# Only used when CIVIC_LLM_BACKEND=openai_compat. Point at any /v1 server;
# swapping inference providers later is just changing these values.
CIVIC_LLM_BASE_URL=
CIVIC_LLM_API_KEY=
CIVIC_LLM_MODEL=
# Optional separate embeddings model (narrative clustering); falls back to
# CIVIC_LLM_MODEL when unset.
CIVIC_LLM_EMBEDDING_MODEL=
CIVIC_LLM_TIMEOUT=120

# --------------------------------------------
# Ollama (Local Inference) Settings
# --------------------------------------------
# For running on Jetson Orin Nano or other local hardware
# See docs/OLLAMA_SETUP.md for setup instructions

# Ollama server URL (use the Nano's IP for remote access)
CIVIC_OLLAMA_HOST=http://localhost:11434

# Model to use (must be pulled on the Ollama server)
# Recommended for 8GB RAM: llama3.2:3b, phi3:mini, gemma2:2b
CIVIC_OLLAMA_MODEL=llama3.2:3b

# Timeout in seconds (local inference is slower, increase if needed)
CIVIC_OLLAMA_TIMEOUT=120

# ============================================
# Analysis scope
# ============================================
# Which source_types the LLM stages analyze: "all" | "social_media" | "x".
# Defaults to "social_media" (reddit + x only), which leaves news docs
# without ai_outputs rows — every dashboard news section renders empty.
# Set to "all" unless you are deliberately scoping a dev run.
CIVIC_RUN_ANALYSIS_ON=all

# ============================================
# Database & Cache
# ============================================
CIVIC_DB_PATH=data/civic_lens.db
CIVIC_CACHE_DIR=data/cache

# --------------------------------------------
# Postgres (pg-redesign Phase 1 groundwork — NOT yet live; nothing reads or
# writes this DB yet. See docs/todos/pg-redesign.md.)
# --------------------------------------------
# Drives the `postgres` service in docker-compose.yml (`./run.sh pg` in dev).
# No defaults on the password on purpose — `docker compose up postgres`
# fails loud if POSTGRES_PASSWORD is unset rather than starting insecurely.
POSTGRES_DB=civic_lens
POSTGRES_USER=civic
POSTGRES_PASSWORD=CHANGE_ME
# Consumed by future Python code (analysis/src/common/db.py, Phase 1) once
# the app layer starts talking to Postgres. Keep in sync with the POSTGRES_*
# values above.
CIVIC_DATABASE_URL=postgresql://civic:CHANGE_ME@127.0.0.1:5432/civic_lens

# ============================================
# API Server
# ============================================
# 0.0.0.0 exposes uvicorn on every interface — fine for dev (Vite proxy +
# curl on the same box). In production, set this to 127.0.0.1 so the API is
# reachable only through Caddy on the same host; the origin firewall
# additionally pins :80/:443 to Cloudflare IPs (audit §1.9).
CIVIC_API_HOST=0.0.0.0
CIVIC_API_PORT=8000

# Shared-secret that gates every admin endpoint (/api/run/*, /api/review/*,
# /api/cache-status). Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Visit the UI once with ?admin=<this-value> to persist it to localStorage.
# If unset, the server returns 503 on all gated endpoints.
CIVIC_ADMIN_TOKEN=

# ============================================
# Logging
# ============================================
CIVIC_LOG_LEVEL=INFO
CIVIC_ENVIRONMENT=development

# ============================================
# X (Twitter) ingestion
# ============================================
# Bearer token for the X v2 API (/2/tweets/search/recent). Required for the
# civic-lens-x.service timer to run. Get a token from
# https://developer.x.com/ (free tier covers /search/recent).
# Alternative: set `x.bearer_token` in data/seeds.yaml, but env var is
# preferred so the token isn't committed to the repo.
X_BEARER_TOKEN=

# ============================================
# Litestream (continuous SQLite replication to R2)
# ============================================
# Consumed by the litestream compose service (deploy/litestream.yml).
# Create an R2 API token scoped to the replication bucket only — keep it
# separate from the rclone token used by the nightly backup.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Account host ONLY — no bucket, no path, no trailing slash. Litestream builds
# each request as endpoint + "/" + bucket + "/" + key, so a bucket left in the
# endpoint gets doubled (.../civic-lens-litestream/civic-lens-litestream/...)
# and every operation 404s with NoSuchKey. The replica can then never truncate
# its local shadow WAL, which grows until it fills the disk.
#   correct:   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   WRONG:     https://<ACCOUNT_ID>.r2.cloudflarestorage.com/civic-lens-litestream
LITESTREAM_R2_ENDPOINT=
# Bucket name goes here and ONLY here.
LITESTREAM_R2_BUCKET=

# ============================================
# Failure alerting (email)
# ============================================
# Wires systemd `OnFailure=` on civic-lens-* services + in-runner "partial"
# alerts to an SMTP sender. When any of the SMTP vars is unset, the alerter
# silently skips — nothing is sent. Leave blank in dev to suppress alerts.
#
# For Gmail, you MUST use an App Password (https://myaccount.google.com/apppasswords),
# NOT your login password. Two-factor auth is required on the Google account
# before App Passwords become available.
CIVIC_ALERT_SMTP_HOST=smtp.gmail.com
CIVIC_ALERT_SMTP_PORT=587
CIVIC_ALERT_SMTP_USER=
CIVIC_ALERT_SMTP_PASS=
CIVIC_ALERT_TO=
# Optional — defaults to CIVIC_ALERT_SMTP_USER.
CIVIC_ALERT_FROM=
