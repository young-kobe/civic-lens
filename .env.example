# Civic Lens Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# LLM Backend Configuration
# ============================================

# LLM Backend: "gemini" (cloud API) or "ollama" (local inference)
CIVIC_LLM_BACKEND=gemini

# Enable LLM features (set to true once configured)
CIVIC_LLM_ENABLED=false

# --------------------------------------------
# Gemini (Google Cloud) Settings
# --------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
CIVIC_GEMINI_API_KEY=
CIVIC_GEMINI_MODEL=gemini-2.0-flash
CIVIC_GEMINI_TEMPERATURE=0.0

# --------------------------------------------
# Ollama (Local Inference) Settings
# --------------------------------------------
# For running on Jetson Orin Nano or other local hardware
# See docs/OLLAMA_SETUP.md for setup instructions

# Ollama server URL (use the Nano's IP for remote access)
CIVIC_OLLAMA_HOST=http://localhost:11434

# Model to use (must be pulled on the Ollama server)
# Recommended for 8GB RAM: llama3.2:3b, phi3:mini, gemma2:2b
CIVIC_OLLAMA_MODEL=llama3.2:3b

# Timeout in seconds (local inference is slower, increase if needed)
CIVIC_OLLAMA_TIMEOUT=120

# ============================================
# Database & Cache
# ============================================
CIVIC_DB_PATH=data/civic_lens.db
CIVIC_CACHE_DIR=data/cache

# ============================================
# API Server
# ============================================
# 0.0.0.0 exposes uvicorn on every interface — fine for dev (Vite proxy +
# curl on the same box). In production, set this to 127.0.0.1 so the API is
# reachable only through Caddy on the same host; the origin firewall
# additionally pins :80/:443 to Cloudflare IPs (audit §1.9).
CIVIC_API_HOST=0.0.0.0
CIVIC_API_PORT=8000

# Shared-secret that gates every admin endpoint (/api/run/*, /api/review/*,
# /api/cache-status). Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Visit the UI once with ?admin=<this-value> to persist it to localStorage.
# If unset, the server returns 503 on all gated endpoints.
CIVIC_ADMIN_TOKEN=

# ============================================
# Logging
# ============================================
CIVIC_LOG_LEVEL=INFO
CIVIC_ENVIRONMENT=development

# ============================================
# X (Twitter) ingestion
# ============================================
# Bearer token for the X v2 API (/2/tweets/search/recent). Required for the
# civic-lens-x.service timer to run. Get a token from
# https://developer.x.com/ (free tier covers /search/recent).
# Alternative: set `x.bearer_token` in data/seeds.yaml, but env var is
# preferred so the token isn't committed to the repo.
X_BEARER_TOKEN=

# ============================================
# Litestream (continuous SQLite replication to R2)
# ============================================
# Consumed by the litestream compose service (deploy/litestream.yml).
# Create an R2 API token scoped to the replication bucket only — keep it
# separate from the rclone token used by the nightly backup.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
LITESTREAM_R2_ENDPOINT=
LITESTREAM_R2_BUCKET=

# ============================================
# Failure alerting (email)
# ============================================
# Wires systemd `OnFailure=` on civic-lens-* services + in-runner "partial"
# alerts to an SMTP sender. When any of the SMTP vars is unset, the alerter
# silently skips — nothing is sent. Leave blank in dev to suppress alerts.
#
# For Gmail, you MUST use an App Password (https://myaccount.google.com/apppasswords),
# NOT your login password. Two-factor auth is required on the Google account
# before App Passwords become available.
CIVIC_ALERT_SMTP_HOST=smtp.gmail.com
CIVIC_ALERT_SMTP_PORT=587
CIVIC_ALERT_SMTP_USER=
CIVIC_ALERT_SMTP_PASS=
CIVIC_ALERT_TO=
# Optional — defaults to CIVIC_ALERT_SMTP_USER.
CIVIC_ALERT_FROM=
