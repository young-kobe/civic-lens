@using CivicLens.Publication.Contracts

@foreach (var paragraph in Paragraphs)
{
    <p class="record-body">
        @paragraph.Text
        @foreach (var id in paragraph.CitationIds)
        {
            <a class="small" href="@("#" + PublishedBriefView.CitationAnchor(id))">[@id]</a>
        }
    </p>
}

@code {
    [Parameter, EditorRequired] public PublishedBriefParagraph[] Paragraphs { get; set; } = [];
}
