@using CivicLens.Publication.Contracts

@if (Corrections.Length > 0)
{
    <section class="detail-section" aria-labelledby="corrections-title">
        <h2 id="corrections-title">Corrections</h2>
        <ul class="choices corrections">
            @foreach (var correction in Corrections)
            {
                <li>
                    <strong>@if (correction.Note is not null) {<Term Key="correction">@PublishedCorrectionView.Title(correction)</Term>} else {<text>@PublishedCorrectionView.Title(correction)</text>}@PublishedCorrectionView.AfterTitle(correction, Kind)</strong>
                    @if (correction.Note is not null)
                    {
                        <p>@correction.Note</p>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    [Parameter, EditorRequired] public PublishedCorrection[] Corrections { get; set; } = [];

    /// <summary>The kind of the record that the corrections belong to.</summary>
    [Parameter, EditorRequired] public PublishedRecordKind Kind { get; set; }
}
