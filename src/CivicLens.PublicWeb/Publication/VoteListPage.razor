@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Ui

<RecordListFrame Kind="PublishedRecordKind.Vote" RootPath="@RootPath" Total="Data.VotesInRelease" RowCount="Data.Votes.Count" Filter="Data.Filter" Chips="Chips" NextCursor="@Data.NextCursor"
                 Lede="House and Senate roll call votes, newest first. To see how one member voted, open their page from Officials."
                 FilterSummary="Filter by chamber, issue or date" Singular="vote" Plural="votes" EmptyTitle="No vote matches these filters.">
    <Meta><a href="@(RootPath + PublicationProtocol.OfficialsPagePath)">Officials</a></Meta>
    <Fields>
        <RecordListSelect Id="votes-chamber" Name="chamber" Label="Chamber" Choices="Chambers" Selected="@Data.Filter.Value("chamber")" AnyText="All" />
        <RecordListSelect Id="votes-kind" Name="kind" Label="Kind of vote" Choices="Data.Kinds" Selected="@Data.Filter.Value("kind")" />
        <RecordListSelect Id="votes-issue" Name="issue" Label="Issue" Choices="Data.Issues" Selected="@Data.Filter.Value("issue")" />
        <Field Label="Bill number" For="votes-bill"><input id="votes-bill" type="search" name="bill" placeholder="H.R. 5334" autocomplete="off" value="@Data.Filter.Value("bill")" /></Field>
        <RecordListDates IdPrefix="votes" Filter="Data.Filter" />
    </Fields>
    <EmptyTips>
        <li>Clear one filter, such as the kind of vote.</li>
        <li>Use a wider date range.</li>
        <li>Search a bill number, such as <a href="@(RootPath + PublicationProtocol.SearchPagePath)?q=5334">5334</a>.</li>
        <li><a href="@(RootPath + PublicationProtocol.SearchPagePath)">Search all records</a></li>
    </EmptyTips>
    <Rows>
        @foreach (var vote in Data.Votes)
        {
            <PublicRecordRow Icon="IconName.Vote" Href="@(RootPath + PublicationProtocol.RecordPagePath(vote.RecordId))" Headline="@vote.Headline" Label="@vote.Label"
                             Meta="@Meta(vote)" Yea="vote.Yea" Nay="vote.Nay" ResultWords="@(PlainVoteWords.ResultWord(vote.Result) ?? vote.Result)">
                @if (VoteWords.Badge(vote.Alignment) is { } badge)
                {
                    <p><StatusBadge Text="@badge.Text" /></p>
                }
            </PublicRecordRow>
        }
    </Rows>
</RecordListFrame>

@code {
    [Parameter, EditorRequired] public VoteListPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    private static readonly SearchChoiceData[] Chambers = [new("house", "House"), new("senate", "Senate")];

    /// <summary>The chips in the order of the mockup: chamber, kind of vote, bill number, issue.</summary>
    private IReadOnlyList<string?> Chips =>
    [
        RecordListSelect.LabelOf(Chambers, Data.Filter.Value("chamber")), RecordListSelect.LabelOf(Data.Kinds, Data.Filter.Value("kind")),
        Data.Filter.Value("bill") is { } bill ? $"Bill {bill}" : null, RecordListSelect.LabelOf(Data.Issues, Data.Filter.Value("issue"))
    ];

    private static string Meta(VoteListRowData vote) => string.Join(", ", new[]
    {
        $"Voted on {Moment.Day(vote.VotedOn)}", $"{vote.Chamber} roll call {vote.RollCall}", PlainVoteWords.Kind(vote.Kind), vote.BillNumber
    }.OfType<string>());
}
