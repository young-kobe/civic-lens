@using CivicLens.Publication.Contracts

<section class="shared-vote-rows" data-chamber="@Data.Chamber.ToString().ToLowerInvariant()">
    <h2>How your @(Data.Chamber == PublishedChamber.Senate ? "senators" : "House members") voted</h2>
    <ul class="shared-vote-list" role="list">
        @foreach (var vote in Data.Votes)
        {
            <li class="shared-vote-row">
                <span class="shared-vote-icon" aria-hidden="true"><Icon Name="IconName.Vote" /></span>
                <div class="shared-vote-content">
                    <div class="shared-vote-summary">
                        <h3><a href="@(RootPath + PublicationProtocol.RecordPagePath(vote.RecordId))">@vote.Headline</a></h3>
                        <p class="shared-vote-meta">
                            <time datetime="@vote.VotedOn.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@Moment.Day(vote.VotedOn)</time>, roll call @vote.RollCall, @CongressCalendar.Ordinal(vote.Congress) Congress, session @vote.Session. @(vote.KindWords). Result: @vote.ResultWords
                            @if (vote.Label is not null)
                            {
                                <span class="shared-vote-label">@vote.Label</span>
                            }
                            @if (vote.MembersVotedTheSame is { } membersVotedTheSame)
                            {
                                <span class="shared-vote-comparison">@(membersVotedTheSame ? "Same vote" : "Voted differently")</span>
                            }
                        </p>
                    </div>
                @if (vote.Casts.Length > 0)
                {
                    <ul class="shared-vote-casts" role="list">
                        @{ var castsByOfficialId = vote.Casts.ToDictionary(cast => cast.OfficialId); }
                        @foreach (var member in Data.Members)
                        {
                            if (castsByOfficialId.TryGetValue(member.OfficialId, out var cast))
                            {
                                <li class="shared-vote-cast">
                                    <span class="shared-vote-member">@member.Name</span>
                                    <span class="shared-vote-cast-value" data-side="@(cast.Side?.ToLowerInvariant())">@cast.CastWords</span>
                                </li>
                            }
                        }
                    </ul>
                }
                </div>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired] public SharedVoteRowsData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;
}
