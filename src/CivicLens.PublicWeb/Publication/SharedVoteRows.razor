@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Ui
@{
    var compared = Data.Votes.Count(vote => vote.MembersVotedTheSame is not null);
    var different = Data.Votes.Count(vote => vote.MembersVotedTheSame == false);
    var displayedVotes = DifferencesOnly ? Data.Votes.Where(vote => vote.MembersVotedTheSame == false).ToArray() : Data.Votes;
}

<section class="shared-vote-rows@(SingleMember ? " single" : "")" data-chamber="@Data.Chamber.ToString().ToLowerInvariant()">
    @if (!SingleMember)
    {
        @Heading(HeadingLevel, DifferencesOnly ? "Votes where your members differed" : $"How your {(Data.Chamber == PublishedChamber.Senate ? "senators" : "House members")} voted")
        <p class="shared-vote-caption">Up to 10 recent published votes on passage, amendments, conference reports, veto overrides and nominations.</p>
        @if (compared > 0)
        {
            <p class="shared-vote-caption shared-vote-comparison-caption">The comparison includes @compared @(compared == 1 ? "vote" : "votes") where every listed member cast Yes or No. Their votes differed on @different.</p>
        }
    }
    <ul class="shared-vote-list" role="list">
        @for (var index = 0; index < displayedVotes.Length; index++)
        {
            var vote = displayedVotes[index];
            <li class="shared-vote-row">
                <span class="shared-vote-icon" aria-hidden="true"><Icon Name="IconName.Vote" /></span>
                <div class="shared-vote-content">
                    <div class="shared-vote-summary">
                        @RowHeading(vote)
                        <p class="shared-vote-meta">
                            <time datetime="@vote.VotedOn.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@Moment.Day(vote.VotedOn)</time>, @(vote.Chamber is { } chamber ? VoteWords.RollCall(chamber, vote.RollCall) : $"roll call {vote.RollCall}"), @CongressCalendar.Ordinal(vote.Congress) Congress, session @vote.Session. @(vote.KindWords). Result: @vote.ResultWords
                            @if (vote.Label is not null)
                            {
                                <span class="shared-vote-label" data-origin="@(vote.TextOrigin == PublishedTextOrigin.Model ? "model" : null)">@vote.Label</span>
                            }
                            @if (!SingleMember && vote.MembersVotedTheSame is { } membersVotedTheSame)
                            {
                                <span class="shared-vote-comparison">@(membersVotedTheSame ? "Same vote" : "Voted differently")</span>
                            }
                            @if (VoteWords.Badge(vote.Alignment) is { } badge)
                            {
                                <StatusBadge Text="@badge.Text" />
                            }
                        </p>
                        @if (vote.Totals is { } totals)
                        {
                            <PartyBar Id="@($"shared-vote-{index}")" Data="totals" />
                        }
                    </div>
                @if (vote.Casts.Length > 0)
                {
                    <ul class="shared-vote-casts" role="list">
                        @{ var castsByOfficialId = vote.Casts.ToDictionary(cast => cast.OfficialId); }
                        @foreach (var member in Data.Members)
                        {
                            if (castsByOfficialId.TryGetValue(member.OfficialId, out var cast))
                            {
                                <li class="shared-vote-cast">
                                    @if (!SingleMember)
                                    {
                                        <span class="shared-vote-member">@member.Name</span>
                                    }
                                    <SharedVoteCast Side="@cast.Side">@cast.CastWords</SharedVoteCast>
                                </li>
                            }
                        }
                    </ul>
                }
                </div>
            </li>
        }
    </ul>
    @if (displayedVotes.Length == 0)
    {
        <p class="muted" data-member-votes-empty>@(DifferencesOnly ? NoDifferences : "No records match.")</p>
    }
</section>

@code {
    /// <summary>The empty line of the differences-only mode. <see cref="ChamberDifferences"/> shows it too when a chamber has no shared votes.</summary>
    public const string NoDifferences = "No differing votes in this selection.";

    [Parameter, EditorRequired] public SharedVoteRowsData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;
    [Parameter] public bool DifferencesOnly { get; set; }
    /// <summary>One member's page: no heading, no captions, no comparison, and each row shows only that member's cast without the name.</summary>
    [Parameter] public bool SingleMember { get; set; }

    /// <summary>The level of the section heading. Its row headings are one level lower. The default 2 suits a page whose h1 is the only heading above the section.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 2;

    private RenderFragment RowHeading(SharedVoteRowData vote) => Heading(HeadingLevel + 1, builder =>
    {
        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "href", RootPath + PublicationProtocol.RecordPagePath(vote.RecordId));
        builder.AddContent(2, vote.Headline);
        builder.CloseElement();
    }, "shared-vote-title");

    private static RenderFragment Heading(int level, string text) => Heading(level, builder => builder.AddContent(0, text));

    private static RenderFragment Heading(int level, RenderFragment content, string? cssClass = null) => builder =>
    {
        builder.OpenElement(0, "h" + level);
        builder.AddAttribute(1, "class", cssClass);
        builder.AddContent(2, content);
        builder.CloseElement();
    };
}
