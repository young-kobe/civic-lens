@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.Glossary" CanonicalPath="@PublicationProtocol.GlossaryPagePath" Title="Glossary" Description="@Glossary.PageDescription">
    <PageHeader Title="Glossary" />
    <Panel Title="Index of terms" Padded="true">
        <nav class="glossary-index" aria-label="@Glossary.IndexLabel">
            <ul class="glossary-index-letters">
                @foreach (var group in IndexGroups)
                {
                    <li><a href="@($"#glossary-index-{char.ToLowerInvariant(group.Letter)}")">@group.Letter</a></li>
                }
            </ul>
            <ul class="glossary-index-groups">
                @foreach (var group in IndexGroups)
                {
                    <li>
                        <h3 id="@($"glossary-index-{char.ToLowerInvariant(group.Letter)}")" tabindex="-1">@group.Letter</h3>
                        <ul class="glossary-index-terms">
                            @foreach (var entry in group.Entries)
                            {
                                <li><a href="@($"#{entry.AnchorId}")">@entry.Name</a></li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        </nav>
    </Panel>
    @foreach (var group in Glossary.Groups)
    {
        <Panel Title="@group.Title" Id="@group.AnchorId" Padded="true">
            @if (group.Title == Glossary.KindsOfVotes)
            {
                <p><a href="@PublicationProtocol.VoteKindsPagePath">@Glossary.KindsOfVotes</a></p>
            }
            @foreach (var term in group.Terms)
            {
                <section class="glossary-term" aria-labelledby="@term.AnchorId">
                    <h3 id="@term.AnchorId">@term.Name</h3>
                    <dl>
                        <dt>Means</dt>
                        <dd>@term.Means</dd>
                        <dt>Why it matters</dt>
                        <dd>@term.WhyItMatters</dd>
                        <dt>Source</dt>
                        <dd>
                            @if (term.SourceHref is { } sourceHref)
                            {
                                <a href="@sourceHref">@term.Source</a>
                            }
                            else
                            {
                                @term.Source
                            }
                        </dd>
                    </dl>
                    @if (term.LongForm is not null)
                    {
                        <p>@term.LongForm</p>
                    }
                </section>
            }
            @if (group == Glossary.PartyCountGroup)
            {
                <section class="glossary-term" aria-labelledby="@Glossary.PartyCountAnchorId">
                    <h3 id="@Glossary.PartyCountAnchorId">@Glossary.PartyCountHeading</h3>
                    <ul>
                        @foreach (var rule in Glossary.PartyCountRules)
                        {
                            <li>@rule</li>
                        }
                    </ul>
                </section>
            }
        </Panel>
    }
</PublicPage>

@code {
    private static readonly IReadOnlyList<GlossaryIndexGroup> IndexGroups = BuildIndexGroups();

    private static IReadOnlyList<GlossaryIndexGroup> BuildIndexGroups()
    {
        var entries = Glossary.Groups
            .SelectMany(group => group.Terms)
            .Select(term => new GlossaryIndexEntry(term.Name, term.AnchorId))
            .Append(new GlossaryIndexEntry(Glossary.PartyCountHeading, Glossary.PartyCountAnchorId))
            .OrderBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase);

        return entries
            .GroupBy(entry => char.ToUpperInvariant(entry.Name[0]))
            .Select(group => new GlossaryIndexGroup(group.Key, group.ToArray()))
            .ToArray();
    }

    private sealed record GlossaryIndexEntry(string Name, string AnchorId);

    private sealed record GlossaryIndexGroup(char Letter, IReadOnlyList<GlossaryIndexEntry> Entries);
}
