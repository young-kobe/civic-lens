@using System.Globalization
@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Evidence
@using CivicLens.PublicWeb.Components.Ui

<PublicPage Section="PublicSection.AllRecords" CanonicalPath="@PublicationProtocol.RecordPagePath(Data.RecordId)" Title="@Data.Headline" Description="@(Data.BillLine ?? Data.Title)" IsArticle="true"
            Record="record" RootPath="@RootPath">
    <div class="bill-page">
        <header class="bill-head">
            <p class="bill-eyebrow">Bill in the @CongressCalendar.Ordinal(Data.Congress) Congress</p>
            <h1>@Data.Number, @Data.Title</h1>
            @if (Data.StatusLabel is not null)
            {
                <p class="bill-status"><StatusBadge Text="@Data.StatusLabel" /></p>
            }
            @if (Data.BillLine is not null)
            {
                <p class="bill-line-row"><PublishedBillLine Line="@Data.BillLine" /></p>
                <PublishedBillLineNote />
            }
            @if (Lede() is { Length: > 0 } lede)
            {
                <p class="bill-lede">@lede</p>
            }
            <PublishedUpdateLine Corrections="Data.Corrections" />
        </header>
        <PublishedCorrectionBanner Kind="PublishedRecordKind.Action" Corrections="Data.Corrections" />
        @if (Data.Steps.Length > 0)
        {
            <BillStepper Steps="Data.Steps" />
        }
        <p class="bill-legend"><b>How a bill becomes law.</b> @Glossary.Term("bill").WhyItMatters <a href="@(RootPath + PublicationProtocol.GlossaryPagePath + "#" + Glossary.Term("bill").AnchorId)">Open the glossary</a></p>

        <div class="bill-layout">
            <div class="bill-main">
                @if (Data.ShowsSummary)
                {
                    <AiSummary TextOrigin="@Data.TextOrigin" Label="@Data.Label" Check="CrsCheck">
                        <GlossaryContent Context="use">
                            <p>@AiText.Render(use, Data.Summary, Data.TextOrigin, termCandidates)</p>
                            @SentenceQuotes(PublishedTextPart.Summary)
                            @if (Data.WhyItMatters is { } whyItMatters)
                            {
                                <h2 class="bill-why-title">@BillTextWords.WhyItMattersHeading</h2>
                                <p>@AiText.Render(use, whyItMatters, Data.TextOrigin, termCandidates)</p>
                                @SentenceQuotes(PublishedTextPart.WhyItMatters)
                            }
                        </GlossaryContent>
                    </AiSummary>
                }
                @if (Data.CrsText is not null && Data.ShowsSummary)
                {
                    <SourceFold Summary="@PublishedWording.CrsTextTag" FoldId="@CrsFoldId">
                        @CrsParagraphs(Data.CrsText)
                    </SourceFold>
                }
                else if (Data.CrsText is not null)
                {
                    <section class="bill-crs" aria-labelledby="bill-crs-title">
                        <h2 id="bill-crs-title" class="bill-crs-tag">@PublishedWording.CrsTextTag</h2>
                        @CrsParagraphs(Data.CrsText)
                    </section>
                }
                else if (!Data.ShowsSummary)
                {
                    <p class="bill-no-summary">@PublishedWording.NoBillSummary</p>
                }
                @if (Data.KeyTerms.Length > 0)
                {
                    <section class="bill-terms" aria-labelledby="bill-terms-title">
                        <h2 id="bill-terms-title">Key terms</h2>
                        <AiSummary TextOrigin="@Data.TextOrigin" Label="@Data.KeyTermsLabel">
                            <dl class="bill-terms-list">
                                @foreach (var term in Data.KeyTerms)
                                {
                                    <div class="bill-term">
                                        <dt>@term.Term</dt>
                                        <dd>
                                            <blockquote class="quote">"@EncodedEvidence.Markup(term.Quote)"</blockquote>
                                            @if (term.Cut)
                                            {
                                                <p class="bill-term-cut">@KeyTermCut()</p>
                                            }
                                        </dd>
                                    </div>
                                }
                            </dl>
                        </AiSummary>
                    </section>
                }
                @if (Data.Votes.Length > 0 || Data.SenateVoteGap)
                {
                    <section class="bill-section bill-votes" aria-labelledby="bill-votes-title">
                        <h2 id="bill-votes-title">Votes on this bill</h2>
                        <p class="bill-lede">Votes on this site that name @Data.Number.</p>
                        @if (Data.Votes.Length > 0)
                        {
                            <SharedVoteRows Data="voteRows" RootPath="@RootPath" SingleMember="true" LabelLook="AiLabelLook.Line" />
                        }
                        @if (Data.SenateVoteGap)
                        {
                            <p class="small muted">This site has no Senate roll call vote on this bill.</p>
                        }
                    </section>
                }
                @if (Data.Cosponsors is { } cosponsors)
                {
                    <BillCosponsors Cosponsors="cosponsors" Sponsor="Data.Sponsors.FirstOrDefault()" Introduced="Data.Introduced" RootPath="@RootPath" />
                }
            </div>

            <aside class="bill-rail" aria-label="Key facts">
                <div class="bill-card bill-card-raised bill-members" data-bill-members data-record-id="@Data.RecordId" data-release="@Data.Release">
                    <h2 class="bill-card-heading">Your members and this bill</h2>
                    <div data-bill-members-body></div>
                    <p class="small muted" data-bill-members-prompt>Enter your ZIP to see how your members relate to this bill. <a href="@(RootPath + PublicationProtocol.YourMembersPath)">Find my members</a></p>
                </div>
                @if (Data.Issues.Length > 0 || Data.PolicyArea is not null)
                {
                    <div class="bill-card">
                        <h2 class="bill-card-title">Issues and area</h2>
                        @foreach (var issue in Data.Issues)
                        {
                            <LinkChip Href="@(RootPath + PublicationProtocol.IssuePagePath(issue.IssueId, 1))">@issue.Name</LinkChip>
                        }
                        @if (Data.PolicyArea is not null)
                        {
                            <p class="small muted">Policy area from Congress.gov: @Data.PolicyArea.</p>
                        }
                    </div>
                }
                <PublishedCorrectionList Kind="PublishedRecordKind.Action" Corrections="Data.Corrections" />
                <SourceFold>
                    <dl class="bill-kv">
                        @if (Data.Status is not null && Data.StatusDate is { } statusDate)
                        {
                            <dt>Latest action</dt>
                            <dd>@Data.Status Action date @Moment.Day(statusDate).@if (Data.StatusReadAtUtc is { } read){<text> Status read @Moment.Full(read). The bill can change after this time.</text>}</dd>
                        }
                        @if (Data.CrsVersion is not null)
                        {
                            <dt>CRS summary</dt>
                            <dd>Version @Data.CrsVersion</dd>
                        }
                        @if (Data.BillText is { } text)
                        {
                            <dt>Bill text</dt>
                            <dd>@TextSourceLine(text)</dd>
                        }
                        @if (Data.CheckedAtUtc is { } checkedAt && Data.FirstPublishedAtUtc is { } firstPublished)
                        {
                            <dt>Checked</dt>
                            <dd>@Moment.Full(checkedAt). First published @Moment.Full(firstPublished).</dd>
                        }
                        @if (Data.ShowsSummary && Data.Label is not null)
                        {
                            <dt>@PublishedRecordLabels.WordingFact</dt>
                            <dd><AiLabel Text="@Data.Label" Origin="Data.TextOrigin" /></dd>
                        }
                        <dt>Official bill page</dt>
                        <dd><a href="@Data.CongressGovUrl" rel="noopener noreferrer">@CongressGovLinkText</a></dd>
                        <dt>Revision</dt>
                        <dd>@Data.RevisionNumber.ToString(CultureInfo.InvariantCulture)</dd>
                    </dl>
                </SourceFold>
            </aside>
        </div>
    </div>
</PublicPage>

@code {
    private ReportedRecord record = default!;
    private SharedVoteRowsData voteRows = default!;
    private AiText.Candidate[]? termCandidates;

    [Parameter, EditorRequired] public BillPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = string.Empty;

    private const string CrsFoldId = "crs-source";
    private const string CongressGovLinkText = "Bill on Congress.gov";

    private RenderFragment? CrsCheck => !Data.SummaryFromCrs ? null
        : @<text>The text above summarizes the Congressional Research Service summary. <a href="#@CrsFoldId">@SourceFold.Title</a></text>;

    protected override void OnParametersSet()
    {
        record = new ReportedRecord(Data.RecordId, Data.RevisionNumber, PublishedRecordKind.Action, Data.Headline, Data.Number);
        voteRows = new SharedVoteRowsData(Data.Chamber, [], Data.Votes);
        termCandidates = Data.ShowsSummary && Data.TextOrigin == PublishedTextOrigin.Model && Data.KeyTerms.Length > 0
            ? AiText.WithLocalDefinitions(Data.KeyTerms.Select((term, index) => new AiText.Definition(term.Term,
                string.Create(CultureInfo.InvariantCulture, $"bill-term-{Data.RecordId}-{Data.RevisionNumber}-{index}"), TermDefinition(term))).ToArray())
            : null;
    }

    private string Lede()
    {
        var parts = new List<string>();
        if (Data.Sponsors.FirstOrDefault() is { } sponsor)
            parts.Add(sponsor.Party is { } party ? $"Sponsored by {sponsor.Name}, {Article(party)} {party}." : $"Sponsored by {sponsor.Name}.");
        if (BillIntroducedWords.Lede(Data.Introduced) is { } introduced)
            parts.Add(introduced);
        if (Data.PublicLaw is { } law)
            parts.Add(Data.BecameLawOn is { } on ? $"Became law on {Moment.Day(on)} as Public Law {law}." : $"Became law as Public Law {law}.");
        return string.Join(' ', parts);
    }

    private static RenderFragment CrsParagraphs(string text) => @<text>
        @foreach (var paragraph in text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            <p>@paragraph</p>
        }
    </text>;

    /// <summary>The exact quote of each sentence of one part, in view order, so each quote stands under the text that it supports.</summary>
    private RenderFragment SentenceQuotes(PublishedTextPart part) => @<text>
        @foreach (var sentence in Data.TextSentences.Where(item => item.Part == part))
        {
            <blockquote class="quote">@EncodedEvidence.Markup(sentence.Quote)</blockquote>
        }
    </text>;

    private RenderFragment TermDefinition(BillKeyTermData term) => @<text>
        <span class="quote">"@EncodedEvidence.Markup(term.Quote)"</span>
        <AiLabel Text="@(Data.KeyTermsLabel ?? BillTextWords.KeyTermsLabel)" Origin="PublishedTextOrigin.Model" Look="AiLabelLook.Line" />
        @if (term.Cut)
        {
            <span class="bill-term-cut">@KeyTermCut()</span>
        }
        else
        {
            <a href="@Data.CongressGovUrl" rel="noopener noreferrer">@DefinitionSource</a>
        }
    </text>;

    private RenderFragment KeyTermCut() => @<text>@BillTextWords.KeyTermCutNote <a href="@Data.CongressGovUrl" rel="noopener noreferrer">@BillTextWords.KeyTermCutLink</a></text>;

    private string DefinitionSource => Data.BillText is { } text
        ? BillTextVersionSource(text)
        : CongressGovLinkText;

    private static string BillTextVersionSource(BillTextSourceData text) =>
        BillTextWords.SourceLine(text.VersionName, text.VersionDate is { } date ? Moment.Day(date) : null);

    private static string TextSourceLine(BillTextSourceData text) => string.Join(' ', new[]
    {
        BillTextVersionSource(text),
        BillTextWords.CutNote(text.CharsRead, text.CharsTotal)
    }.OfType<string>());

    private static string Article(string word) => "AEIOUaeiou".Contains(word[0]) ? "an" : "a";
}
