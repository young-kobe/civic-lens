@using CivicLens.Publication.Contracts

@* The ranked list of one board, with its empty states, kept Congress line, delegate list and fold. The boards page shows it in each panel. The full board page shows it whole, folded when it is long.
   Delegates and the resident commissioner rank in their own list below the voting members, in every state of the main list. *@
@if (Board.Congress is not { } congress)
{
    <p>No vote figures are in this release yet.</p>
}
else if (!Board.Ranked)
{
    @Kept(congress)
    <p>No member of the @PublishedPartyNames.PartyOf(Board.Chamber, Board.Party) has @OfficialBoardPage.MinimumSplitVotes split votes cast in the @CongressCalendar.Ordinal(congress) Congress.</p>
    @Delegates
}
else if (Board.Rows.Count == 0)
{
    @Kept(congress)
    <p>No member of the @PublishedPartyNames.PartyOf(Board.Chamber, Board.Party) voted against most @PublishedPartyNames.Members(Board.Party) on a split vote in the @CongressCalendar.Ordinal(congress) Congress.</p>
    @Delegates
}
else
{
    @Kept(congress)
    @if (!NewestInFold && Board.NewestRollCall is { } shown)
    {
        <p class="small muted">@BoardWords.NewestRollCall(congress, shown)</p>
    }
    <p class="board-lede">The @Board.Rows.Count @(Board.Rows.Count == 1 ? "member" : "members") of the @PublishedPartyNames.PartyOf(Board.Chamber, Board.Party) with the highest share of split votes cast against most @PublishedPartyNames.Members(Board.Party). Count first, then the base it comes from.</p>
    @if (FullListHref is null)
    {
        <MemberListFold Count="Board.Rows.Count" Noun="members">@Rows(Board.Rows)</MemberListFold>
    }
    else
    {
        @Rows(Board.Rows)
    }
    @Delegates
    @if (FullListHref is not null)
    {
        <p class="small"><a href="@FullListHref">See the full list of the @PublishedPartyNames.PartyOf(Board.Chamber, Board.Party)</a></p>
    }
    <details class="list-fold">
        <summary>Who counts, and what the numbers mean</summary>
        <div class="in">
            <p><b>Count</b>: split votes where the member voted Yes or No with the other side's majority, against most @PublishedPartyNames.Members(Board.Party). <b>Base</b>: split votes where the member cast Yes or No. Present and not voting are not counted.</p>
            <p>Only members of the @PublishedPartyNames.PartyOf(Board.Chamber, Board.Party) with at least @OfficialBoardPage.MinimumSplitVotes split votes cast are listed. A shorter record could put a member first by chance. A vote against the party is not a mistake. A vote with the party is not a sign of good work.</p>
            @if (NewestInFold && Board.NewestRollCall is { } newest)
            {
                <p class="small muted">@BoardWords.NewestRollCall(congress, newest)</p>
            }
        </div>
    </details>
}

@code {
    [Parameter, EditorRequired] public BoardPanelData Board { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    /// <summary>True when an eyebrow above the page names the Congress, so the newest roll call line moves into the fold. Otherwise the line names the Congress above the list.</summary>
    [Parameter] public bool NewestInFold { get; set; }

    /// <summary>The link of the full board page, or null on that page itself.</summary>
    [Parameter] public string? FullListHref { get; set; }

    private RenderFragment Delegates => Board.Delegates.Count == 0
        ? @<text></text>
        : @<div class="board-delegates">
              <h3>@BoardWords.DelegatesTitle</h3>
              <p class="small muted">@BoardWords.DelegatesNote</p>
              @Rows(Board.Delegates)
          </div>;

    private RenderFragment Rows(IReadOnlyList<BoardRowData> rows) => @<ul class="list-rows" role="list">
        @foreach (var row in rows)
        {
            <BoardRow Row="row" Chamber="Board.Chamber" Party="@Board.Party" RootPath="@RootPath" />
        }
    </ul>;

    private RenderFragment Kept(int congress) => Board.NewerCongress is { } newer
        ? @<p>@BoardWords.KeptCongressInList(newer, congress)</p>
        : @<text></text>;
}
