@using CivicLens.Publication.Contracts

@* The issue tiles of Home and the issues page. When every counted tile shares one Congress, the lede names it once and no tile repeats it. Otherwise each tile names its own. *@
@if (sharedCongress is { } congress)
{
    <p class="home-section-lede">@IssueTileWords.SharedCongress(congress)</p>
}
<ul class="home-issue-list" role="list">
    @foreach (var issue in Issues)
    {
        <li><IssueTile Href="@(RootPath + PublicationProtocol.IssuePagePath(issue.IssueId, 1))" Name="@issue.Name" Congress="issue.Congress"
                       SubstantiveVotes="issue.SubstantiveVotes" Bills="issue.Bills" NamesCongress="sharedCongress is null" /></li>
    }
</ul>

@code {
    private int? sharedCongress;

    [Parameter, EditorRequired] public IReadOnlyList<IssuesIndexItemData> Issues { get; set; } = [];
    [Parameter, EditorRequired] public string RootPath { get; set; } = string.Empty;

    protected override void OnParametersSet() =>
        sharedCongress = Issues.Select(issue => issue.Congress).OfType<int>().Distinct().ToArray() is [var congress] ? congress : null;
}
