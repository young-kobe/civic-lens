@using CivicLens.PublicWeb.Components.Ui
@using CivicLens.Publication.Contracts
@{
    var tabs = Data.Counts.Select(count => FilterTab.Link(OfficialRecordText.TabLabel(count.Kind), OfficialRecordText.Path(RootPath, Data.OfficialId, count.Kind),
        count.Kind == Data.Selected, count.Count)).ToArray();
}

<PublicPage Section="PublicSection.Officials" CanonicalPath="@PublicationProtocol.OfficialRecordPagePath(Data.OfficialId)" Title="@OfficialRecordText.Heading(Data.Name)"
            Description="@OfficialRecordText.Description(Data.Name)" RootPath="@RootPath">
    <PageHeader Title="@OfficialRecordText.Heading(Data.Name)">
        <Meta><a href="@(RootPath + PublicationProtocol.OfficialPagePath(Data.OfficialId))">@OfficialRecordText.BackToOfficial(Data.Name)</a></Meta>
    </PageHeader>
    @if (Data.Counts.Length == 0)
    {
        <EmptyState Title="@OfficialRecordText.EmptyTitle" Text="@OfficialRecordText.EmptyText" />
    }
    else
    {
        <section class="record-section" aria-label="The record of @Data.Name">
            <div data-record-filters><FilterTabs Label="@OfficialRecordText.TabsLabel" Tabs="tabs" /></div>
            <div class="records-lead"><p class="muted small">@OfficialRecordText.CountLine(Data.Selected, Data.SelectedCount, Data.Name)</p></div>
            @switch (Data.Selected)
            {
                case OfficialRecordKind.Votes:
                    <SharedVoteRows Data="VoteRows" RootPath="@RootPath" SingleMember="true" />
                    break;
                case OfficialRecordKind.Bills:
                    @if (Data.Bills.Any(bill => bill.BillLine is not null))
                    {
                        <PublishedBillLineNote />
                    }
                    <ul class="record-rows" role="list">
                        @foreach (var bill in Data.Bills)
                        {
                            <PublicRecordRow Icon="IconName.Bill" IconClass="record-row-icon-bill" Href="@(RootPath + PublicationProtocol.RecordPagePath(bill.RecordId))" Headline="@bill.BillTitle"
                                             Meta="@BillMeta(bill)" BillLine="@bill.BillLine" ShowBillLineSource="false">
                                @if (bill.LatestAction is { } action && BillStatusMeaning.Label(action, bill.BillType) is { } status)
                                {
                                    <StatusBadge Text="@status" />
                                }
                            </PublicRecordRow>
                        }
                    </ul>
                    break;
                case OfficialRecordKind.Statements:
                    <ul class="record-rows" role="list">
                        @foreach (var statement in Data.Statements)
                        {
                            <PublicRecordRow Icon="IconName.Statements" Href="@(RootPath + PublicationProtocol.RecordPagePath(statement.RecordId))" Headline="@statement.Headline"
                                             Label="@statement.Label" Meta="@(statement.StatementDate is { } said ? "Said on " + Moment.Day(said) : "Date not stated")" />
                        }
                    </ul>
                    break;
                case OfficialRecordKind.ExecutiveActions:
                    <ul class="record-rows" role="list">
                        @foreach (var action in Data.ExecutiveActions)
                        {
                            <PublicRecordRow Icon="IconName.ExecutiveAction" Href="@(RootPath + PublicationProtocol.RecordPagePath(action.RecordId))" Headline="@action.Title"
                                             Meta="@($"{PublishedRecordLabels.ExecutiveActionKind(action.Kind)}, signed {Moment.Day(action.SignedOn)}")" />
                        }
                    </ul>
                    break;
            }
            <Pager Label="@OfficialRecordText.PagerLabel" ForwardOnly="true" Summary="@OfficialRecordText.PagerSummary(Shown, Data.SelectedCount)"
                   OlderHref="@NextHref" OlderText="Next page" />
        </section>
    }
    @if (Data.Offices.Length > 0)
    {
        <SourceFold Summary="@OfficialRecordText.OfficesSummary(Data.Offices.Length)" FoldId="@OfficialRecordText.OfficesAnchor">
            <ul role="list">
                @foreach (var office in Data.Offices)
                {
                    <li>@OfficialRecordText.Office(office)</li>
                }
            </ul>
        </SourceFold>
    }
</PublicPage>

@code {
    [Parameter, EditorRequired] public OfficialRecordPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    private SharedVoteRowsData VoteRows => new(Data.Kind == PublishedOfficeKind.Senator ? PublishedChamber.Senate : PublishedChamber.House,
        [new(Data.OfficialId, Data.Name)], Data.Votes);

    private int Shown => Data.Selected switch
    {
        OfficialRecordKind.Votes => Data.Votes.Length,
        OfficialRecordKind.Bills => Data.Bills.Length,
        OfficialRecordKind.Statements => Data.Statements.Length,
        _ => Data.ExecutiveActions.Length
    };

    private string? NextHref => Data.NextCursor is null ? null : OfficialRecordText.Path(RootPath, Data.OfficialId, Data.Selected, Data.NextCursor);

    private static string BillMeta(OfficialBillData bill) => bill.LatestAction is not null && bill.LatestActionOn is { } on
        ? $"Introduced {Moment.Day(bill.IntroducedOn)}. Latest official action {Moment.Day(on)}: {BillStatusMeaning.Plain(bill.LatestAction, bill.BillType)}"
        : $"Introduced {Moment.Day(bill.IntroducedOn)}";
}
