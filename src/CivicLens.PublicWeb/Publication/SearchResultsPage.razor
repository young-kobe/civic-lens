@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Ui

<PublicPage Section="null" CanonicalPath="@PublicationProtocol.SearchPagePath" NoIndex="true" Title="Search records" Description="Search the published records of Civic Lens by words, official, issue, kind, and date." RootPath="@RootPath">
    <PageHeader Title="Search records" />
    <form class="search-box" role="search" method="get">
        <label class="visually-hidden" for="search-text">Search bills, votes, officials and statements</label>
        <input id="search-text" type="search" name="q" maxlength="@MaximumTextLength" value="@Data.Query.Text" autocomplete="off" />
        <Button Type="submit" Variant="ButtonVariant.Primary">Search</Button>
    </form>
    @if (Data.Query.IsEmpty)
    {
        <p class="list-scope muted">Type a topic or a bill number, or choose an official above.</p>
    }
    else if (Data.Hits.Count == 0 && Data.Bill is null && Data.Officials.Count == 0)
    {
        <EmptyState Title="@NoRecords" Text="Next steps:">
            <Action>
                <ul class="search-next">
                    <li>Check the spelling, or type fewer words.</li>
                    <li>Search a bill number, such as <a href="?q=5334">5334</a>, or an official's last name.</li>
                    <li>Browse by <a href="@(RootPath + PublicationProtocol.FacetsPath)">issue</a>, by <a href="@(RootPath + PublicationProtocol.OfficialsPagePath)">official</a>, or <a href="@(RootPath + PublicationProtocol.AllRecordsPagePath(1))">all records</a>.</li>
                    <li>A record you expected is missing? <a href="@(RootPath + PublicationProtocol.ReportPagePath)">Tell us</a>.</li>
                </ul>
            </Action>
        </EmptyState>
    }
    @foreach (var official in Data.Officials)
    {
        <section class="search-official" aria-label="Official">
            <h2><a href="@(RootPath + PublicationProtocol.OfficialPagePath(Uri.EscapeDataString(official.OfficialId)))">@official.Name</a></h2>
            <p class="muted">@OfficialLine(official)</p>
            <p>
                <Button Href="@(RootPath + PublicationProtocol.OfficialPagePath(Uri.EscapeDataString(official.OfficialId)))" Small="true">Open the page of @official.Name</Button>
                <a href="@RecordsOfHref(official)">Records that name @official.Name</a>
            </p>
        </section>
    }
    @if (Data.Bill is { } bill)
    {
        <section class="search-pin" aria-label="Bill number match">
            <p class="search-pin-label">Bill number match</p>
            <h2><a href="@(RootPath + PublicationProtocol.RecordPagePath(bill.RecordId))">@bill.Line</a></h2>
            <p class="muted">Bill in the @CongressCalendar.Ordinal(bill.Congress) Congress.@(bill.PublicLaw is { } law ? $" Became law as Public Law {law}." : string.Empty)</p>
            <p><Button Href="@(RootPath + PublicationProtocol.RecordPagePath(bill.RecordId))" Small="true">Open the bill</Button></p>
            @if (bill.Others > 0)
            {
                <p class="small muted">A number match can find another bill with the same number.</p>
            }
        </section>
    }
    @if (Data.Hits.Count > 0)
    {
        <p class="list-status" role="status">@(Data.Hits.Count) @(Data.Hits.Count == 1 ? "result" : "results")@(Data.Query.Text is null ? string.Empty : $" for \"{Data.Query.Text}\""). Release @Data.Release.</p>
        <h2 class="search-results-title">Records</h2>
        <ul class="list-rows" role="list">
            @foreach (var hit in Data.Hits)
            {
                <li class="list-row search-hit">
                    <div>
                        <a class="list-row-title" href="@(RootPath + PublicationProtocol.RecordPagePath(hit.RecordId))">@hit.Headline</a>
                        <div class="list-row-meta">
                            <span>@PublishedRecordLabels.Kind(hit.Kind)</span>
                            @if (hit.Day is { } day)
                            {
                                <span>@Moment.Day(day)</span>
                            }
                            @foreach (var name in hit.Officials)
                            {
                                <span>@name</span>
                            }
                        </div>
                        @if (hit.Snippet is { } snippet)
                        {
                            <p class="search-snippet">@Marked(snippet)</p>
                        }
                        else if (hit.BillLine is { } line)
                        {
                            <p class="search-snippet">@line</p>
                        }
                    </div>
                </li>
            }
        </ul>
        @if (Data.NextCursor is { } cursor)
        {
            <Pager Label="Search pages" OlderHref="@NextHref(cursor)" OlderText="Show more results" Summary="@($"Results 1 to {Data.Hits.Count} on this page.")" />
        }
    }
    <details class="list-fold" open="@(!Data.Query.IsEmpty && Data.Query.Text is null)">
            <summary>Filter by kind, issue or date</summary>
            <form class="in" method="get">
                <input type="hidden" name="q" value="@Data.Query.Text" />
                @if (Data.Query.Official is { } officialId)
                {
                    <input type="hidden" name="official" value="@officialId" />
                }
                <div class="lists-filter">
                    <Field Label="Kind of record" For="search-kind">
                        <select id="search-kind" name="kind">
                            <option value="">Any</option>
                            @foreach (var kind in Enum.GetValues<PublishedRecordKind>())
                            {
                                var text = PublicationProtocol.KindText(kind);
                                <option value="@text" selected="@(Data.Query.Kind == text)">@PublishedRecordLabels.Kind(kind)</option>
                            }
                        </select>
                    </Field>
                    @if (Data.Issues.Count > 0)
                    {
                        <Field Label="Issue" For="search-issue">
                            <select id="search-issue" name="issue">
                                <option value="">Any</option>
                                @foreach (var issue in Data.Issues)
                                {
                                    <option value="@issue.Value" selected="@(Data.Query.Issue == issue.Value)">@issue.Label</option>
                                }
                            </select>
                        </Field>
                    }
                    <Field Label="From date" For="search-from"><input id="search-from" name="from" type="date" value="@Data.Query.From" /></Field>
                    <Field Label="To date" For="search-to"><input id="search-to" name="to" type="date" value="@Data.Query.To" /></Field>
                </div>
                <Button Type="submit">Apply filters</Button>
            </form>
    </details>
</PublicPage>

@code {
    public const int MaximumTextLength = 200;
    private const char MarkStart = '';
    private const char MarkEnd = '';

    [Parameter, EditorRequired] public SearchPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    private string NoRecords => Data.Query.Text is { } text ? $"No records match \"{text}\"." : "No records match these filters.";

    private static string OfficialLine(SearchOfficialData official)
    {
        var seat = OfficialSeat.Text(official.Kind, null, official.State, official.District);
        return official.Party is { } party ? $"{seat}. {party}." : $"{seat}.";
    }

    private string RecordsOfHref(SearchOfficialData official) => "?" + Query(("q", Data.Query.Text), ("official", official.OfficialId));

    private string NextHref(string cursor) => "?" + Query(("q", Data.Query.Text), ("kind", Data.Query.Kind), ("official", Data.Query.Official),
        ("issue", Data.Query.Issue), ("from", Data.Query.From), ("to", Data.Query.To), ("cursor", cursor));

    private static string Query(params (string Name, string? Value)[] pairs) =>
        string.Join('&', pairs.Where(pair => pair.Value is not null).Select(pair => $"{pair.Name}={Uri.EscapeDataString(pair.Value!)}"));

    /// <summary>Wraps each marked match in mark. Razor encodes every text part, so stored text never becomes markup.</summary>
    private static RenderFragment Marked(string snippet) => builder =>
    {
        foreach (var part in snippet.Split(MarkStart))
        {
            var sections = part.Split(MarkEnd);
            if (sections.Length == 1)
            {
                builder.AddContent(0, sections[0]);
                continue;
            }
            builder.OpenElement(1, "mark");
            builder.AddContent(2, sections[0]);
            builder.CloseElement();
            builder.AddContent(3, sections[1]);
        }
    };
}
