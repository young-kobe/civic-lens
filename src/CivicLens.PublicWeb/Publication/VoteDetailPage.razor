@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Evidence
@using CivicLens.PublicWeb.Components.Ui

<PublicPage Section="PublicSection.Votes" Title="@Data.Headline" Description="@Data.Summary" CanonicalPath="@PublicationProtocol.RecordPagePath(Data.RecordId)" IsArticle="true" RootPath="@RootPath" Record="record">
    <article class="vote">
        <header class="vote-head">
            <p class="vote-meta">
                <span>@Data.Chamber vote, @Moment.Day(Data.VotedOn)</span>
                @if (PublishedRecordLabels.VoteKindTermKey(Data.Kind) is { } kindKey)
                {
                    <Term Key="@kindKey">@VoteFacts.KindName(Data.Kind, Data.KindCitation)</Term>
                }
                else
                {
                    <span>@VoteFacts.KindName(Data.Kind, Data.KindCitation)</span>
                }
            </p>
            <h1 class="vote-headline">@Data.Headline</h1>
            <AiSummary TextOrigin="@Data.TextOrigin" Label="@summaryLabel"><p>@Data.Summary</p></AiSummary>
        </header>
        <PublishedCorrectionBanner Kind="PublishedRecordKind.Vote" Corrections="Data.Corrections" />
        <div class="vote-layout">
            <section class="vote-result" aria-labelledby="vote-result-title">
                <h2 id="vote-result-title">@VotePageView.ResultHeading</h2>
                <p class="vote-result-word">@VotePageView.ResultWords(Data)@if (VoteWords.Badge(Data.Alignment) is { } badge){@(" ")<StatusBadge Text="@badge.Text" />}</p>
                @if (chamberBar is not null)
                {
                    <p class="muted small">@VotePageView.ChamberCaption(Data, chamberBar)</p>
                    <PartyBar Id="chamber" Data="chamberBar" />
                }
            </section>
            <div class="vote-main">
                <section class="vote-explain" aria-labelledby="vote-meaning-title">
                    <h2 id="vote-meaning-title">@VoteMeaning.Heading</h2>
                    @if (wording is { } meaning)
                    {
                        <p>@meaning.Yes</p>
                        <p>@meaning.No</p>
                    }
                    <h3>@NextStep.Heading</h3>
                    @foreach (var line in VotePageView.NextStepLines(Data, wording?.NextStep))
                    {
                        <p>@line</p>
                    }
                </section>
                @if (partyBars.Count == 0)
                {
                    <p class="vote-parties-unknown muted small">@VoteWords.PartyCountsUnknown</p>
                }
                else
                {
                    <section class="vote-parties" aria-labelledby="vote-parties-title">
                        <h2 id="vote-parties-title">@VotePageView.PartiesHeading</h2>
                        <p class="muted small">@VoteWords.PartyCountsNote</p>
                        <div class="vote-party-bars">
                            @for (var index = 0; index < partyBars.Count; index++)
                            {
                                <PartyBar Id="@($"party-{index}")" Data="partyBars[index]" />
                            }
                        </div>
                    </section>
                }
                @if (map is not null)
                {
                    <VoteMap Data="map" RollCall="Data.RollCall" RootPath="@RootPath" />
                }
                @if (Data.Statements.Length > 0)
                {
                    <section class="vote-statements" id="statements" aria-labelledby="vote-statements-title">
                        <h2 id="vote-statements-title">@VotePageView.StatementsHeading</h2>
                        @if (VotePageView.StatementsIntro(Data) is { } intro)
                        {
                            <p>@intro</p>
                        }
                        <div class="vote-note">
                            <p class="vote-note-tag">@VotePageView.StatementsNoteTag</p>
                            <p>@VotePageView.StatementsNote</p>
                        </div>
                        @if (VotePageView.StatementsCount(Data) is { } count)
                        {
                            <p class="muted small">@count</p>
                        }
                        <ul class="official-rows" role="list">
                            @foreach (var statement in Data.Statements)
                            {
                                <li>
                                    <div>
                                        <a class="official-row-title" href="@(RootPath + PublicationProtocol.RecordPagePath(statement.RecordId))">@statement.Headline</a>
                                        <AiLabel Text="@statement.Label" Origin="statement.TextOrigin" />
                                        <p class="official-meta">
                                            @foreach (var speaker in statement.Speakers)
                                            {
                                                <span class="vote-statement-speaker">
                                                    <a href="@(RootPath + PublicationProtocol.OfficialPagePath(speaker.OfficialId))">@speaker.Name</a>
                                                    @if (Data.Members.FirstOrDefault(member => member.OfficialId == speaker.OfficialId) is { } member)
                                                    {
                                                        <span>@VotePageView.CastOnThisVote</span>
                                                        <SharedVoteCast Side="@PublishedOfficialVote.SideOf(member.Cast)"><CastWord Cast="@member.Cast" /></SharedVoteCast>
                                                    }
                                                </span>
                                            }
                                            <span>@StatementPageView.RowDate(statement.StatementDate)</span>
                                        </p>
                                        @if (PublishedRecordLabels.LinkChecker(statement.LinkApprover) is { } checker)
                                        {
                                            <p class="official-related"><span class="link-checker">@checker</span></p>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </section>
                }
                @if (breakers.Count > 0)
                {
                    <section class="vote-breakers" aria-labelledby="vote-breakers-title">
                        <h2 id="vote-breakers-title">@VotePageView.BreakersHeading</h2>
                        <p class="muted small">@VoteWords.BreakMeaning</p>
                        @foreach (var group in breakers)
                        {
                            var board = RootPath + PublicationProtocol.BoardPagePath(Data.Chamber, group.Party);
                            <div class="vote-breaker-group">
                                @if (group.Members.Length == 0)
                                {
                                    <p class="small"><a href="@board">@group.Name</a>: @VoteBreakers.None</p>
                                }
                                else
                                {
                                    <h3><a href="@board">@group.Name</a>: @VoteBreakers.Headline(group.Members.Length)</h3>
                                    <ul class="vote-breaker-list">
                                        @foreach (var member in group.Members)
                                        {
                                            <li><a href="@(RootPath + PublicationProtocol.OfficialPagePath(member.OfficialId))">@member.Name</a> <span class="small">voted <CastWord Cast="@member.Cast" /></span></li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </section>
                }
                <section class="vote-members" id="members" aria-labelledby="vote-members-title">
                    <h2 id="vote-members-title">@VotePageView.MembersHeading</h2>
                    <p class="muted small">@VoteWords.TrackedOnly @Data.Members.Length tracked @(Data.Members.Length == 1 ? "member has" : "members have") a recorded position, including those who did not vote.</p>
                    <details class="vote-fold" open="@(Filter.IsActive ? true : null)">
                        <summary>Find a member</summary>
                        <form class="vote-filter" method="get" action="@(PagePath + "#members")">
                            <div class="vote-filter-field">
                                <label for="vote-filter-name">Member name</label>
                                <input id="vote-filter-name" type="search" name="q" maxlength="@PublishedRecordEntry.MaximumFilterValueLength" value="@Filter.Name" placeholder="Type a name" />
                            </div>
                            <div class="vote-filter-field">
                                <label for="vote-filter-cast">Vote</label>
                                <select id="vote-filter-cast" name="cast">
                                    <option value="">All votes</option>
                                    @foreach (var cast in VotePageView.CastOptions(Data))
                                    {
                                        <option value="@cast" selected="@(cast == Filter.Cast)">@PlainVoteWords.Cast(cast)</option>
                                    }
                                </select>
                            </div>
                            <div class="vote-filter-field">
                                <label for="vote-filter-party">Party</label>
                                <select id="vote-filter-party" name="party">
                                    <option value="">All parties</option>
                                    @if (VotePageView.HasUnknownParty(Data))
                                    {
                                        <option value="@VoteMemberFilter.NoKnownParty" selected="@(Filter.Party == VoteMemberFilter.NoKnownParty)">@VoteWords.NoKnownParty</option>
                                    }
                                    @foreach (var party in VotePageView.PartyOptions(Data))
                                    {
                                        <option value="@party" selected="@(party == Filter.Party)">@party</option>
                                    }
                                </select>
                            </div>
                            <div class="vote-filter-actions">
                                <Button Type="submit" Variant="ButtonVariant.Primary">Apply filters</Button>
                                @if (Filter.IsActive)
                                {
                                    <a href="@(PagePath + "#members")">Clear filters</a>
                                }
                            </div>
                        </form>
                        <p class="small muted" role="status">@rows.Count of @Data.Members.Length tracked members shown.</p>
                        <DataTable TItem="VoteMemberData" Items="rows" Caption="Tracked members and their votes" Scroll="true" PagedRows="members">
                            <Head>
                                <TableCell Header>Member</TableCell>
                                <TableCell Header>Party</TableCell>
                                <TableCell Header>Vote</TableCell>
                                <TableCell Header>Source</TableCell>
                            </Head>
                            <Row Context="member">
                                <VoteMemberCells Member="member" RootPath="@RootPath" MemberIsMain="true" />
                                <TableCell Label="Source"><SourceLineLink Anchor="@anchors.Anchor(member.Citation)" Target="@($"{member.Name}, member line")" /></TableCell>
                            </Row>
                            <Empty><p class="small">No tracked member matches these filters.</p></Empty>
                        </DataTable>
                    </details>
                </section>
            </div>
            <aside class="vote-rail" aria-label="Bill, issues, and sources">
                @if (Data.Bill is { } bill)
                {
                    <section class="vote-bill" aria-labelledby="vote-bill-title">
                        <h2 id="vote-bill-title">@VotePageView.BillHeading</h2>
                        <p><a href="@(RootPath + PublicationProtocol.RecordPagePath(bill.RecordId))">@bill.Title</a></p>
                        @if (bill.StatusLabel is not null)
                        {
                            <p class="vote-bill-status"><StatusBadge Text="@bill.StatusLabel" /></p>
                        }
                        @if (bill.Line is not null)
                        {
                            <p class="small"><PublishedBillLine Line="@bill.Line" /></p>
                            <PublishedBillLineNote />
                        }
                    </section>
                }
                @if (Data.Issues.Length > 0)
                {
                    <section class="vote-issues" aria-labelledby="vote-issues-title">
                        <h2 id="vote-issues-title">@VotePageView.IssuesHeading</h2>
                        <ul class="vote-chips" role="list">
                            @foreach (var issue in Data.Issues)
                            {
                                <li><a class="vote-chip" href="@(RootPath + PublicationProtocol.IssuePagePath(issue.IssueId, 1))">@issue.Name</a></li>
                            }
                        </ul>
                    </section>
                }
                <SourceFold>
                    <Facts Items="facts" />
                    <SourceLinesNote>@VoteFacts.SavedData(Data.Source)</SourceLinesNote>
                    @for (var index = 0; index < Data.Sources.Length; index++)
                    {
                        var source = Data.Sources[index];
                        <VersionSource Version="source" Linked="false" />
                        <DocumentText Label="@($"Source text {index + 1} of {Data.Sources.Length}")" Runs="CitedText.Split(source.Text, anchors.RangesIn(source))" />
                    }
                </SourceFold>
            </aside>
        </div>
    </article>
</PublicPage>

@code {
    private ReportedRecord record = default!;
    private VoteCitationAnchors anchors = default!;
    private (string Yes, string No, string NextStep)? wording;
    private string? summaryLabel;
    private PartyBarData? chamberBar;
    private IReadOnlyList<PartyBarData> partyBars = [];
    private VoteMapData? map;
    private IReadOnlyList<VoteBreakerGroup> breakers = [];
    private IReadOnlyList<VoteMemberData> rows = [];
    private IReadOnlyList<Fact> facts = [];

    [Parameter, EditorRequired] public VotePageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;
    /// <summary>The public address of this vote page. The filter form and the clear link keep the reader on it.</summary>
    private string PagePath => RootPath + PublicationProtocol.RecordPagePath(Data.RecordId);
    [Parameter] public VoteMemberFilter Filter { get; set; } = new();

    protected override void OnParametersSet()
    {
        record = new ReportedRecord(Data.RecordId, Data.RevisionNumber, PublishedRecordKind.Vote, Data.Headline, Data.ShortName);
        anchors = new VoteCitationAnchors(Data);
        wording = VoteWording.Of(Data.WordingSource);
        summaryLabel = VotePageView.Label(Data);
        chamberBar = VotePageView.ChamberBar(Data);
        partyBars = VotePageView.PartyBars(Data);
        map = VoteMapData.Of(Data);
        breakers = VotePageView.Breakers(Data);
        rows = VotePageView.Filtered(Data, Filter);
        facts = VotePageView.Facts(Data, anchors);
    }
}
