@using CivicLens.Publication.Contracts

<figure class="@(Compact ? "portrait portrait-compact" : "portrait")" data-portrait>
    @if (PhotoPath is { } photoPath && PublicationProtocol.IsPhotoPath(photoPath))
    {
        <img src="@(RootPath + photoPath)" width="@PhotoWidth" height="@PhotoHeight" alt="Official portrait of @Name" loading="@(Compact ? "lazy" : "eager")" decoding="async" data-portrait-image />
        @if (ShowCredit && PhotoCredit is not null)
        {
            <figcaption>@PhotoCredit</figcaption>
        }
        <template data-portrait-fallback>@Placeholder</template>
    }
    else
    {
        @Placeholder
    }
</figure>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter] public string? PhotoPath { get; set; }
    [Parameter] public int? PhotoWidth { get; set; }
    [Parameter] public int? PhotoHeight { get; set; }
    [Parameter] public string? PhotoCredit { get; set; }
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool ShowCredit { get; set; } = true;

    private RenderFragment Placeholder => @<text>
        <svg class="portrait-placeholder" viewBox="0 0 225 275" aria-hidden="true" focusable="false">
            <circle cx="112.5" cy="105" r="40" />
            <path d="M32 275C32 205 80 170 112.5 170S193 205 193 275Z" />
        </svg>
        @if (!Compact)
        {
            <figcaption>No portrait is shown for this official.</figcaption>
        }
    </text>;
}
