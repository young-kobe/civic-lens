@using CivicLens.Publication.Contracts

<PublicPage Section="null" CanonicalPath="" Title="Civic Lens" Description="Civic Lens collects what officials say and do, with the sources and the exact text that each record cites." RootPath="@RootPath">
    <Hero>
        <div class="home-hero home-preview-hero">
            <div class="home-intro">
                <h1>See what your members of Congress said and did.</h1>
                <p class="home-lead">See how your representative and senators voted and which bills they introduced. Each fact links to its official source.</p>
                @if (BrowserApiUrl is not null)
                {
                    <ZipLookupForm BrowserApiUrl="@BrowserApiUrl" RootPath="@RootPath" InputId="zip-code" />
                    <p class="home-browse"><a href="@(RootPath + "compare.html")">Compare your members</a></p>
                }
                <p class="home-browse">Or <a href="@(RootPath + PublicationProtocol.OfficialsPagePath)">browse all officials</a></p>
            </div>
            @if (Data.FeaturedVote is { } featured)
            {
                var summaryLabel = featured.Label ?? (featured.TextOrigin is PublishedTextOrigin.Model or PublishedTextOrigin.Code
                    ? PublishedRecordLabels.Wording(featured.TextOrigin).First().Value : null);
                <section class="panel panel-padded home-featured" aria-labelledby="home-featured-title">
                    <p class="home-featured-label">Featured vote</p>
                    <h2 id="home-featured-title" aria-describedby="@(summaryLabel is null ? null : "home-featured-origin")"><a href="@(RootPath + PublicationProtocol.RecordPagePath(featured.RecordId))">@featured.Headline</a></h2>
                    <p class="home-featured-meta muted small"><span class="home-featured-result">@featured.ResultWords</span><span>@featured.Chamber</span><span>@featured.VotedOn.ToString("d MMM yyyy")</span></p>
                    @if (featured.Yea is { } yea && featured.Nay is { } nay)
                    {
                        <p class="record-counts"><span><b>@yea</b> Yes</span><span><b>@nay</b> No</span></p>
                    }
                    @if (featuredMap is not null)
                    {
                        <div class="home-featured-map">
                            <VoteMap Data="featuredMap" RollCall="Data.FeaturedVoteDetail!.RollCall" RootPath="@RootPath" Compact="true" />
                            <a class="home-featured-map-link" href="@(RootPath + PublicationProtocol.VoteMapPagePath(featured.RecordId))">@VoteMapWords.OpenFullMap</a>
                        </div>
                    }
                    @if (featuredParties.Count > 0)
                    {
                        <div class="home-featured-parties">
                            @for (var index = 0; index < featuredParties.Count; index++)
                            {
                                <PartyBar Id="@($"home-party-{index}")" Data="featuredParties[index]" />
                            }
                        </div>
                    }
                    @if (featured.TextOrigin == PublishedTextOrigin.Model)
                    {
                        <AiSummary TextOrigin="@featured.TextOrigin" Label="@summaryLabel" LabelId="home-featured-origin"><p>@featured.Summary</p></AiSummary>
                    }
                    else
                    {
                        <div class="home-featured-summary">
                            @if (summaryLabel is not null)
                            {
                                <span id="home-featured-origin" class="muted small">@summaryLabel</span>
                            }
                            <p>@featured.Summary</p>
                        </div>
                    }
                    @if (featured.BillLine is not null)
                    {
                        <p class="small muted">
                            @featured.BillLine
                            @if (featured.BillLineSource is not null)
                            {
                                <span>@(" " + featured.BillLineSource)</span>
                            }
                        </p>
                    }
                </section>
            }
        </div>
    </Hero>
    <ChildContent>
        <div class="home-grid">
            @if (Data.NewestHouseRollCall is not null || Data.NewestSenateRollCall is not null)
            {
                <p class="home-freshness">
                    @if (Data.NewestHouseRollCall is { } newestHouse)
                    {
                        <span>Newest published House roll call: @newestHouse.ToString("d MMM yyyy")</span>
                    }
                    @if (Data.NewestSenateRollCall is { } newestSenate)
                    {
                        <span>Newest published Senate roll call: @newestSenate.ToString("d MMM yyyy")</span>
                    }
                </p>
            }
            @if (BrowserApiUrl is not null)
            {
                <ZipLookupResults />
            }
            @if (Data.Brief is { } brief)
            {
                <p class="home-brief-line">
                    <span>This week:</span>
                    <a href="@(RootPath + PublicationProtocol.RecordPagePath(brief.RecordId))">@brief.Headline</a>
                    @if (brief.Label is not null)
                    {
                        <span class="muted small">@brief.Label</span>
                    }
                </p>
            }
            @if (Data.Votes.Length > 0)
            {
                <section class="home-preview-section home-votes" aria-labelledby="home-recent-title">
                    <p class="home-eyebrow">Latest votes in Congress</p>
                    <h2 id="home-recent-title">@(Data.Votes.Length == FourVotes ? "Four recent " : "Recent ")<Term Key="substantive-vote">substantive</Term> votes</h2>
                    @if (Data.Votes.Length == FourVotes)
                    {
                        <p class="home-section-lede">Two House votes and two Senate votes, newest in this release. Each bar counts the members of that chamber who voted Yes, No or not at all.</p>
                    }
                    @if (Data.Votes.Length == FourVotes && Data.Votes.All(vote => vote.Alignment == PublishedVoteAlignment.Split))
                    {
                        <p class="muted small home-vote-caption">All four votes shown split the parties. Among members voting Yes or No, most Democrats and most Republicans chose opposite sides.</p>
                    }
                    <ul class="record-rows" role="list">
                        @foreach (var vote in Data.Votes)
                        {
                            <PublicRecordRow Icon="IconName.Vote" Href="@(RootPath + PublicationProtocol.RecordPagePath(vote.RecordId))" Headline="@vote.Headline" Label="@vote.Label"
                                             Meta="@($"{vote.Chamber}, {Moment.Day(vote.VotedOn)}")" Yea="vote.Yea" Nay="vote.Nay" ResultWords="@vote.ResultWords" BillLine="@vote.BillLine" />
                        }
                    </ul>
                </section>
            }
            @if (Data.Issues.Length > 0)
            {
                <section class="home-issues" aria-labelledby="home-issues-title">
                    <h2 id="home-issues-title">Start with an issue</h2>
                    <ul class="home-issue-list" role="list">
                        @foreach (var issue in Data.Issues)
                        {
                            <li>
                                <a class="home-issue-tile" href="@(RootPath + PublicationProtocol.IssuePagePath(issue.IssueId, 1))">
                                    <span class="home-issue-name">@issue.Name</span>
                                    <span class="home-issue-counts">@issue.SubstantiveVotes substantive vote@(issue.SubstantiveVotes == 1 ? "" : "s")</span>
                                    <span class="home-issue-counts">@issue.Bills bill@(issue.Bills == 1 ? "" : "s")</span>
                                    <span class="home-issue-congress muted small">@CongressCalendar.Ordinal(issue.Congress) Congress</span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (breakers.Count > 0)
            {
                <section class="home-breakers" aria-labelledby="home-breakers-title">
                    <h2 id="home-breakers-title">Who broke from their party most</h2>
                    <p class="home-section-lede">Each name below is the member in one chamber and party who voted against most of their own party on <Term Key="split-vote">split vote</Term> most often@(sharedCongress is { } congress ? $" in the {CongressCalendar.Ordinal(congress)} Congress" : ""). A member needs at least @OfficialBoardPage.MinimumSplitVotes split votes cast to count.</p>
                    <ul class="home-breaker-list" role="list">
                        @foreach (var card in breakers)
                        {
                            <li class="home-breaker-card">
                                <a class="home-breaker-name" href="@(RootPath + card.Row.PagePath)">@card.Row.Name</a>
                                <p class="muted small">@PublishedPartyNames.PartyOf(card.Panel.Chamber, card.Panel.Party)@(card.Row.Seat is null ? "" : ", " + card.Row.Seat)</p>
                                <span class="home-breaker-figure">@card.Row.Breaks of @card.Row.Cast</span>
                                <p class="muted small">split votes cast against most @PublishedPartyNames.Members(card.Panel.Party)@(sharedCongress is null ? $", {CongressCalendar.Ordinal(card.Panel.Congress!.Value)} Congress" : "")</p>
                            </li>
                        }
                    </ul>
                    <p class="small home-breakers-more">A vote against the party is not a mistake. <a href="@(RootPath + PublicationProtocol.MethodPagePath)">How we choose these members</a> | <a href="@(RootPath + PublicSections.StaticBoardsPath)">See all four party boards</a></p>
                </section>
            }
            @if (Data.ExecutiveActions.Length > 0)
            {
                <section class="home-executive" aria-labelledby="home-executive-title">
                    <h2 id="home-executive-title">Latest executive actions</h2>
                    <ul class="home-executive-list" role="list">
                        @foreach (var action in Data.ExecutiveActions)
                        {
                            <li>
                                <div class="record-row-icon home-executive-icon"><Icon Name="IconName.ExecutiveAction" /></div>
                                <div>
                                    <p class="muted small">@PublishedRecordLabels.ExecutiveActionKind(action.Kind)</p>
                                    <a href="@(RootPath + PublicationProtocol.RecordPagePath(action.NewestRecordId))">@action.NewestTitle</a>
                                    <p class="muted small">@action.Count record@(action.Count == 1 ? "" : "s") in this release</p>
                                    <p class="muted small">Signed @action.NewestSignedOn.ToString("d MMM yyyy")</p>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }
            <section class="home-method" aria-labelledby="home-method-title">
                <h2 id="home-method-title">How Civic Lens works</h2>
                <ol class="home-method-steps" role="list">
                    <li>
                        <h3>1. We collect official records</h3>
                        <p>Roll call votes, bills, executive notices and public statements, each from its official source.</p>
                    </li>
                    <li>
                        <h3>2. Code checks the facts</h3>
                        <p>Code checks counts, results, dates and quotes against the source. A model never approves a record.</p>
                    </li>
                    <li>
                        <h3>3. AI text is labeled</h3>
                        <p>Where a model drafts plain words, the page says so, and the official source stays one click away. <a href="@(RootPath + PublicationProtocol.MethodPagePath)">How we check records</a></p>
                    </li>
                </ol>
            </section>
        </div>
    </ChildContent>
</PublicPage>

@code {
    private const int FourVotes = 4;
    private VoteMapData? featuredMap;
    private IReadOnlyList<PartyBarData> featuredParties = [];
    private IReadOnlyList<(BoardPanelData Panel, BoardRowData Row)> breakers = [];
    private int? sharedCongress;

    [Parameter, EditorRequired] public HomePageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = string.Empty;
    [Parameter] public string? BrowserApiUrl { get; set; }

    /// <summary>The map and the party bars come from the page data of the featured vote. Each card of the break board is the first member of one board.
    /// The lede names the Congress when every shown board keeps the same one. Otherwise each card names its own.</summary>
    protected override void OnParametersSet()
    {
        featuredMap = Data.FeaturedVoteDetail is { } detail ? VoteMapData.Of(detail) : null;
        featuredParties = Data.FeaturedVoteDetail is { } vote ? VotePageView.PartyBars(vote) : [];
        breakers = [.. Data.Boards.Where(panel => panel.Congress is not null && panel.Rows.Count > 0).Select(panel => (panel, panel.Rows[0]))];
        sharedCongress = breakers.Select(card => card.Panel.Congress).Distinct().ToArray() is [var congress] ? congress : null;
    }
}
