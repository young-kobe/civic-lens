@using CivicLens.Publication.Contracts

@if (Label is null)
{
    <div class="detail-summary">
        @Paragraphs
        <p class="detail-check">@Check</p>
    </div>
}
else
{
    <div class="detail-summary detail-ai">
        <span class="detail-ai-label">@Label</span>
        @Paragraphs
        <p class="detail-check">@Check</p>
    </div>
}

@code {
    /// <summary>The public label of the text. Null shows plain text with no label, because no model wrote it.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>The summary text. A page with no summary shows only its check line.</summary>
    [Parameter] public RenderFragment? Paragraphs { get; set; }
    /// <summary>The check line. It holds the caveats of the page, so no separate caveat shows.</summary>
    [Parameter, EditorRequired] public RenderFragment Check { get; set; } = default!;
}
