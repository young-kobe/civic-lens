@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Ui

<PublicPage Section="PublicSection.Boards" CanonicalPath="@PublicationProtocol.BoardsPagePath" Title="Compare the parties" Description="Which members voted against most of their own party, and how often both parties voted the same way." RootPath="@RootPath">
    <PageHeader Title="Compare the parties" Eyebrow="@Eyebrow" Lede="@($"Which members voted against most of their own party, and how often both parties voted the same way. {BoardWords.CodeBuilt}")" />
    <FilterTabs Label="@BoardWords.TabsLabel" Tabs="Tabs" />
    @foreach (var board in Data.Boards)
    {
        var id = Anchor(board);
        <Panel Id="@($"h-{id}")" Title="@BoardWords.ListTitle(board.Chamber, board.Party)" Padded="true" Class="board-panel">
            <BoardPanelBody Board="board" RootPath="@RootPath" NewestInFold="@(Eyebrow is not null)" FullListHref="@(RootPath + PublicationProtocol.BoardPagePath(board.Chamber, board.Party))" />
        </Panel>
    }
    @foreach (var agreement in Data.Agreements)
    {
        <Panel Title="@($"When both parties agreed ({agreement.Chamber}, {CongressCalendar.Ordinal(agreement.Congress)} Congress)")" Padded="true" Class="board-agreement">
            @if (agreement.Total == 0)
            {
                <p>@BoardWords.AgreementLead(agreement.Chamber, agreement.Congress, agreement.Agreed, agreement.Total)</p>
            }
            else
            {
                <p class="muted">Each line counts substantive @agreement.Chamber roll call votes of one kind. @VoteWords.PartiesAgreedMeaning</p>
                <dl class="board-kinds">
                    @foreach (var kind in agreement.Kinds)
                    {
                        <div class="board-kind"><dt>@PlainVoteWords.Kind(kind.Kind)</dt><dd>@kind.Agreed of @kind.Total</dd></div>
                    }
                    <div class="board-kind"><dt>@BoardWords.AgreementTotalLabel</dt><dd>@agreement.Agreed of @agreement.Total</dd></div>
                </dl>
                <p>@BoardWords.AgreementLead(agreement.Chamber, agreement.Congress, agreement.Agreed, agreement.Total) @BoardWords.AgreementSplit(agreement.Split, agreement.Total)</p>
                @if (agreement.Mixed > 0)
                {
                    <p>@BoardWords.AgreementMixed(agreement.Mixed, agreement.Total)</p>
                }
                @if (BoardWords.ShowsNominationNote(agreement.Nominations, agreement.Total))
                {
                    <p>@BoardWords.NominationNote(agreement.Total)</p>
                }
                <p class="small muted">@BoardWords.AgreementCaution</p>
            }
        </Panel>
    }
    <BoardMethodPanel RootPath="@RootPath" />
</PublicPage>

@code {
    [Parameter, EditorRequired] public BoardsPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    private IReadOnlyList<FilterTab> Tabs => [.. Data.Boards.Select(board =>
        FilterTab.Link(PublishedPartyNames.PartyOf(board.Chamber, board.Party), "#h-" + Anchor(board), false))];

    /// <summary>The Congress of every board with vote figures, when they share one. The House and the Senate can keep different Congresses.
    /// Without this eyebrow, each ranked panel names its Congress in its newest roll call line above the list. With it, that line sits in the fold.</summary>
    private string? Eyebrow { get; set; }

    protected override void OnParametersSet() =>
        Eyebrow = Data.Boards.Select(board => board.Congress).OfType<int>().Distinct().ToArray() is [var congress] ? BoardWords.Eyebrow(congress) : null;

    private static string Anchor(BoardPanelData board) => $"{board.Chamber}-{board.Party}".ToLowerInvariant();
}
