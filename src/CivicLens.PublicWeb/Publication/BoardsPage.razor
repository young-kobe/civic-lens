@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Ui

<PublicPage Section="PublicSection.Boards" CanonicalPath="@PublicSections.BoardsPath" Title="Compare the parties" Description="Which members voted against most of their own party, and how often both parties voted the same way." RootPath="@RootPath">
    <PageHeader Title="Compare the parties" Eyebrow="@Eyebrow" Lede="Which members voted against most of their own party, and how often both parties voted the same way. Code builds every number from roll call votes on this site. No model is used." />
    <FilterTabs Label="Party lists" Tabs="Tabs" />
    @foreach (var board in Data.Boards)
    {
        var id = Anchor(board);
        <Panel Id="@($"h-{id}")" Title="@($"{PublishedPartyNames.PartyOf(board.Chamber, board.Party)}: voted against most of their party")" Padded="true" Class="board-panel">
            @if (board.Congress is not { } congress)
            {
                <p>No vote figures are in this release yet.</p>
            }
            else if (!board.Ranked)
            {
                @Kept(board, congress)
                <p>No member of the @PublishedPartyNames.PartyOf(board.Chamber, board.Party) has @OfficialBoardPage.MinimumSplitVotes split votes cast in the @CongressCalendar.Ordinal(congress) Congress.</p>
            }
            else if (board.Rows.Count == 0)
            {
                @Kept(board, congress)
                <p>No member of the @PublishedPartyNames.PartyOf(board.Chamber, board.Party) voted against most @PublishedPartyNames.Members(board.Party) on a split vote in the @CongressCalendar.Ordinal(congress) Congress.</p>
            }
            else
            {
                @Kept(board, congress)
                @if (Eyebrow is null && board.NewestRollCall is { } shown)
                {
                    <p class="small muted">@BoardWords.NewestRollCall(congress, shown)</p>
                }
                <p class="board-lede">The @board.Rows.Count @(board.Rows.Count == 1 ? "member" : "members") of the @PublishedPartyNames.PartyOf(board.Chamber, board.Party) with the highest share of split votes cast against most @PublishedPartyNames.Members(board.Party). Count first, then the base it comes from.</p>
                <ul class="list-rows" role="list">
                    @foreach (var row in board.Rows)
                    {
                        <li class="list-row">
                            <div>
                                <a class="list-row-title" href="@(RootPath + PublicationProtocol.OfficialPagePath(Uri.EscapeDataString(row.OfficialId)))">@row.Name</a>
                                <div class="list-row-meta">
                                    <span>@PublishedPartyNames.PartyOf(board.Chamber, board.Party)</span>
                                    @if (row.Seat is not null)
                                    {
                                        <span>@row.Seat</span>
                                    }
                                </div>
                            </div>
                            <div class="list-row-side">
                                <span class="list-row-figure"><b>@row.Breaks</b> of @row.Cast split votes</span>
                                <span class="badge">@Share(row.Breaks, row.Cast)</span>
                            </div>
                        </li>
                    }
                </ul>
                <p class="small"><a href="@(RootPath + PublicationProtocol.BoardPagePath(board.Chamber, board.Party))">See the full list of the @PublishedPartyNames.PartyOf(board.Chamber, board.Party)</a></p>
                <details class="list-fold">
                    <summary>Who counts, and what the numbers mean</summary>
                    <div class="in">
                        <p><b>Count</b>: split votes where the member voted Yes or No with the other side's majority, against most @PublishedPartyNames.Members(board.Party). <b>Base</b>: split votes where the member cast Yes or No. Present and not voting are not counted.</p>
                        <p>Only members of the @PublishedPartyNames.PartyOf(board.Chamber, board.Party) with at least @OfficialBoardPage.MinimumSplitVotes split votes cast are listed. A shorter record could put a member first by chance. A vote against the party is not a mistake. A vote with the party is not a sign of good work.</p>
                        @if (Eyebrow is not null && board.NewestRollCall is { } newest)
                        {
                            <p class="small muted">@BoardWords.NewestRollCall(congress, newest)</p>
                        }
                    </div>
                </details>
            }
        </Panel>
    }
    @foreach (var agreement in Data.Agreements)
    {
        <Panel Title="@($"When both parties agreed ({agreement.Chamber}, {CongressCalendar.Ordinal(agreement.Congress)} Congress)")" Padded="true" Class="board-agreement">
            @if (agreement.Total == 0)
            {
                <p>This site has no substantive @agreement.Chamber roll call vote with both parties in the @CongressCalendar.Ordinal(agreement.Congress) Congress.</p>
            }
            else
            {
                <p class="muted">Each line counts substantive @agreement.Chamber roll call votes of one kind. A vote counts as agreed when most Democrats and most Republicans who cast Yes or No voted the same way.</p>
                <dl class="board-kinds">
                    @foreach (var kind in agreement.Kinds)
                    {
                        <div class="board-kind"><dt>@PlainVoteWords.Kind(kind.Kind)</dt><dd>@kind.Agreed of @kind.Total</dd></div>
                    }
                    <div class="board-kind"><dt>All substantive votes</dt><dd>@agreement.Agreed of @agreement.Total</dd></div>
                </dl>
                <p>On @agreement.Agreed of the @agreement.Total substantive @agreement.Chamber roll call votes on this site, most Democrats and most Republicans who cast Yes or No voted the same way. On @agreement.Split of the @agreement.Total, the two parties took opposite sides.</p>
                @if (agreement.Mixed > 0)
                {
                    <p>On @agreement.Mixed of the @agreement.Total, one party had no majority, as in a tie.</p>
                }
                @if (agreement.Nominations * 2 > agreement.Total)
                {
                    <p>Most of these @agreement.Total votes are on nominations. Look at each kind of vote, not only the total.</p>
                }
                <p class="small muted">That the parties voted the same way is about the question of each vote. It does not show that they agree on an issue.</p>
            }
        </Panel>
    }
    <Panel Title="How these lists are made" Padded="true">
        <p class="muted">A split vote is a substantive roll call vote where most Democrats and most Republicans who cast Yes or No voted on opposite sides. An independent who caucuses with a party counts with that party.</p>
        <p><a href="@(RootPath + PublicationProtocol.MethodPagePath)">Read the method note: how Civic Lens counts split votes and agreed votes</a></p>
    </Panel>
</PublicPage>

@code {
    [Parameter, EditorRequired] public BoardsPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    private IReadOnlyList<FilterTab> Tabs => [.. Data.Boards.Select(board =>
        FilterTab.Link(PublishedPartyNames.PartyOf(board.Chamber, board.Party), "#h-" + Anchor(board), false))];

    /// <summary>The Congress of every board with vote figures, when they share one. The House and the Senate can keep different Congresses.
    /// Without this eyebrow, each ranked panel names its Congress in its newest roll call line above the list. With it, that line sits in the fold.</summary>
    private string? Eyebrow { get; set; }

    protected override void OnParametersSet() =>
        Eyebrow = Data.Boards.Select(board => board.Congress).OfType<int>().Distinct().ToArray() is [var congress] ? BoardWords.Eyebrow(congress) : null;

    private static RenderFragment Kept(BoardPanelData board, int congress) => board.NewerCongress is { } newer
        ? @<p>@BoardWords.KeptCongressInList(newer, congress)</p>
        : @<text></text>;

    private static string Anchor(BoardPanelData board) => $"{board.Chamber}-{board.Party}".ToLowerInvariant();

    private static string Share(int breaks, int cast)
    {
        var percent = 100.0 * breaks / cast;
        if (breaks > 0 && percent < 0.5) return "under 1%";
        if (breaks < cast && percent >= 99.5) return "over 99%";
        return string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{percent:0}%");
    }
}
