@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Evidence
@using CivicLens.PublicWeb.Components.Ui

<PublicPage Section="PublicSection.ExecutiveActions" Title="@Data.Headline" Description="@Data.Headline" CanonicalPath="@PublicationProtocol.RecordPagePath(Data.RecordId)" IsArticle="true" RootPath="@RootPath" Record="record">
    <article class="detail">
        <header class="detail-head">
            <p class="detail-eyebrow">@ExecutiveActionWords.Eyebrow(Data)</p>
            <p class="detail-badges">
                <StatusBadge Text="@PublishedRecordLabels.ExecutiveActionKind(Data.Kind)" />
                <StatusBadge Text="@ExecutiveActionWords.DocumentBadge(Data)" />
            </p>
            <h1 class="detail-headline">@Data.Headline</h1>
            <p class="detail-lede">@ExecutiveActionWords.Lede(Data)</p>
            <p class="small muted">@ExecutiveActionWords.Approval(Data)</p>
        </header>
        <PublishedCorrectionBanner Kind="PublishedRecordKind.ExecutiveAction" Corrections="Data.Corrections" />
        <div class="detail-layout">
            <div class="detail-main">
                <section class="official-fixed executive-explain" aria-labelledby="executive-explain-title">
                    <h2 id="executive-explain-title">@ExecutiveActionWords.ExplainerHeading(Data.Kind)</h2>
                    <p>@ExecutiveActionWords.ExplainerArticle(Data.Kind) <Term Key="@PublishedRecordLabels.ExecutiveActionTermKey(Data.Kind)">@ExecutiveActionWords.KindName(Data.Kind)</Term> is @ExecutiveActionWords.ExplainerMeaning(Data.Kind) @ExecutiveActionWords.ExplainerWhy(Data.Kind)</p>
                    <p class="small muted">@ExecutiveActionWords.ReadHint(Data.Kind)</p>
                </section>
                @if (Data.Summary is { } summary)
                {
                    <AiSummary TextOrigin="@summary.TextOrigin" Label="@summary.Label">
                        <ChildContent>
                            @foreach (var sentence in summary.Sentences)
                            {
                                <p>@sentence</p>
                            }
                            @if (summary.Cut)
                            {
                                <p class="small muted">@ExecutiveSummaryWords.CutNote</p>
                            }
                        </ChildContent>
                        <Check>@ExecutiveActionWords.SummaryCheck <a href="#source">@SourceFold.Title</a></Check>
                    </AiSummary>
                }
                else
                {
                    <AiSummary TextOrigin="PublishedTextOrigin.Code">
                        <Check>@ExecutiveActionWords.Caveat <a href="#source">@SourceFold.Title</a></Check>
                    </AiSummary>
                }
                @if (Data.Targets.Length > 0)
                {
                    <section class="detail-section" aria-labelledby="executive-links-title">
                        <h2 id="executive-links-title">@ExecutiveActionWords.LinksHeading</h2>
                        <ul class="detail-list detail-targets">
                            @foreach (var target in Data.Targets)
                            {
                                <li>
                                    <p class="official-row-title">
                                        <span>@ExecutiveActionWords.TargetRelation(target.Relation): </span>
                                        @if (target.TargetRecordId is { } targetRecordId)
                                        {
                                            <a href="@(RootPath + PublicationProtocol.RecordPagePath(targetRecordId))">@PublishedRecordLabels.ExecutiveActionKind(target.Kind) @target.Number</a>
                                        }
                                        else
                                        {
                                            <span>@PublishedRecordLabels.ExecutiveActionKind(target.Kind) @target.Number</span>
                                        }
                                    </p>
                                    @if (target.Reference is not null)
                                    {
                                        <p class="small muted detail-target-reference">@target.Reference</p>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
            <aside class="detail-rail">
                <section class="detail-card detail-facts" aria-labelledby="executive-facts-title">
                    <h2 id="executive-facts-title">@ExecutiveActionWords.KeyFactsHeading</h2>
                    <Facts Items="ExecutiveActionWords.KeyFacts(Data, RootPath)" />
                    <p><Button Href="@Data.DocumentUrl" Variant="ButtonVariant.Primary" rel="noopener noreferrer nofollow">@ExecutiveActionWords.ReadIt</Button></p>
                </section>
            </aside>
        </div>
        <SourceFold>
            <Facts Items="ExecutiveActionWords.SourceFacts(Data)" />
        </SourceFold>
    </article>
</PublicPage>

@code {
    private ReportedRecord record = default!;

    [Parameter, EditorRequired] public ExecutiveActionPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    protected override void OnParametersSet() =>
        record = new ReportedRecord(Data.RecordId, Data.RevisionNumber, PublishedRecordKind.ExecutiveAction, Data.Headline);
}
