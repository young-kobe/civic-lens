@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Ui

<RecordListFrame Kind="PublishedRecordKind.Statement" RootPath="@RootPath" Total="Data.StatementsInRelease" RowCount="Data.Statements.Count" Filter="Data.Filter" Chips="Chips" NextCursor="@Data.NextCursor"
                 Lede="What members of Congress and the President said in their own press releases, newest first. Each statement links to its source."
                 FilterSummary="Filter by official, issue or date" Singular="statement" Plural="statements" EmptyTitle="No statement matches these filters.">
    <Fields>
        <Field Label="Official" For="statements-official"><input id="statements-official" type="search" name="official" placeholder="Type a name" autocomplete="off" value="@Data.Filter.Value("official")" /></Field>
        <RecordListSelect Id="statements-issue" Name="issue" Label="Issue" Choices="Data.Issues" Selected="@Data.Filter.Value("issue")" />
        <RecordListDates IdPrefix="statements" Filter="Data.Filter" />
    </Fields>
    <EmptyTips>
        <li>Check the spelling of the name.</li>
        <li>A date filter leaves out statements with no date. Clear the dates to see them.</li>
        <li><a href="@(RootPath + PublicationProtocol.SearchPagePath)">Search all records</a></li>
    </EmptyTips>
    <Rows>
        @foreach (var statement in Data.Statements)
        {
            <PublicRecordRow Icon="IconName.Statements" Href="@(RootPath + PublicationProtocol.RecordPagePath(statement.RecordId))" Headline="@statement.Headline" Label="@statement.Label"
                             Meta="@Meta(statement)" />
        }
    </Rows>
</RecordListFrame>

@code {
    [Parameter, EditorRequired] public StatementListPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    private IReadOnlyList<string?> Chips =>
        [Data.Filter.Value("official") is { } name ? $"Official: {name}" : null, RecordListSelect.LabelOf(Data.Issues, Data.Filter.Value("issue"))];

    private static string Meta(StatementListRowData statement) => string.Join(", ", statement.Speakers
        .Append(statement.StatementDate is { } day ? $"Said on {Moment.Day(day)}" : "Date not stated"));
}
