<nav class="public-breadcrumbs" aria-label="Breadcrumb">
    <ol role="list">
        @foreach (var parent in Trail.Parents)
        {
            <li>
                <a href="@(RootPath + parent.PagePath)">@parent.Text</a>
                <span class="public-breadcrumb-separator" aria-hidden="true">/</span>
            </li>
        }
        <li><span aria-current="page">@Trail.Current</span></li>
    </ol>
</nav>

@code {
    [Parameter, EditorRequired] public PublicTrail Trail { get; set; } = default!;
    [Parameter] public string RootPath { get; set; } = string.Empty;
}
