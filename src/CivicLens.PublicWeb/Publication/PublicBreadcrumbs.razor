<nav class="public-breadcrumbs" aria-label="Breadcrumb">
    <ol role="list">
        @for (var index = 0; index < Items.Count; index++)
        {
            var item = Items[index];
            <li>
                @if (index > 0)
                {
                    <span class="public-breadcrumb-separator" aria-hidden="true">/</span>
                }
                @if (index == Items.Count - 1)
                {
                    <span aria-current="page">@item.Text</span>
                }
                else if (item.PagePath is not null)
                {
                    <a href="@(RootPath + item.PagePath)">@item.Text</a>
                }
                else
                {
                    <span>@item.Text</span>
                }
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PublicBreadcrumbItem> Items { get; set; } = [];
    [Parameter] public string RootPath { get; set; } = string.Empty;
}
