@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Ui

<RecordListFrame Kind="PublishedRecordKind.ExecutiveAction" RootPath="@RootPath" Total="Data.ActionsInRelease" RowCount="Data.Actions.Count" Filter="Data.Filter" Chips="Chips" NextCursor="@Data.NextCursor"
                 Lede="Documents that the President signed and the Federal Register printed, newest first. Civic Lens copies each title and date from the Federal Register."
                 FilterSummary="Filter by type of document or date" Singular="executive action" Plural="executive actions" EmptyTitle="No executive action matches these filters.">
    <Fields>
        <RecordListSelect Id="executive-type" Name="type" Label="Type of document" Choices="Data.Kinds" Selected="@Data.Filter.Value("type")" />
        <RecordListDates IdPrefix="executive" Filter="Data.Filter" />
    </Fields>
    <EmptyTips>
        <li>Clear one filter, such as the type of document.</li>
        <li>Use a wider date range.</li>
        <li><a href="@(RootPath + PublicationProtocol.SearchPagePath)">Search all records</a></li>
    </EmptyTips>
    <Rows>
        @foreach (var action in Data.Actions)
        {
            <PublicRecordRow Icon="IconName.ExecutiveAction" Href="@(RootPath + PublicationProtocol.RecordPagePath(action.RecordId))" Headline="@action.Headline"
                             Meta="@($"{PublishedRecordLabels.ExecutiveActionKind(action.Kind)}, Signed {Moment.Day(action.SignedOn)}")" />
        }
    </Rows>
</RecordListFrame>

@code {
    [Parameter, EditorRequired] public ExecutiveActionListPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    private IReadOnlyList<string?> Chips => [Data.Type is { } type ? PublishedRecordLabels.ExecutiveActionKindPlural(type) : null];
}
