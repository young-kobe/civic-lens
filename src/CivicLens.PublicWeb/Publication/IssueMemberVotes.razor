<div data-zip-member-fragment data-zcta="@Data.Zcta" data-release="@Data.Release" data-congress="@Data.Congress" data-issue="@Data.SelectedIssue" data-view="issue" data-since-release="" data-new-votes="">
    @foreach (var votes in Data.SharedVotes)
    {
        <SharedVoteRows Data="votes" RootPath="@RootPath" HeadingLevel="3" />
    }
    @if (Data.SharedVotes.Length == 0)
    {
        <p data-member-votes-empty>None of your members has a recorded vote on this issue in this release.</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public ZipMemberCardsData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;
}
