@using CivicLens.PublicWeb.Components.Ui
@using CivicLens.Publication.Contracts
@{
    var party = OfficialPageText.MainPartyLine(Data);
    var showVotes = Data.Votes.Length > 0 || Data.Marks.Length > 0;
    var showStatements = Data.Statements.Length > 0;
    var showBills = Data.Bills.Length > 0;
    var showIssues = Data.Issues.Length > 0 && Data.IssuesCongress is not null;
    var showJump = showVotes || showStatements || showBills || showIssues;
    var showNoLinks = showJump && !Data.HasLinkedStatements;
    var marksCongress = Data.Attendance.FirstOrDefault()?.Congress ?? party?.Congress;
    var voteRows = new SharedVoteRowsData(Data.Kind == PublishedOfficeKind.Senator ? PublishedChamber.Senate : PublishedChamber.House,
        [new(Data.OfficialId, Data.Name)], Data.Votes);
    string RecordPath(OfficialRecordKind kind) => OfficialRecordText.Path(RootPath, Data.OfficialId, kind);
}

<PublicPage Section="PublicSection.Officials" CanonicalPath="@PublicationProtocol.OfficialPagePath(Data.OfficialId)" Title="@Data.Name" Description="@OfficialPageText.Lede(Data)" RootPath="@RootPath">
    <div class="official-page">
        <div class="official-layout">
            <header class="official-head">
                <div class="official-portrait"><OfficialPortrait Name="@Data.Name" PhotoPath="@Data.PhotoPath" RootPath="@RootPath" ShowCredit="false" /></div>
                <div>
                    <h1>@Data.Name</h1>
                    <p class="official-lede">@OfficialPageText.Lede(Data)</p>
                    @if (Data.Website is { } website)
                    {
                        <p class="small muted">Official site: <a href="@website" rel="noopener noreferrer">@PublishedWebsite.Host(website)</a>.</p>
                    }
                </div>
            </header>
            @if (Data.Attendance.Length > 0 || party is not null || Data.BillsCongress is not null || Data.BillCountsAbsent)
            {
                <aside class="official-rail" aria-label="Figures for @Data.Name">
                    <ul class="official-figs" role="list">
                        @foreach (var figure in Data.Attendance)
                        {
                            <li><b>@PublishedWording.Count(figure.Held - figure.Missed)</b><span>@OfficialPageText.VotedOn(figure)</span></li>
                        }
                        @if (party is not null)
                        {
                            <li><b>@PublishedWording.Count(party.WithParty)</b><span>of @PublishedWording.Count(party.Cast) <Term Key="split-vote">split votes</Term> @OfficialPageText.PartyLineScope(party)</span></li>
                        }
                        @if (Data.BillsCongress is not null)
                        {
                            <li><b>@Data.SponsoredBills</b><span>@OfficialPageText.BillsSponsored(Data)</span></li>
                        }
                        else if (Data.BillCountsAbsent)
                        {
                            <li><span>@OfficialPageText.BillCountsUnavailable</span></li>
                        }
                    </ul>
                </aside>
            }
            <div class="official-main">
                @if (showJump || showNoLinks)
                {
                    <nav class="official-jump" aria-label="On this page">
                        @if (showJump)
                        {
                            <ul role="list">
                                @if (showVotes) {<li><a href="#votes">Votes</a></li>}
                                @if (showStatements) {<li><a href="#statements">Statements</a></li>}
                                @if (showBills) {<li><a href="#bills">Bills</a></li>}
                                @if (showIssues) {<li><a href="#issues">Issues</a></li>}
                            </ul>
                        }
                        @if (showNoLinks)
                        {
                            <p class="muted small">@OfficialPageText.NoLinks</p>
                        }
                    </nav>
                }

                @if (showVotes)
                {
                    <section id="votes" class="official-section official-votes" aria-labelledby="votes-title">
                        <h2 id="votes-title">How @Data.Name voted</h2>
                        @if (Data.Marks.Length > 0)
                        {
                            @if (marksCongress is { } congress)
                            {
                                <p class="official-lede">@OfficialPageText.StripLede(Data.Name, Data.Marks.Length, congress)</p>
                            }
                            <ul class="official-strip" role="list" aria-label="@($"Latest roll calls of {Data.Name}")">
                                @foreach (var mark in Data.Marks)
                                {
                                    var label = OfficialPageText.MarkLabel(mark);
                                    <li><a href="@(RootPath + PublicationProtocol.RecordPagePath(mark.RecordId))" data-mark="@VoteMapMarks.Name(mark.Mark)" data-breaks="@(mark.BreaksParty ? "party" : null)" title="@label"><span class="visually-hidden">@label</span></a></li>
                                }
                            </ul>
                            <ul class="official-legend" role="list" aria-label="What the squares mean">
                                @foreach (var shown in Data.Marks.Select(mark => mark.Mark).Distinct().Order())
                                {
                                    <li><span class="swatch" data-mark="@VoteMapMarks.Name(shown)" aria-hidden="true"></span>@VoteMapMarks.Label(shown)</li>
                                }
                                @foreach (var against in Data.Marks.Where(mark => mark.BreaksParty).Select(OfficialPageText.AgainstParty).Distinct())
                                {
                                    <li><span class="swatch" data-breaks="party" aria-hidden="true"></span>@against</li>
                                }
                            </ul>
                        }
                        @if (Data.Votes.Length > 0)
                        {
                            <SharedVoteRows Data="voteRows" RootPath="@RootPath" SingleMember="true" />
                            <p class="official-more"><a href="@RecordPath(OfficialRecordKind.Votes)">See all votes and records of @Data.Name</a></p>
                        }
                    </section>
                }

                @if (showStatements)
                {
                    <GlossaryContent Context="use">
                        <section id="statements" class="official-section official-statements" aria-labelledby="statements-title">
                            <h2 id="statements-title">@OfficialPageText.StatementsHeading</h2>
                            <ul class="official-rows" role="list">
                                @foreach (var statement in Data.Statements)
                                {
                                    var voteLabel = statement.VoteLabel ?? (statement.VoteTextOrigin == PublishedTextOrigin.Model ? AiLabelWords.ModelWording : null);
                                    <li>
                                        <span class="official-icon" aria-hidden="true"><Icon Name="IconName.Statements" /></span>
                                        <div>
                                            <a class="official-row-title" href="@(RootPath + PublicationProtocol.RecordPagePath(statement.RecordId))">@statement.Headline</a>
                                            @if (statement.TextOrigin == PublishedTextOrigin.Model)
                                            {
                                                @AiText.RenderControls(use, statement.Headline)
                                            }
                                            <AiLabel Text="@statement.Label" Origin="statement.TextOrigin" Look="AiLabelLook.Chip" />
                                            <p class="official-meta"><span>@StatementPageView.RowDate(statement.StatementDate)</span></p>
                                            <p class="official-related"><span>Related vote</span> <a href="@(RootPath + PublicationProtocol.RecordPagePath(statement.VoteRecordId))">@VoteWords.RollCall(statement.VoteChamber, statement.VoteRollCall), @Moment.Day(statement.VotedOn): @statement.VoteHeadline</a>@(" ")
                                                @if (statement.VoteTextOrigin == PublishedTextOrigin.Model)
                                                {
                                                    @AiText.RenderControls(use, statement.VoteHeadline)
                                                }
                                                <AiLabel Text="@voteLabel" Origin="statement.VoteTextOrigin" Look="AiLabelLook.Chip" />
                                                @if (statement.Cast is { } cast)
                                                {
                                                    @SharedVoteCast.Render(PublishedOfficialVote.SideOf(cast), CastWord.Render(use, cast))
                                                }
                                                @if (PublishedRecordLabels.LinkChecker(statement.LinkApprover) is { } checker)
                                                {
                                                    <span class="link-checker">@checker</span>
                                                }
                                            </p>
                                        </div>
                                    </li>
                                }
                            </ul>
                            <p class="muted small">@OfficialPageText.LinkMeaning <a href="@(RootPath + PublicationProtocol.MethodPagePath)">What a link is</a></p>
                            <p class="official-more"><a href="@RecordPath(OfficialRecordKind.Statements)">See all statements by @Data.Name</a></p>
                        </section>
                    </GlossaryContent>
                }

                @if (showBills)
                {
                    <section id="bills" class="official-section official-bills" aria-labelledby="bills-title">
                        <h2 id="bills-title">Bills @Data.Name introduced</h2>
                        @if (Data.Bills.Any(bill => bill.BillLine is not null))
                        {
                            <PublishedBillLineNote />
                        }
                        <ul class="official-rows" role="list">
                            @foreach (var bill in Data.Bills)
                            {
                                var status = bill.LatestAction is { } action ? BillStatusMeaning.Label(action, bill.BillType) : null;
                                <li>
                                    <span class="official-icon" aria-hidden="true"><Icon Name="IconName.Bill" /></span>
                                    <div>
                                        <a class="official-row-title" href="@(RootPath + PublicationProtocol.RecordPagePath(bill.RecordId))">@bill.BillTitle</a>
                                        <PublishedBillLine Line="@bill.BillLine" />
                                        @if (OfficialPageText.BillMeta(bill) is { Length: > 0 } meta)
                                        {
                                            <p class="official-meta">@foreach (var part in meta)
                                                {
                                                    <span>@part</span>
                                                }
                                            </p>
                                        }
                                    </div>
                                    @if (status is not null)
                                    {
                                        <StatusBadge Text="@status" />
                                    }
                                </li>
                            }
                        </ul>
                        @if (Data.RecordBills > Data.Bills.Length)
                        {
                            <p class="official-more"><a href="@RecordPath(OfficialRecordKind.Bills)">See all @Data.RecordBills bills</a></p>
                        }
                    </section>
                }

                @if (showIssues)
                {
                    <section id="issues" class="official-section" aria-labelledby="issues-title">
                        <h2 id="issues-title">Issues in @(Data.Name)'s record</h2>
                        <p class="official-lede">Each number counts the votes and bills in the @CongressCalendar.Ordinal(Data.IssuesCongress!.Value) Congress that carry the issue tag. An AI model picks the tag, so a tag can be wrong. <a href="@(RootPath + PublicationProtocol.MethodPagePath)">How tags are chosen</a></p>
                        <ul class="official-chips" role="list">
                            @foreach (var issue in Data.Issues)
                            {
                                <li><a href="@(RootPath + PublicationProtocol.IssuePagePath(issue.IssueId, 1))">@issue.Name <b>@issue.Records</b></a></li>
                            }
                        </ul>
                    </section>
                }

                @if (BrowserApiUrl is not null)
                {
                    <section id="your-members" class="official-section" aria-labelledby="official-members-title" hidden data-official-members-section>
                        <h2 id="official-members-title">Compare with your other members</h2>
                        <div class="official-members" data-official-members="@Data.OfficialId" data-release="@Data.Release" data-members-api="@BrowserApiUrl" data-officials-page="@(RootPath + PublicationProtocol.OfficialsPagePath)" aria-live="polite"></div>
                    </section>
                }

                @if (!showVotes && !showStatements && !showBills && !showIssues)
                {
                    <EmptyState Title="@OfficialPageText.NothingToShow" />
                }
            </div>
        </div>
    </div>
</PublicPage>

@code {
    [Parameter, EditorRequired] public OfficialPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;
    /// <summary>The browser origin of the private members API. Without it the page has no section that reads the remembered ZIP.</summary>
    [Parameter] public string? BrowserApiUrl { get; set; }
}
