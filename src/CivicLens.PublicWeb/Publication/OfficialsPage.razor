@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Components.Ui

<PublicPage Section="PublicSection.Officials" CanonicalPath="@PublicationProtocol.OfficialsPagePath" Title="Officials" Description="Every official with a published record or vote. Each page lists the records and votes that name one official." RootPath="@RootPath">
    <PageHeader Title="Officials" Lede="@Lede">
        <Meta><a href="@(RootPath + PublicationProtocol.BoardsPagePath)">Compare the parties</a></Meta>
    </PageHeader>
    @if (Data.Officials.Count == 0 && Data.Filter.Invalid is null)
    {
        <EmptyState Level="2" Title="No official matches these filters." Text="Clear one filter, such as the party. Check the spelling of the name.">
            <Action><a href="@(RootPath + PublicationProtocol.SearchPagePath)">Search all records</a></Action>
        </EmptyState>
    }
    <form class="lists-filter" method="get" aria-label="Filter officials">
        <RecordListSelect Id="officials-chamber" Name="chamber" Label="Chamber" Choices="Chambers" Filter="Data.Filter" AnyText="All" />
        <RecordListSelect Id="officials-state" Name="state" Label="State or territory" Choices="States" Filter="Data.Filter" AnyText="All" />
        <RecordListSelect Id="officials-party" Name="party" Label="Party" Choices="Parties" Filter="Data.Filter" AnyText="All" />
        <Field Label="Name" For="officials-name">
            <input id="officials-name" type="search" name="name" maxlength="@MaximumNameLength" value="@Data.Filter.Value(NameFilter)" placeholder="Type a name" autocomplete="off" @attributes="Data.Filter.InputAttributes(NameFilter, NameInputId)" />
        </Field>
        <div class="lists-filter-actions">
            <Button Type="submit" Variant="ButtonVariant.Primary">Apply filters</Button>
            @if (Data.Filter.IsActive)
            {
                <a href="?">Clear filters</a>
            }
        </div>
    </form>
    @if (Data.Officials.Count > 0)
    {
        <ListStatus Count="Data.Officials.Count" Singular="official" Plural="officials" Chips="Chips" />
        <ul class="list-rows" role="list">
            @foreach (var official in Data.Officials)
            {
                <li class="list-row">
                    <div>
                        <a class="list-row-title" href="@(RootPath + PublicationProtocol.OfficialPagePath(Uri.EscapeDataString(official.OfficialId)))">@official.Name</a>
                        <div class="list-row-meta">
                            <span>@OfficialSeat.Text(official.Kind, official.Office, official.State, official.District)</span>
                            @if (official.Party is { } party)
                            {
                                <span>@party</span>
                            }
                            <span>@TermEnd(official)</span>
                        </div>
                    </div>
                    <div class="list-row-side"><span class="muted small">@RecordCount(official.RecordCount)</span></div>
                </li>
            }
        </ul>
        <Pager Label="Officials pages" LinksOnly="true" NewerText="@ListPageLink.PreviousText" OlderText="@ListPageLink.NextText"
               NewerHref="@(Data.PreviousCursor is { } previous ? Href(ListPageLink.Previous(previous)) : null)"
               OlderHref="@(Data.NextCursor is { } next ? Href(ListPageLink.Next(next)) : null)" />
    }
</PublicPage>

@code {
    public const int MaximumNameLength = 100;
    private const string NameFilter = "name";
    private const string NameInputId = "officials-name";

    private static readonly SearchChoiceData[] Chambers =
        [new("senate", "Senate"), new("house", "House"), new("executive", "Executive")];
    private static readonly SearchChoiceData[] States = [.. UsStates.NameByCode.Keys.Order(StringComparer.Ordinal).Select(state => new SearchChoiceData(state, state))];
    private static readonly SearchChoiceData[] Parties =
        [new("democrat", "Democrat"), new("republican", "Republican"), new("independent", "Independent")];

    [Parameter, EditorRequired] public OfficialsPageData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string RootPath { get; set; } = default!;

    /// <summary>The chips of the active filters in form order: the chamber and party as their choices name them, the state code, and the typed name.</summary>
    private IReadOnlyList<string> Chips => [.. new string?[]
    {
        RecordListSelect.LabelOf(Chambers, Data.Filter.Value("chamber")), Data.Filter.Value("state"),
        RecordListSelect.LabelOf(Parties, Data.Filter.Value("party")),
        Data.Filter.Value("name") is { } name ? $"Name: {name}" : null
    }.OfType<string>()];

    private string Href(ListPageLink page) => Data.Filter.Query(page);

    private string Lede => $"{PublishedWording.Count(Data.OfficialsInRelease)} {(Data.OfficialsInRelease == 1 ? "official has" : "officials have")} a page. Each page lists the published records that name the official. A member of Congress also has their votes in the current Congress. Looking for the parties?";

    /// <summary>The record count of a row. It names what it counts, whom, and what it leaves out.</summary>
    private static string RecordCount(int count) =>
        $"{PublishedWording.Count(count)} published {(count == 1 ? "record names" : "records name")} this official, not counting votes";

    private static string TermEnd(OfficialListRowData official) => official.TermEndsOn is { } end
        ? $"Term ends {Moment.Day(end)}"
        : "Our records show no end date for this term.";
}
