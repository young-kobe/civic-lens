@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.AllRecords" CanonicalPath="@PublicationProtocol.RecordPagePath(Withdrawal.RecordId)" Title="@Title" Description="@PublishedWithdrawalView.Banner(Withdrawal)" RootPath="@RootPath" NoIndex="true">
    <RecordView HeadingLevel="1" Headline="This record was withdrawn"
                Summary="@PublishedWithdrawalView.Banner(Withdrawal)"
                Facts="PublishedWithdrawalView.Facts(Withdrawal)" />
    <PublishedCorrectionList Corrections="Withdrawal.Corrections" />
</PublicPage>

@code {

    private string Title => $"Withdrawn {PublishedRecordLabels.Kind(Withdrawal.Kind).ToLowerInvariant()}: {Withdrawal.RecordId[..12]}";

    [Parameter, EditorRequired] public PublishedWithdrawal Withdrawal { get; set; } = default!;
    /// <summary>The path to the site root. The static page sits one folder down, and a server page gets the configured root.</summary>
    [Parameter] public string RootPath { get; set; } = "../";
}
