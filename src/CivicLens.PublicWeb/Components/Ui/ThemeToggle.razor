<div class="segmented theme-toggle" role="group" aria-label="Theme" hidden>
    <button class="segmented-item" type="button" data-theme-choice="light" aria-pressed="false" title="Light"><Icon Name="IconName.Light" /><span class="visually-hidden">Light</span></button>
    <button class="segmented-item" type="button" data-theme-choice="" aria-pressed="true" title="Match system"><Icon Name="IconName.System" /><span class="visually-hidden">Match system</span></button>
    <button class="segmented-item" type="button" data-theme-choice="dark" aria-pressed="false" title="Dark"><Icon Name="IconName.Dark" /><span class="visually-hidden">Dark</span></button>
</div>
