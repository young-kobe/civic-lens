<div class="empty">
    @if (HeadingLevel == 2)
    {
        <h2>@Title</h2>
    }
    else
    {
        <h3>@Title</h3>
    }
    @if (Text is not null)
    {
        <p>@Text</p>
    }
    @ChildContent
    @Action
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }

    /// <summary>The heading level of the title: 3 under a panel title, 2 when no panel title is above it, so the outline skips no level.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;
}
