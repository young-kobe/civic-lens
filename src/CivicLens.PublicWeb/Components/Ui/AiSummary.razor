<div class="@(TextOrigin == PublishedTextOrigin.Model && Label is not null ? "ai-summary ai-summary-ai" : "ai-summary")">
    <AiLabel Text="@Label" Origin="TextOrigin" Look="LabelLook" Id="@LabelId" />
    @if (Text is { } text)
    {
        <p>@CivicLens.PublicWeb.Publication.AiText.Render(Use, text, TextOrigin)</p>
    }
    @ChildContent
    @if (Check is not null)
    {
        <p class="ai-summary-check">@Check</p>
    }
</div>

@code {
    [CascadingParameter] private CivicLens.PublicWeb.Publication.GlossaryPageUse Use { get; set; } = default!;

    /// <summary>A single summary paragraph rendered at this component's depth so it precedes later manual glossary terms.</summary>
    [Parameter] public string? Text { get; set; }

    [Parameter, EditorRequired] public PublishedTextOrigin TextOrigin { get; set; }

    /// <summary>The public label of the text, as the public view sets it. Null shows plain text with no label.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>The look of the label. A record page keeps the full label as a tag. A card passes <see cref="AiLabelLook.Chip"/>.</summary>
    [Parameter] public AiLabelLook LabelLook { get; set; } = AiLabelLook.Tag;
    /// <summary>The ID of the label, for a heading that names it with aria-describedby.</summary>
    [Parameter] public string? LabelId { get; set; }
    /// <summary>The text of the summary. A page with no summary shows only its check line.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The check line under the text. It holds the caveats of the page.</summary>
    [Parameter] public RenderFragment? Check { get; set; }
}
