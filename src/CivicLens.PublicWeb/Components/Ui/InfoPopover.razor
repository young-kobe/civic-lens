@if (Label is null)
{
    <button type="button" class="@TriggerClass" popovertarget="@Id">@Trigger</button>
}
else
{
    <button type="button" class="info-button" popovertarget="@Id" aria-label="@Label"><Icon Name="IconName.Info" /></button>
}<span class="term-popover" id="@Id" popover>@ChildContent</span>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    /// <summary>The accessible name of an icon-only trigger. Leave it unset when <see cref="Trigger"/> shows text.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public string? TriggerClass { get; set; }
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
