@if (HasNewer || HasOlder)
{
    <nav class="pager" aria-label="@Label">
        <span>@Summary</span>
        <div class="pager-links">
            <Button Small="true" Href="@NewerHref" OnClick="OnNewer" Disabled="@(!HasNewer)" rel="@(NewerHref is null ? null : "prev")">@NewerText</Button>
            <Button Small="true" Href="@OlderHref" OnClick="OnOlder" Disabled="@(!HasOlder)" rel="@(OlderHref is null ? null : "next")">@OlderText</Button>
        </div>
    </nav>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Summary { get; set; }
    [Parameter] public string? NewerHref { get; set; }
    [Parameter] public string? OlderHref { get; set; }
    [Parameter] public EventCallback OnNewer { get; set; }
    [Parameter] public EventCallback OnOlder { get; set; }
    [Parameter] public string NewerText { get; set; } = "Newer";
    [Parameter] public string OlderText { get; set; } = "Older";

    private bool HasNewer => NewerHref is not null || OnNewer.HasDelegate;
    private bool HasOlder => OlderHref is not null || OnOlder.HasDelegate;
}
