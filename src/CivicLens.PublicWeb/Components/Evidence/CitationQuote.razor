<div class="choice choice-static" data-link="@Link" id="@Id">
    <div>
        <span class="choice-label">@Label</span>
        <blockquote class="quote">@EncodedEvidence.Markup(Quote)</blockquote>
        @if (ChildContent is not null)
        {
            <div class="row small">@ChildContent</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Quote { get; set; } = string.Empty;
    [Parameter] public string? Link { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
