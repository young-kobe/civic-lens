@using Microsoft.Extensions.Logging
@using CivicLens.Application.Reports
@using CivicLens.Core.Review
@using CivicLens.Host.Review
@using CivicLens.Publication.Contracts

<ReaderReportDismissForm Actor="Actor" />
@if (failed)
{
    <Notice Tone="Tone.Warn">Reader reports could not load for this record. Refresh the page to try again.</Notice>
}
@foreach (var report in reports.Reports)
{
    <section class="stack" id="@($"reader-report-{report.ReportId:D}")">
        @if (report.Status == ReaderReportStatus.Open)
        {
            <Notice Tone="Tone.Warn" Title="A reader reported a problem.">
                @ReportLabels.Category(report.Category)@(string.IsNullOrWhiteSpace(report.Text) ? "." : ": " + report.Text)<br />
                A reader wrote this text. It may be wrong. Check it against the record.
                @(CanEdit
                    ? "To fix it, change the wording and press Save and approve. If the report is wrong, dismiss it."
                    : "No person edits this record. To close the report, approve a newer revision. If the report is wrong, dismiss it. The owner can take the record off the site.")
                @if (CurrentRevisionApproved && reports.CurrentRevisionNumber > report.RevisionNumber)
                {
                    <br />@("The current revision is already approved. Dismiss this report if it fixes the problem.")
                }
            </Notice>
            <input type="hidden" form="@ApprovalFormId" name="@ReviewRecordPage.CorrectedReportsField" value="@report.ReportId" />
            <ReaderReportDismissButton Report="report" />
        }
        else
        {
            <Notice Tone="Tone.Neutral" Title="A correction was approved.">
                @ReportLabels.Category(report.Category)@(string.IsNullOrWhiteSpace(report.Text) ? "." : ": " + report.Text)<br />
                A person approved a correction for this report. This notice goes away when the corrected record is published.
            </Notice>
        }
    </section>
}
@if (reports.MoreOpen > 0)
{
    <Notice Tone="Tone.Neutral" id="reader-reports-more">@(reports.MoreOpen == 1 ? "1 more report stays open." : $"{reports.MoreOpen} more reports stay open.")</Notice>
}

@code {
    private RecordReports reports = new([], 0, null);
    private bool failed;

    [Inject] private ListRecordReports ListReports { get; set; } = default!;
    [Inject] private ILogger<ReaderReportPanel> Logger { get; set; } = default!;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [Parameter, EditorRequired] public ReviewActor Actor { get; set; } = default!;
    [Parameter, EditorRequired] public PublishedRecordKind Kind { get; set; }
    [Parameter, EditorRequired] public string RecordId { get; set; } = string.Empty;

    /// <summary>The id of the form whose approval closes the open reports.</summary>
    [Parameter, EditorRequired] public string ApprovalFormId { get; set; } = string.Empty;

    [Parameter] public bool CanEdit { get; set; } = true;

    [Parameter, EditorRequired] public bool CurrentRevisionApproved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var cancellationToken = HttpContext.RequestAborted;
        try
        {
            reports = await ListReports.ExecuteAsync(Actor, Kind, RecordId, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The reader report panel could not load.");
            failed = true;
        }
    }
}
