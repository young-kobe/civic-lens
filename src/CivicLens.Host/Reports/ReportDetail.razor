@page "/Review/Reports/{ReportId:guid}"
@inherits ReviewRecordPage
@using CivicLens.Application.Reports
@using CivicLens.Host.Components.Evidence
@using CivicLens.Host.Review

<TopBarTitle Crumbs="Crumbs" />

<div class="content">
    @if (item is null)
    {
        @if (error is not null)
        {
            <Notice Tone="Tone.Bad">@error</Notice>
        }
        @if (notFound)
        {
            <Panel Label="Report not found">
                <EmptyState Title="Report not found" Text="This report does not exist, or its link is not valid.">
                    <Action><Button Href="@ReportRoutes.List">Go to Reader reports</Button></Action>
                </EmptyState>
            </Panel>
            <form @formname="decide" @onsubmit="DecideAsync" hidden></form>
        }
    }
    else
    {
        var report = item.Report;
        <PageHeader Title="@ReportLabels.Category(report.Category)" Meta="HeaderMeta" />

        @if (error is not null)
        {
            <Notice Tone="Tone.Bad">@error</Notice>
        }
        @if (statusMessage is not null)
        {
            <Notice Tone="@(isConflict ? Tone.Warn : Tone.Ok)" Dismissible="@(!isConflict)">@statusMessage</Notice>
        }
        <Notice Tone="Tone.Warn">The text below comes from a reader. Check it against the record. It may be wrong.</Notice>

        <Panel Label="Report" Padded="true">
            <p class="record-body" id="report-text">@(string.IsNullOrWhiteSpace(report.Text) ? "The reader wrote no text." : report.Text)</p>
            <Facts Items="ReportFacts" />
            @if (ReportLabels.EditorOf(item) is { } editor)
            {
                <p class="small"><a href="@editor">Open the record in the editor</a></p>
            }
            else
            {
                <p class="small muted">Review storage has no such record, so there is no editor link.</p>
            }
        </Panel>

        @if (report.Status == ReaderReportStatus.Open)
        {
            <Panel Title="Resolve this report" Id="decision" Padded="true">
                <form id="decision-form" class="form" method="post" @formname="decide" @onsubmit="DecideAsync">
                    <AntiforgeryToken />
                    <input type="hidden" name="expectedReviewStateVersion" value="@report.Version" />
                    <Field Label="Note" For="Decision_Note" Hint="A report that needs a correction needs a note. The record page shows the note until a newer revision is published.">
                        <textarea id="Decision_Note" class="plain" name="Decision.Note" maxlength="@ResolveReaderReport.MaximumNoteCharacters" aria-describedby="Decision_Note-hint"></textarea>
                    </Field>
                    <div class="actions">
                        <Button Variant="ButtonVariant.Primary" Type="submit" name="kind" value="CorrectionNeeded">Correction needed</Button>
                        <Button Type="submit" name="kind" value="Dismissed">Dismiss</Button>
                        <Button Href="@ReportRoutes.List">Back to the list</Button>
                    </div>
                </form>
            </Panel>
        }
        else
        {
            <Panel Title="Resolution" Id="resolution" Padded="true">
                <Facts Items="ResolutionFacts" />
                <div class="actions"><Button Href="@ReportRoutes.List">Back to the list</Button></div>
            </Panel>
            <form @formname="decide" @onsubmit="DecideAsync" hidden></form>
        }
    }
</div>

@code {
    private RenderFragment HeaderMeta =>
        @<text>
            <StatusBadge Tone="@(item!.Report.Status == ReaderReportStatus.Open ? Tone.Warn : Tone.Neutral)" Text="@ReportLabels.Status(item.Report.Status)" />
        </text>;
}
