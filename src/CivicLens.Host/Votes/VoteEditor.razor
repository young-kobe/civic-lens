@page "/Review/Votes/{RecordId}"
@inherits PublishedRecordEditorPage
@using CivicLens.Core.Review
@using CivicLens.Core.Votes
@using CivicLens.Host.Actions
@using CivicLens.Host.Collection
@using CivicLens.Host.Reports
@using CivicLens.Host.Review

@if (detail is null)
{
    <TopBarTitle Crumbs="Crumbs" />
    <div class="content">
        @if (error is not null)
        {
            <Notice Tone="Tone.Bad">@error</Notice>
        }
        @if (notFound)
        {
            <Panel Label="Vote not found">
                <EmptyState Title="Vote not found" Text="This vote record does not exist, or its link is not valid.">
                    <Action><Button Href="/Review">Go to Review</Button></Action>
                </EmptyState>
            </Panel>
            <form @formname="save" @onsubmit="SaveAsync" hidden></form>
            <form @formname="decide" @onsubmit="DecideAsync" hidden></form>
        }
    </div>
}
else
{
    var review = detail.Review;
    var revision = review.CurrentRevision;
    var concerns = review.UnresolvedConcerns;
    <TopBarTitle Crumbs="Crumbs" />
    <div class="content">
        <PageHeader Title="@revision.Headline" RecordId="@RecordId" Meta="HeaderMeta(review.CurrentStatus, concerns.Length)" />

        @if (error is not null)
        {
            <Notice Tone="Tone.Bad">@error</Notice>
        }
        @if (statusMessage is not null)
        {
            <Notice Tone="@(isConflict ? Tone.Warn : Tone.Ok)" Dismissible="@(!isConflict)">@statusMessage</Notice>
        }
        <ReaderReportBanner Actor="actor" Kind="PublishedRecordKind.Vote" RecordId="@RecordId" />
        @if (revision.AuthorKind == ReviewAuthorKind.Analysis)
        {
            <Notice Tone="Tone.Warn">The AI drafter wrote this revision. It is not a human decision. Code built the vote kind, the facts, and the member votes with their citations. Check the headline and the summary against them before you approve.</Notice>
        }
        @if (concerns.Length > 0)
        {
            <Notice Tone="Tone.Warn">Approval is blocked. @(concerns.Length == 1 ? "Resolve the open concern below first." : $"Resolve the {concerns.Length} open concerns below first.")</Notice>
        }

        @if (isDraftConflict && Input is not null)
        {
            <Panel Title="Compare the latest saved revision with your wording" Id="conflict-compare" Padded="true">
                <div class="split">
                    <RecordView Headline="@($"Saved revision {revision.RevisionNumber}: {revision.Headline}")" Summary="@revision.Summary" />
                    <RecordView Headline="@($"Your wording: {Input.Headline}")" Summary="@Input.Summary" />
                </div>
                <p class="muted small">The form still holds your wording. Saving again makes a new revision on top of the latest saved one.</p>
            </Panel>
        }

        <Panel Title="Change since the last approval" Id="change" Padded="true">
            @if (review.LastApprovedRevision is not { } approved)
            {
                <p class="muted small">No revision is approved yet. Review the whole record.</p>
            }
            else if (approved.RevisionNumber == revision.RevisionNumber)
            {
                <p class="muted small">This revision is the approved revision.</p>
            }
            else
            {
                <div class="split">
                    <RecordView Headline="@($"Approved revision {approved.RevisionNumber}: {approved.Headline}")" Summary="@approved.Summary" Facts="FactsOf(approved)" />
                    <RecordView Headline="@($"Revision {revision.RevisionNumber}: {revision.Headline}")" Summary="@revision.Summary" Facts="FactsOf(revision)" />
                </div>
            }
        </Panel>

        <div class="split">
            <Panel Label="Vote record" Padded="true">
                <TabSet Label="Vote record views" Selected="@SelectedTab" Tabs="RecordTabs">
                    <TabPane Key="saved" Label="@($"Saved revision {revision.RevisionNumber}")">
                        <RecordView Id="saved-approval-target" Headline="@revision.Headline" Summary="@revision.Summary" Facts="FactsOf(revision)" />
                    </TabPane>
                    <TabPane Key="edit" Label="Edit wording">
                        @if (Input is not null)
                        {
                            <form id="draft-form" class="form" method="post" @formname="save" @onsubmit="SaveAsync"
                                  data-unsaved-form data-recovered-unsaved="@(hasUnsavedInput ? "true" : "false")">
                                <AntiforgeryToken />
                                <input type="hidden" name="expectedRevisionNumber" value="@revision.RevisionNumber" />
                                <input type="hidden" name="idempotencyKey" value="@saveKey" />
                                <Field Label="Headline" For="Input_Headline" Hint="@($"Up to {VoteDraftRevision.MaximumHeadlineLength} characters.")">
                                    <input id="Input_Headline" class="headline" name="Input.Headline" value="@Input.Headline" maxlength="@VoteDraftRevision.MaximumHeadlineLength" aria-describedby="Input_Headline-hint" />
                                </Field>
                                <Field Label="Plain-language summary" For="Input_Summary" Hint="@($"Say what the {revision.Chamber} voted on. Name no member, because code lists the member votes.")">
                                    <textarea id="Input_Summary" name="Input.Summary" maxlength="@VoteDraftRevision.MaximumSummaryLength" aria-describedby="Input_Summary-hint" value="@Input.Summary"></textarea>
                                </Field>
                                @if (revision.Suggestion is { } suggestion)
                                {
                                    <section class="stack" id="suggestion">
                                        <h3>AI suggestion</h3>
                                        <p class="muted small">The AI drafter wrote this text for the newest facts. Your text stays until you choose.</p>
                                        <RecordView Headline="@suggestion.Headline" Summary="@suggestion.Summary" HeadingLevel="3" />
                                        <div class="actions">
                                            <Button Type="submit" name="Input.SuggestionAction" value="@SuggestionActions.Use">Use suggestion</Button>
                                            <Button Type="submit" name="Input.SuggestionAction" value="@SuggestionActions.Dismiss">Dismiss</Button>
                                        </div>
                                    </section>
                                }
                                <div class="actions">
                                    <Button Variant="ButtonVariant.Primary" Type="submit">Save revision @(revision.RevisionNumber + 1)</Button>
                                    <span class="actions-hint">Approval applies only to saved wording. A person cannot edit the member votes.</span>
                                </div>
                            </form>
                        }
                    </TabPane>
                </TabSet>
            </Panel>

            <Panel Title="Evidence" Id="evidence" Padded="true" Raised="true" Class="split-sticky">
                <p class="small muted">Code built each citation from the saved @revision.Chamber vote text of @Moment.Day(revision.CandidateUpdateDate).</p>
                <p class="small">
                    <a href="@SourcePages.RollCall(revision.Chamber, revision.Congress, revision.SessionNumber, revision.RollCallNumber)" rel="noopener noreferrer">Roll call on @VoteLabels.RollCallSite(revision.Chamber)</a>
                    @if (detail!.BillActionRecordIds.FirstOrDefault() is { } actionRecordId)
                    {
                        <text> | </text><a href="@ActionRoutes.Editor(actionRecordId)">Action draft of this bill</a>
                    }
                </p>
                <ul class="choices">
                    @if (revision.KindCitation is { } kind)
                    {
                        <li><CitationQuote Label="@($"Vote kind: {VoteLabels.Kind(revision.Kind)}")" Quote="@(kind.QuoteIn(detail!.Extractions))" /></li>
                    }
                    @foreach (var fact in revision.Facts)
                    {
                        <li><CitationQuote Label="Fact" Quote="@(fact.Citation.QuoteIn(detail!.Extractions))" /></li>
                    }
                </ul>
                <TechnicalDetails Items="TechnicalItems" />
            </Panel>
        </div>

        <Panel Title="Tracked members" Id="members" Padded="true">
            <ul class="choices">
                @foreach (var member in revision.Members)
                {
                    <li><CitationQuote Label="@Describe(member)" Quote="@(member.Citation.QuoteIn(detail!.Extractions))" /></li>
                }
            </ul>
        </Panel>

        <ReviewDecisionPanel RevisionNumber="revision.RevisionNumber" ReviewStateVersion="review.ReviewStateVersion" Status="review.CurrentStatus"
                             Concerns="concerns" CanDecide="CanDecide" IdempotencyKey="@decisionKey" Note="@Decision?.Note" CorrectionNote="@Decision?.CorrectionNote" OnDecide="DecideAsync">
            <Checklist>
                <ul class="checklist">
                    <li>Does the headline match the result and the vote kind?</li>
                    <li>Does the summary use only the cited facts and name no member?</li>
                    <li>Does each member vote match its cited line?</li>
                </ul>
            </Checklist>
        </ReviewDecisionPanel>

        <TakeOffSitePanel Actor="actor" Record="TakeOffRecord" RevisionNumber="revision.RevisionNumber" ReviewStateVersion="review.ReviewStateVersion"
                          IdempotencyKey="@TakeOffFormKey" Note="@TakeOffNote" Refusal="@takeOffRefusal" OnSubmit="TakeOffSiteAsync" />

        <ReviewHistoryPanel Entries="History" ViewerSubject="@actor.Subject" />
    </div>
}

@code {
    private RenderFragment HeaderMeta(ReviewStatus status, int concerns) =>
        @<text>
            <StatusBadge Tone="DraftStatusDisplay.Tone(status)" Text="@DraftStatusDisplay.Label(status, concerns)" />
            <span class="muted small">@VoteLabels.RollCall(Revision), revision @Revision.RevisionNumber, saved @Moment.Full(Revision.CreatedAtUtc)</span>
        </text>;
}
