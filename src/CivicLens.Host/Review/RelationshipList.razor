@page "/Review/Relationships"
@using CivicLens.Application.Relationships

<TopBarTitle Crumbs="Crumbs" />

<div class="content">
    <PageHeader Title="Relationships" Lede="Links that the AI drafter proposed between an approved statement and an approved action or vote. Each link shows its newest revision." />
    @if (error is not null)
    {
        <Notice Tone="Tone.Bad">@error</Notice>
    }

    @if (drafts is not null && counts is not null)
    {
        <Panel Title="Relationships" Id="drafts">
            <Aside><FilterTabs Label="Filter relationships" Tabs="DraftTabs" /></Aside>
            <ChildContent>
                <DataTable Items="drafts.Items" Caption="Relationships">
                    <Head>
                        <th>Link</th>
                        <th>Status</th>
                        <th class="num">Open concerns</th>
                        <th class="act"><span class="visually-hidden">Open</span></th>
                    </Head>
                    <Row Context="item">
                        <td>
                            <a class="cell-title" href="@RelationshipRoutes.Editor(item.Review.RecordId)">@RelationshipLabels.Type(item.Review.CurrentRevision.Type)</a>
                            @if (item.CitedRecordsChanged)
                            {
                                <StatusBadge Tone="Tone.Warn" Text="Cited records changed" />
                            }
                            @if (item.Review.NoLongerMatches)
                            {
                                <StatusBadge Tone="Tone.Warn" Text="No longer matches" />
                            }
                            <span class="cell-sub">@item.StatementHeadline, then @item.TargetHeadline</span>
                        </td>
                        <td><StatusBadge Tone="DraftStatusDisplay.Tone(item.Review.CurrentStatus)" Text="@DraftStatusDisplay.Label(item.Review.CurrentStatus, item.Review.UnresolvedConcerns.Length)" /></td>
                        <td class="num">@item.Review.UnresolvedConcerns.Length</td>
                        <td class="act"><Button Small="true" Href="@RelationshipRoutes.Editor(item.Review.RecordId)">Open</Button></td>
                    </Row>
                    <Empty>
                        <EmptyState Title="@DraftsEmpty.Title" Text="@DraftsEmpty.Text" />
                    </Empty>
                </DataTable>
                <Pager Label="Relationship pages" NewerHref="@DraftsHref(drafts.NewerCursor)" OlderHref="@DraftsHref(drafts.OlderCursor)" />
            </ChildContent>
        </Panel>
    }
</div>
