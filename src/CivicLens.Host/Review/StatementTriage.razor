@page "/Review/Statements/Triage"
@inherits TriagePage

<TopBarTitle Crumbs="Crumbs" />

<div class="content">
    <PageHeader Title="Statement triage" Lede="Statement drafts that need action. Approve or request changes on a row, or open its editor." />
    @if (statusMessage is not null)
    {
        <Notice Tone="Tone.Ok" Dismissible="true">@statusMessage</Notice>
    }
    @if (error is not null)
    {
        <Notice Tone="Tone.Bad">@error</Notice>
    }

    <form id="decide" method="post" @formname="decide" @onsubmit="DecideSelectedAsync">
        <AntiforgeryToken />
        <input type="hidden" name="idempotencyKey" value="@renderKey" />
    </form>

    @if (triage is not null)
    {
        <Panel Title="Drafts" Id="drafts">
            <Aside><a href="@StatementRoutes.List">All statement drafts</a></Aside>
            <ChildContent>
                <DraftFilterForm Label="Filter statement triage by issue, official, and date" Action="@($"{StatementRoutes.Triage}#drafts")"
                                 ClearHref="@ClearHref(StatementRoutes.Triage)"
                                 Issues="Issues.Issues" Officials="OfficialChoices"
                                 IssueId="@IssueId" OfficialId="@OfficialId" From="@From" To="@To" />
                <DataTable Items="triage.Rows" Caption="Statement drafts that need action">
                    <Head>
                        <th>Statement</th>
                        <th>Decision</th>
                    </Head>
                    <Row Context="row">
                        @{ var item = row.Review; var revision = item.CurrentRevision!; }
                        <td>
                            <a class="cell-title" href="@StatementRoutes.Editor(item.CandidateId)">@DraftStatusDisplay.DraftName(revision.Headline)</a>
                            <span class="cell-sub">@revision.Summary</span>
                            <ul class="choices">
                                @foreach (var quotation in revision.Quotations)
                                {
                                    <li><CitationQuote Label="Quotation" Quote="@quotation.Span.QuoteIn(triage.Extractions)" /></li>
                                }
                            </ul>
                            <ApprovalCheckView Check="row.Check" />
                        </td>
                        <td>
                            <TriageDecisionControls RecordId="@item.CandidateId" RevisionNumber="revision.RevisionNumber" ReviewStateVersion="item.ReviewStateVersion"
                                                    HasOpenConcerns="@(item.UnresolvedConcernCount > 0)" Check="row.Check" EditorHref="@StatementRoutes.Editor(item.CandidateId)" />
                        </td>
                    </Row>
                    <Empty>
                        <EmptyState Title="No statements need action" Text="Every draft is approved, or none matches the filter." />
                    </Empty>
                </DataTable>
                <Pager Label="Statement triage pages" NewerHref="@PagerHref(triage.NewerCursor)" OlderHref="@PagerHref(triage.OlderCursor)" />
            </ChildContent>
        </Panel>
    }
</div>
