@page "/Review/Statements"
@inherits DraftListPage

<TopBarTitle Crumbs="Crumbs" />

<div class="content">
    <PageHeader Title="Statements" Lede="Statements that the AI drafter wrote or that need a person to start them." />
    @if (StatusMessage is not null)
    {
        <Notice Tone="Tone.Bad" Dismissible="true">@StatusMessage</Notice>
    }
    @if (error is not null)
    {
        <Notice Tone="Tone.Bad">@error</Notice>
    }

    <form id="start-statement" method="post" @formname="start-statement" @onsubmit="StartDraftAsync">
        <AntiforgeryToken />
        <input type="hidden" name="idempotencyKey" value="@renderKey" />
    </form>

    @if (drafts is not null && notInReview is not null && counts is not null)
    {
        <Panel Title="Drafts" Id="drafts">
            <Aside><FilterTabs Label="Filter statement drafts" Tabs="DraftTabs" /></Aside>
            <ChildContent>
                <DraftFilterForm Label="Filter statement drafts by issue, official, and date" Action="@($"{StatementRoutes.List}#drafts")"
                                 ClearHref="@ClearHref(StatementRoutes.List)" Status="@DraftFilterNames.NameOf(Filter)"
                                 Issues="Issues.Issues" Officials="OfficialChoices"
                                 IssueId="@IssueId" OfficialId="@OfficialId" From="@From" To="@To" />
                <DataTable Items="drafts.Items" Caption="Statement drafts">
                    <Head>
                        <th>Statement</th>
                        <th class="fit hide-narrow">Source</th>
                        <th>Status</th>
                        <th class="num">Open concerns</th>
                        <th class="act"><span class="visually-hidden">Action</span></th>
                    </Head>
                    <Row Context="draft">
                        <td><a class="cell-title" href="@StatementRoutes.Editor(draft.CandidateId)">@HeadlineOf(draft)</a></td>
                        <td class="fit hide-narrow">@draft.SourceId</td>
                        <td><StatusBadge Tone="DraftStatusDisplay.Tone(draft.CurrentStatus)" Text="@DraftStatusDisplay.Label(draft.CurrentStatus, draft.UnresolvedConcernCount)" /></td>
                        <td class="num">@draft.UnresolvedConcernCount</td>
                        <td class="act"><Button Small="true" Href="@StatementRoutes.Editor(draft.CandidateId)">Open</Button></td>
                    </Row>
                    <Empty>
                        <EmptyState Title="@DraftsEmpty.Title" Text="@DraftsEmpty.Text" />
                    </Empty>
                </DataTable>
                <Pager Label="Statement draft pages" NewerHref="@DraftsHref(drafts.NewerCursor)" OlderHref="@DraftsHref(drafts.OlderCursor)" />
            </ChildContent>
        </Panel>

        <Panel Title="Not in review" Id="not-in-review">
            <Aside>Articles with no draft. A person can start a draft for any of them.</Aside>
            <ChildContent>
                <DataTable Items="notInReview.Items" Caption="Statements not in review">
                    <Head>
                        <th class="fit">Source</th>
                        <th>URL</th>
                        <th>Reason</th>
                        <th class="act"><span class="visually-hidden">Action</span></th>
                    </Head>
                    <Row Context="item">
                        <td class="fit">@item.SourceId</td>
                        <td><a class="cell-title" href="@StatementRoutes.Editor(item.CandidateId)">@item.Url</a></td>
                        <td>@item.ReasonCode</td>
                        <td class="act">
                            <Button Variant="ButtonVariant.Primary" Small="true" Type="submit" form="start-statement" name="candidateId" value="@item.CandidateId">Start draft</Button>
                        </td>
                    </Row>
                    <Empty>
                        <EmptyState Title="Every statement is in review" Text="Articles that the gate skips or that fail to draft show here." />
                    </Empty>
                </DataTable>
                <Pager Label="Not in review pages" NewerHref="@NotInReviewHref(notInReview.NewerCursor)" OlderHref="@NotInReviewHref(notInReview.OlderCursor)" />
            </ChildContent>
        </Panel>
    }
</div>
