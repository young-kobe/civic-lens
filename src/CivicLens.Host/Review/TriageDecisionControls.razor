@using CivicLens.Application.Review

@if (!HasOpenConcerns)
{
    <textarea class="plain" form="decide" name="@($"notes[{RecordId}]")" maxlength="4000" rows="2" aria-label="Note for requesting changes"></textarea>
    <div class="actions">
        @if (Check.Passed)
        {
            <Button Variant="ButtonVariant.Primary" Small="true" Type="submit" form="decide" name="approve" value="@Target">Approve</Button>
        }
        <Button Small="true" Type="submit" form="decide" name="requestChanges" value="@Target">Request changes</Button>
    </div>
}
<Button Small="true" Href="@EditorHref">Open editor</Button>

@code {
    [Parameter, EditorRequired] public string RecordId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int RevisionNumber { get; set; }
    [Parameter, EditorRequired] public int ReviewStateVersion { get; set; }
    [Parameter, EditorRequired] public bool HasOpenConcerns { get; set; }
    [Parameter, EditorRequired] public ApprovalCheck Check { get; set; } = default!;
    [Parameter, EditorRequired] public string EditorHref { get; set; } = string.Empty;

    private string Target => TriageTargets.Format(RecordId, RevisionNumber, ReviewStateVersion);
}
