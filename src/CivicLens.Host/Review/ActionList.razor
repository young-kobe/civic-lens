@page "/Review/Actions"
@inherits DraftListPage
@using CivicLens.Application.Actions
@using CivicLens.Application.Review

<TopBarTitle Crumbs="Crumbs" />

<div class="content">
    <PageHeader Title="Actions" Lede="Bill sponsorship records that the AI drafter wrote. Each record has one entry, which shows its newest revision." />
    @if (error is not null)
    {
        <Notice Tone="Tone.Bad">@error</Notice>
    }
    @if (approvals is not null)
    {
        <Panel Title="Bulk approval results" Id="approval-results">
            <DataTable Items="approvals" Caption="Bulk approval results">
                <Head>
                    <th>Record</th>
                    <th>Result</th>
                </Head>
                <Row Context="result">
                    <td><a class="cell-title" href="@ActionRoutes.Editor(result.RecordId)">@result.RecordId</a></td>
                    <td><StatusBadge Tone="@(result.Outcome == BulkApprovalOutcome.Approved ? Tone.Ok : Tone.Warn)" Text="@OutcomeLabel(result.Outcome)" /></td>
                </Row>
            </DataTable>
        </Panel>
    }

    @if (drafts is not null && counts is not null)
    {
        <form id="approve-sponsorships" method="post" @formname="approve-sponsorships" @onsubmit="ApproveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="idempotencyKey" value="@renderKey" />
        </form>
        <Panel Title="Records" Id="drafts">
            <Aside><FilterTabs Label="Filter action records" Tabs="DraftTabs" /></Aside>
            <ChildContent>
                <DraftFilterForm Label="Filter action records by issue, official, and date" Action="@($"{ActionRoutes.List}#drafts")"
                                 ClearHref="@ClearHref(ActionRoutes.List)" Status="@DraftFilterNames.NameOf(Filter)"
                                 Issues="Issues.Issues" Officials="OfficialChoices"
                                 IssueId="@IssueId" OfficialId="@OfficialId" From="@From" To="@To" />
                <DataTable Items="drafts.Items" Caption="Action records">
                    <Head>
                        <th class="fit"><span class="visually-hidden">Select</span></th>
                        <th>Action</th>
                        <th class="fit hide-narrow">Bill</th>
                        <th>Status</th>
                        <th class="num">Open concerns</th>
                        <th class="act"><span class="visually-hidden">Open</span></th>
                    </Head>
                    <Row Context="item">
                        <td class="fit">
                            @if (item.IsSponsorshipOnly)
                            {
                                <input type="checkbox" form="approve-sponsorships" name="targets" value="@TargetOf(item)" aria-label="@($"Select {item.CurrentRevision.Headline}")" />
                            }
                        </td>
                        <td>
                            <a class="cell-title" href="@ActionRoutes.Editor(item.RecordId)">@item.CurrentRevision.Headline</a>
                            @if (item.IsSponsorshipOnly)
                            {
                                <StatusBadge Text="Sponsorship change only" />
                            }
                            @if (PriorityLabels.Of(drafts.Priorities[item.RecordId]) is { } tier)
                            {
                                <StatusBadge Text="@tier" />
                            }
                        </td>
                        <td class="fit hide-narrow">@ActionLabels.Bill(item.CurrentRevision)</td>
                        <td><StatusBadge Tone="DraftStatusDisplay.Tone(item.CurrentStatus)" Text="@DraftStatusDisplay.Label(item.CurrentStatus, item.UnresolvedConcerns.Length)" /></td>
                        <td class="num">@item.UnresolvedConcerns.Length</td>
                        <td class="act"><Button Small="true" Href="@ActionRoutes.Editor(item.RecordId)">Open</Button></td>
                    </Row>
                    <Empty>
                        <EmptyState Title="@DraftsEmpty.Title" Text="@DraftsEmpty.Text" />
                    </Empty>
                </DataTable>
                <Pager Label="Action record pages" NewerHref="@DraftsHref(drafts.NewerCursor)" OlderHref="@DraftsHref(drafts.OlderCursor)" />
                @if (drafts.Items.Any(item => item.IsSponsorshipOnly))
                {
                    <Toolbar>
                        <Button Variant="ButtonVariant.Primary" Type="submit" form="approve-sponsorships">Approve selected sponsorship changes</Button>
                        <span class="actions-hint">@($"Up to {BulkApproval.MaximumRecords} records. Each record gets its own decision.")</span>
                    </Toolbar>
                }
            </ChildContent>
        </Panel>
    }
</div>
