@using CivicLens.Core.Review

@if (!View.Status.CanTakeOff)
{
    <form id="take-off-site-hidden" method="post" @formname="@FormName" @onsubmit="OnSubmit" hidden><AntiforgeryToken /></form>
}
@if (View.IsOwner && !View.Configured)
{
    <p id="take-off-site-missing" class="muted small">Take off site needs the release directory, collection and issue files</p>
}
@if (View.Failed)
{
    <Notice Tone="Tone.Warn">The review workspace could not check whether this record is on the public site. Refresh the page to try again.</Notice>
}
@if (Refusal is not null)
{
    <Notice Tone="Tone.Bad" id="take-off-site-refusal">@Refusal</Notice>
}
@if (View.Status.CanTakeOff)
{
    <Panel Title="Take off site" Id="take-off-site" Padded="true">
        @if (View.Status.ReadersSeeOldSite)
        {
            <Notice Tone="Tone.Warn" id="take-off-site-unserved">The release that took this record off is saved, but readers still see the old site. Press Take off site to finish.</Notice>
        }
        else
        {
            <p class="small">This record is on the public site now. If the record is approved, this action withdraws the approval. If a newer revision waits for review, it requests changes on that revision. Then it removes the record from the public site. Readers see your reason on the page that replaces it.</p>
            <p class="small muted">If a relationship or a brief on the site cites this record, take that one off first.</p>
            @if (View.Status.RolledBack)
            {
                <Notice Tone="Tone.Warn" id="take-off-site-rollback">The public site shows an older release, because someone rolled it back. While that lasts, the worker publishes nothing. This action publishes a new release, and the worker then publishes every ready approval.</Notice>
            }
        }
        <form id="take-off-site-form" class="form" method="post" @formname="@FormName" @onsubmit="OnSubmit">
            <AntiforgeryToken />
            <input type="hidden" name="expectedRevisionNumber" value="@RevisionNumber" />
            <input type="hidden" name="expectedReviewStateVersion" value="@ReviewStateVersion" />
            <input type="hidden" name="idempotencyKey" value="@IdempotencyKey" />
            <Field Label="Reason" For="TakeOff_Note" Hint="@($"1 to {PublishedCorrection.MaximumNoteLength} characters. Readers see this reason.")">
                <textarea id="TakeOff_Note" class="plain" name="note" maxlength="@PublishedCorrection.MaximumNoteLength" required aria-describedby="TakeOff_Note-hint" value="@Note"></textarea>
            </Field>
            <div class="actions">
                <Button Variant="ButtonVariant.Danger" Type="submit">Take off site</Button>
            </div>
        </form>
    </Panel>
}

@code {
    public const string FormName = "take-off-site";
    public const string DoneStatus = "off-site";

    [Parameter, EditorRequired] public TakeOffSiteView View { get; set; } = TakeOffSiteView.Hidden;
    [Parameter, EditorRequired] public int RevisionNumber { get; set; }
    [Parameter, EditorRequired] public int ReviewStateVersion { get; set; }
    [Parameter, EditorRequired] public string IdempotencyKey { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback OnSubmit { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Refusal { get; set; }
}
