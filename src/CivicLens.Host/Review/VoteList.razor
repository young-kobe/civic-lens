@page "/Review/Votes"
@inherits DraftListPage

<TopBarTitle Crumbs="Crumbs" />

<div class="content">
    <PageHeader Title="Votes" Lede="House roll-call records that the AI drafter wrote. Each record has one entry, which shows its newest revision." />
    @if (error is not null)
    {
        <Notice Tone="Tone.Bad">@error</Notice>
    }

    @if (drafts is not null && counts is not null)
    {
        <Panel Title="Records" Id="drafts">
            <Aside><FilterTabs Label="Filter vote records" Tabs="DraftTabs" /></Aside>
            <ChildContent>
                <DraftFilterForm Label="Filter vote records by issue, official, and date" Action="@($"{VoteRoutes.List}#drafts")"
                                 ClearHref="@ClearHref(VoteRoutes.List)" Status="@DraftFilterNames.NameOf(Filter)"
                                 Issues="Issues.Issues" OfficialIds="[.. Catalog.OfficialIds.Order(StringComparer.Ordinal)]"
                                 IssueId="@IssueId" OfficialId="@OfficialId" From="@From" To="@To" />
                <DataTable Items="drafts.Items" Caption="Vote records">
                    <Head>
                        <th>Vote</th>
                        <th class="fit hide-narrow">Roll call</th>
                        <th class="fit hide-narrow">Kind</th>
                        <th>Status</th>
                        <th class="num">Open concerns</th>
                        <th class="act"><span class="visually-hidden">Open</span></th>
                    </Head>
                    <Row Context="item">
                        <td>
                            <a class="cell-title" href="@VoteRoutes.Editor(item.RecordId)">@item.CurrentRevision.Headline</a>
                            @if (PriorityLabels.Of(drafts.Priorities[item.RecordId]) is { } tier)
                            {
                                <StatusBadge Text="@tier" />
                            }
                        </td>
                        <td class="fit hide-narrow">@VoteLabels.RollCall(item.CurrentRevision)</td>
                        <td class="fit hide-narrow">@VoteLabels.Kind(item.CurrentRevision.Kind)</td>
                        <td><StatusBadge Tone="DraftStatusDisplay.Tone(item.CurrentStatus)" Text="@DraftStatusDisplay.Label(item.CurrentStatus, item.UnresolvedConcerns.Length)" /></td>
                        <td class="num">@item.UnresolvedConcerns.Length</td>
                        <td class="act"><Button Small="true" Href="@VoteRoutes.Editor(item.RecordId)">Open</Button></td>
                    </Row>
                    <Empty>
                        <EmptyState Title="@DraftsEmpty.Title" Text="@DraftsEmpty.Text" />
                    </Empty>
                </DataTable>
                <Pager Label="Vote record pages" NewerHref="@DraftsHref(drafts.NewerCursor)" OlderHref="@DraftsHref(drafts.OlderCursor)" />
            </ChildContent>
        </Panel>
    }
</div>
