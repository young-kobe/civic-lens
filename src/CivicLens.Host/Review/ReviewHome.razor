@page "/Review"
@using CivicLens.Application.Publication
@using CivicLens.Host.Analysis
@using CivicLens.Application.Review
@using CivicLens.Core.Review
@using CivicLens.Host.Collection
@using CivicLens.Host.Publication
@using CivicLens.Publication.Contracts
@using CivicLens.Host.Briefs
@using CivicLens.Host.Relationships
@using CivicLens.Host.Statements
@using CivicLens.Host.Reports
@using CivicLens.Host.Documents

<TopBarTitle Crumbs="Crumbs" />

<div class="content">
    @if (StatusMessage is not null)
    {
        <Notice Tone="StatusTone" Dismissible="true">@StatusMessage</Notice>
    }
    @if (error is not null)
    {
        <Notice Tone="Tone.Bad">@error</Notice>
    }

    @if (lookupMessage is not null)
    {
        <Notice Tone="Tone.Warn" Dismissible="true">@lookupMessage</Notice>
    }
    <form class="list-filter" method="get" action="/Review" role="search" aria-label="Find a draft by bill or roll call">
        <Field Label="Find a draft" For="find" Hint="A bill such as HR 1234 or 118 HR 1234, or a roll call such as Roll 245.">
            <input id="find" name="find" value="@Find" maxlength="64" aria-describedby="find-hint" />
        </Field>
        <Button Variant="ButtonVariant.Primary" Small="true" Type="submit">Find</Button>
    </form>

    <form id="start-draft" method="post" @formname="start-draft" @onsubmit="StartDraftAsync">
        <AntiforgeryToken />
        <input type="hidden" name="idempotencyKey" value="@renderKey" />
    </form>

    @if (canPublish)
    {
        <form id="publish-confirm" method="post" @formname="publish-confirm" @onsubmit="PublishAsync">
            <AntiforgeryToken />
            <input type="hidden" name="idempotencyKey" value="@renderKey" />
            @if (selection is not null)
            {
                @foreach (var item in selection)
                {
                    <input type="hidden" name="records" value="@item.Reference" />
                }
            }
        </form>
    }

    @if (overview is not null && changes is not null && drafts is not null)
    {
        <StatStrip Label="Review summary">
            <Stat Value="overview.NewChanges" Label="New changes" Href="#new-changes" />
            <Stat Value="overview.DraftsNeedingAction" Label="Drafts need action" Tone="Tone.Warn" Href="/Review?drafts=needs-action#drafts" />
            <Stat Value="overview.ApprovedDrafts" Label="Approved, private" Tone="Tone.Ok" Href="/Review?drafts=approved#drafts" />
            <Stat Value="statementCounts!.NeedsAction" Label="Statements need action" Tone="Tone.Warn" Href="@($"{StatementRoutes.List}?drafts={DraftFilterNames.NeedsAction}")" />
            <Stat Value="briefCounts!.NeedsAction" Label="Briefs need action" Tone="Tone.Warn" Href="@($"{BriefRoutes.List}?drafts={DraftFilterNames.NeedsAction}")" />
            <Stat Value="relationshipCounts!.NeedsAction" Label="Relationships need action" Tone="Tone.Warn" Href="@($"{RelationshipRoutes.List}?drafts={DraftFilterNames.NeedsAction}")" />
            <Stat Value="openReports" Label="Reader reports open" Tone="Tone.Warn" Href="@ReportRoutes.List" />
            @if (ready is not null)
            {
                <Stat Value="ready.Items.Length" Label="Ready to publish" Tone="Tone.Ok" Href="#publish" />
            }
            @if (health is not null)
            {
                <Stat Value="health.AttentionCount" Label="Sources need attention" Tone="Tone.Bad" Href="/Review/Sources" />
            }
        </StatStrip>

        <div class="dashboard">
            <div class="dashboard-main">
                <Panel Title="New changes" Id="new-changes">
                    <Aside>A text change alone does not show significance.</Aside>
                    <ChildContent>
                        @{ var draftingNotice = DocumentChangeAnalysisDisplay.Notice(analysisStatus, DateTimeOffset.UtcNow); }
                        <Notice Tone="draftingNotice.Tone">@draftingNotice.Text</Notice>
                        <DataTable Items="changes.Items" Caption="New changes">
                            <Head>
                                <th>Document</th>
                                <th class="fit hide-narrow">Source</th>
                                <th class="time">Observed</th>
                                <th class="num hide-narrow">Passages</th>
                                <th class="fit">AI draft</th>
                                <th class="act"><span class="visually-hidden">Action</span></th>
                            </Head>
                            <Row Context="item">
                                <td>
                                    <a class="cell-title" href="@($"/Documents/Comparison?comparisonId={item.ComparisonId}")">@SourceLabels.Document(item.RequestedUrl)</a>
                                    <RedlineExcerpt Hunk="item.FirstPassage" />
                                </td>
                                <td class="fit hide-narrow">@SourceLabels.Name(configuration, item.SourceId)</td>
                                <td class="time"><Timestamp Value="item.ObservedAtUtc" /></td>
                                <td class="num hide-narrow">@item.PassageCount</td>
                                <td class="fit">
                                    @{ var changeDrafting = DocumentChangeAnalysisDisplay.For(analyses.GetValueOrDefault(item.ComparisonId)); }
                                    <StatusBadge Tone="changeDrafting.Tone" Text="@changeDrafting.Label" />
                                </td>
                                <td class="act">
                                    <Button Variant="ButtonVariant.Primary" Small="true" Type="submit" form="start-draft" name="comparisonId" value="@item.ComparisonId">Start draft</Button>
                                </td>
                            </Row>
                            <Empty>
                                <EmptyState Title="No new changes" Text="Sources are checked every hour. A first check saves a baseline. Later text changes show here.">
                                    <Action>
                                        @if (actor?.Role == ReviewRole.Owner)
                                        {
                                            <Button Href="/Review/Sources">Go to Sources</Button>
                                        }
                                    </Action>
                                </EmptyState>
                            </Empty>
                        </DataTable>
                        <Pager Label="New changes pages" Summary="@Count(overview.NewChanges, "new change", "new changes")"
                               NewerHref="@ChangesHref(changes.NewerCursor)" OlderHref="@ChangesHref(changes.OlderCursor)" />
                    </ChildContent>
                </Panel>

                <Panel Title="Drafts" Id="drafts">
                    <Aside><FilterTabs Label="Filter drafts" Tabs="DraftTabs" /></Aside>
                    <ChildContent>
                        <DataTable Items="drafts.Items" Caption="Drafts">
                            <Head>
                                <th>Account</th>
                                <th>Status</th>
                                <th class="num hide-narrow">Revision</th>
                                <th class="time">Updated</th>
                                <th class="act"><span class="visually-hidden">Action</span></th>
                            </Head>
                            <Row Context="draft">
                                <td>
                                    <a class="cell-title" href="@DocumentRoutes.Editor(draft.DraftId)">@DraftStatusDisplay.DraftName(draft.CurrentRevision.Headline)</a>
                                    <span class="cell-sub">@(string.IsNullOrWhiteSpace(draft.CurrentRevision.Summary) ? "Add a plain-language summary before approval." : draft.CurrentRevision.Summary)</span>
                                </td>
                                <td><StatusBadge Tone="DraftStatusDisplay.Tone(draft.CurrentStatus)" Text="@DraftStatusDisplay.Label(draft.CurrentStatus, draft.UnresolvedConcernCount)" /></td>
                                <td class="num hide-narrow">@draft.CurrentRevision.RevisionNumber</td>
                                <td class="time"><Timestamp Value="draft.CurrentRevision.CreatedAtUtc" /></td>
                                <td class="act"><Button Small="true" Href="@DocumentRoutes.Editor(draft.DraftId)">Open</Button></td>
                            </Row>
                            <Empty>
                                <EmptyState Title="@DraftsEmpty.Title" Text="@DraftsEmpty.Text" />
                            </Empty>
                        </DataTable>
                        <Pager Label="Draft pages" NewerHref="@DraftsHref(drafts.NewerCursor)" OlderHref="@DraftsHref(drafts.OlderCursor)" />
                    </ChildContent>
                </Panel>

                @if (ready is not null)
                {
                    <Panel Title="Publish" Id="publish">
                        <Aside>@(ready.HasMore ? $"First {PublishRelease.MaximumRecords} shown" : Count(ready.Items.Length, "record", "records"))</Aside>
                        <ChildContent>
                            @if (selectionStale)
                            {
                                <Notice Tone="Tone.Warn">Some selected records are no longer ready to publish. Choose again.</Notice>
                            }
                            @if (selection is not null)
                            {
                                <Notice Tone="Tone.Warn" Title="@($"Confirm release {nextReleaseNumber}")">
                                    This release holds the records below and every other record in the active release.
                                </Notice>
                                <DataTable Items="selection" Caption="Selected records">
                                    <Head>
                                        <th>Record</th>
                                        <th>Kind</th>
                                        <th>Status</th>
                                        <th class="num hide-narrow">Revision</th>
                                        <th>Correction note</th>
                                    </Head>
                                    <Row Context="item">
                                        <td><a class="cell-title" href="@RecordRoutes.Editor(item.Kind, item.RecordId)">@DraftStatusDisplay.DraftName(item.Headline)</a></td>
                                        <td>@PublishedRecordLabels.Kind(item.Kind)</td>
                                        <td>
                                            <StatusBadge Tone="@(item.IsReplacement ? Tone.Warn : Tone.Ok)" Text="@(item.IsReplacement ? "Replacement" : "New")" />
                                            @if (item.NoLongerMatches)
                                            {
                                                <StatusBadge Tone="Tone.Warn" Text="No longer matches" />
                                            }
                                        </td>
                                        <td class="num hide-narrow">@item.RevisionNumber</td>
                                        <td>
                                            @if (item.IsReplacement)
                                            {
                                                <textarea class="plain" form="publish-confirm" name="@($"notes[{item.Reference}]")" maxlength="@PublishedCorrection.MaximumNoteLength" rows="2" aria-label="@($"Correction note for {DraftStatusDisplay.DraftName(item.Headline)}")"></textarea>
                                            }
                                        </td>
                                    </Row>
                                </DataTable>
                                <Toolbar>
                                    <Button Href="/Review#publish">Change selection</Button>
                                    <Button Variant="ButtonVariant.Primary" Type="submit" form="publish-confirm">@($"Publish release {nextReleaseNumber}")</Button>
                                </Toolbar>
                            }
                            else
                            {
                                <form id="publish-select" method="get" action="/Review#publish"></form>
                                <DataTable Items="ready.Items" Caption="Records ready to publish">
                                    <Head>
                                        <th class="fit"><span class="visually-hidden">Select</span></th>
                                        <th>Record</th>
                                        <th>Kind</th>
                                        <th>Status</th>
                                        <th class="num hide-narrow">Revision</th>
                                    </Head>
                                    <Row Context="item">
                                        <td class="fit">
                                            @if (!item.IsWithdrawn)
                                            {
                                                <input type="checkbox" form="publish-select" name="publish" value="@item.Reference" aria-label="@($"Select {DraftStatusDisplay.DraftName(item.Headline)}")" />
                                            }
                                        </td>
                                        <td><a class="cell-title" href="@RecordRoutes.Editor(item.Kind, item.RecordId)">@DraftStatusDisplay.DraftName(item.Headline)</a></td>
                                        <td>@PublishedRecordLabels.Kind(item.Kind)</td>
                                        <td>
                                            @if (item.IsWithdrawn)
                                            {
                                                <StatusBadge Tone="Tone.Warn" Text="Withdrawn" />
                                                <span class="actions-hint">To bring it back, run <code>releases publish &lt;key&gt; @item.Reference --note @item.Reference "text"</code>.</span>
                                            }
                                            else
                                            {
                                                <StatusBadge Tone="@(item.IsReplacement ? Tone.Warn : Tone.Ok)" Text="@(item.IsReplacement ? "Replacement" : "New")" />
                                            }
                                            @if (item.NoLongerMatches)
                                            {
                                                <StatusBadge Tone="Tone.Warn" Text="No longer matches" />
                                            }
                                        </td>
                                        <td class="num hide-narrow">@item.RevisionNumber</td>
                                    </Row>
                                    <Empty>
                                        <EmptyState Title="Nothing is ready to publish" Text="Approved records show here until a release holds them. A new revision of a published record shows as a replacement." />
                                    </Empty>
                                </DataTable>
                                @if (ready.Items.Length > 0)
                                {
                                    <Toolbar>
                                        <Button Variant="ButtonVariant.Primary" Type="submit" form="publish-select">Review selection</Button>
                                    </Toolbar>
                                }
                            }
                        </ChildContent>
                    </Panel>
                }
                else if (publishingOff)
                {
                    <Notice Tone="Tone.Warn" Title="Publishing is off" id="publish">
                        Set CIVIC_LENS_RELEASE_DIRECTORY, CIVIC_LENS_COLLECTION_CONFIG, and CIVIC_LENS_ISSUES_CONFIG, then restart the workspace.
                    </Notice>
                }
            </div>

            <div class="dashboard-side">
                @if (health is not null)
                {
                    <Panel Title="Source health" Id="source-health">
                        <Aside><a href="/Review/Sources">All sources</a></Aside>
                        <ChildContent>
                            <HealthList Items="health.Sources.Select(item => SourceStatusDisplay.Item(SourceLabels.Name(configuration, item.SourceId), item)).ToArray()" />
                        </ChildContent>
                    </Panel>
                }
                @if (releases is not null)
                {
                    <Panel Title="Releases" Id="releases">
                        <DataTable Items="releases.Releases" Caption="Releases">
                            <Head>
                                <th class="num">Release</th>
                                <th class="time">Published</th>
                                <th class="num hide-narrow">Records</th>
                                <th>Status</th>
                            </Head>
                            <Row Context="release">
                                <td class="num">@release.ReleaseNumber</td>
                                <td class="time"><Timestamp Value="release.PublishedAtUtc" /></td>
                                <td class="num hide-narrow">@release.RecordCount</td>
                                <td>@if (release.ReleaseNumber == releases.ActiveReleaseNumber) { <StatusBadge Tone="Tone.Ok" Text="Active" /> }</td>
                            </Row>
                            <Empty>
                                <EmptyState Title="No releases yet" />
                            </Empty>
                        </DataTable>
                    </Panel>
                }
                <Panel Title="Recent activity" Id="recent-activity">
                    @if (activity.Count == 0)
                    {
                        <EmptyState Title="No activity yet" />
                    }
                    else
                    {
                        <ActivityFeed Items="activity" />
                    }
                </Panel>
            </div>
        </div>
    }
</div>
