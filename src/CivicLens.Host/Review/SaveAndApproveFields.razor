@using System.Collections.Immutable
@using CivicLens.Core.Review

<section class="stack" id="save-and-approve">
    @Checklist
    <input type="hidden" name="expectedReviewStateVersion" value="@ReviewStateVersion" />
    <Field Label="Note" For="Approval_Note" Hint="Resolving concerns needs a note.">
        <textarea id="Approval_Note" class="plain" name="Approval.Note" maxlength="4000" aria-describedby="Approval_Note-hint" value="@Approval?.Note"></textarea>
    </Field>
    <ApprovalInputs Prefix="Approval" Concerns="Concerns" ResolvedIds="Approval?.ResolvedDecisionIds" CorrectionNote="@Approval?.CorrectionNote" />
    <div class="actions">
        <Button Variant="ButtonVariant.Primary" Type="submit" name="approve" value="true">Save and approve</Button>
        <span class="actions-hint">@Hint Publishes soon.</span>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public int ReviewStateVersion { get; set; }
    [Parameter, EditorRequired] public ImmutableArray<ReviewDecision> Concerns { get; set; }
    [Parameter] public ReviewDecisionInput? Approval { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment? Checklist { get; set; }
}
