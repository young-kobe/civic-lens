@using CivicLens.Core.Review

<Panel Title="History" Id="history">
    <DataTable Items="Entries" Caption="Revisions and decisions">
        <Head>
            <th class="time">When</th>
            <th>Event</th>
            <th class="hide-narrow">By</th>
            <th>Note</th>
        </Head>
        <Row Context="entry">
            <td class="time"><Timestamp Value="entry.When" /></td>
            <td>
                @if (entry.Decision is { } decision)
                {
                    <StatusBadge Tone="DraftStatusDisplay.Tone(decision)" Text="@DraftStatusDisplay.Label(decision)" />
                }
                @entry.Event
            </td>
            <td class="hide-narrow">@Who(entry.ActorSubject)</td>
            <td>@entry.Note</td>
        </Row>
    </DataTable>
</Panel>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ReviewHistoryEntry> Entries { get; set; } = [];
    [Parameter, EditorRequired] public string ViewerSubject { get; set; } = string.Empty;

    private string Who(string subject) => ReviewAuthor.IsAnalysis(subject) ? "AI drafter"
        : ReviewAuthor.IsCode(subject) ? "Code check"
        : subject == ViewerSubject ? "You" : "Another reviewer";
}
