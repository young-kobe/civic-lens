@using CivicLens.Publication.Contracts

<PublicPage Title="Published records">
    <PageHeader Title="Published records" Lede="@($"Release {Release.ReleaseNumber}, published {Moment.Full(Release.PublishedAtUtc)}.")" />
    <Panel Label="Records">
        <DataTable Items="PageRecords" Caption="Published records">
            <Head><th>Record</th><th class="fit num hide-narrow">First published</th></Head>
            <Row Context="entry">
                <td><a class="cell-title" href="@PublicationProtocol.RecordPagePath(entry.RecordId)">@entry.Headline</a></td>
                <td class="time fit num hide-narrow"><Timestamp Value="entry.FirstPublishedAtUtc" Format="TimestampFormat.Day" /></td>
            </Row>
            <Empty><EmptyState Title="No records yet" Text="This release has no records." /></Empty>
        </DataTable>
        @if (PageCount > 1)
        {
            <Pager Label="Pages" Summary="@($"Page {Page} of {PageCount}")" NewerText="Previous" OlderText="Next"
                   NewerHref="@(Page > 1 ? PublicationProtocol.IndexPagePath(Page - 1) : null)"
                   OlderHref="@(Page < PageCount ? PublicationProtocol.IndexPagePath(Page + 1) : null)" />
        }
    </Panel>
</PublicPage>

@code {
    [Parameter, EditorRequired] public PublicationRelease Release { get; set; } = default!;
    [Parameter, EditorRequired] public int Page { get; set; }

    private int PageCount => PublicationProtocol.IndexPageCount(Release.Records.Length);

    private IReadOnlyList<PublishedRecordEntry> PageRecords =>
        [.. Release.Records.Skip((Page - 1) * PublicationProtocol.IndexPageSize).Take(PublicationProtocol.IndexPageSize)];
}
