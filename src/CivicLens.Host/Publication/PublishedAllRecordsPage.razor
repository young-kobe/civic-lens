@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.AllRecords" Title="All published records" Page="Page" PageCount="PageCount" Description="@($"All {Release.Records.Length} published records of Civic Lens, newest first. Each record shows its sources and the exact text it cites.")">
    <a class="back-link" href="@PublicationProtocol.HomePath">Home</a>
    <PageHeader Title="All published records" Lede="@($"Release {Release.ReleaseNumber}, published {Moment.Full(Release.PublishedAtUtc)}.")" />
    <Panel Label="Records">
        <PublishedRecordTable Records="PageRecords" Caption="Published records" />
        <Pager Label="Pages" Summary="@($"Page {Page} of {PageCount}")" NewerText="Previous" OlderText="Next"
               NewerHref="@(Page > 1 ? PublicationProtocol.AllRecordsPagePath(Page - 1) : null)"
               OlderHref="@(Page < PageCount ? PublicationProtocol.AllRecordsPagePath(Page + 1) : null)" />
    </Panel>
</PublicPage>

@code {
    [Parameter, EditorRequired] public PublicationRelease Release { get; set; } = default!;
    [Parameter, EditorRequired] public int Page { get; set; }

    private int PageCount => PublicationProtocol.PageCount(Release.Records.Length);

    private IReadOnlyList<PublishedRecordEntry> PageRecords =>
        [.. Release.Records.Skip((Page - 1) * PublicationProtocol.PageSize).Take(PublicationProtocol.PageSize)];
}
