@using CivicLens.Application.Publication
@using CivicLens.Host.Components.Layout
@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.Issues" Title="@Facet.Name" CanonicalPath="@Facet.PagePath(Page)" Page="Page" PageCount="Facet.PageCount" Description="@($"{KindLabel} {Facet.Name}: {Facet.Records.Length} published records that name it, newest event date first.")" RootPath="../" Crumbs="Crumbs">
    <PageHeader Title="@Facet.Name" Lede="@($"{KindLabel}. {Facet.Records.Length} published records, newest event date first. A record with no event date uses its first publication day.")" />
    @if (Page == 1)
    {
        <Panel Title="@PublishedFacetSummaryView.Title(Facet.Kind)" Padded="true">
            <p class="muted small">@PublishedFacetSummaryView.Lede(Facet.Kind)</p>
            @if (IsIssue)
            {
                <p class="muted small"><a href="@MethodLink(PublishedFacetSummaryView.IssueTagsAnchor)">@PublishedFacetSummaryView.IssueTagsLinkText</a></p>
            }
            <ul>
                @if (IsIssue)
                {
                    <li>@PublishedFacetSummaryView.Votes(Summary)</li>
                    @if (Summary.SplitVotes > 0)
                    {
                        <li>@PublishedFacetSummaryView.SplitVotes(Summary)</li>
                    }
                    @if (Summary.PartiesAgreedVotes > 0)
                    {
                        <li>@PublishedFacetSummaryView.PartiesAgreedVotes(Summary)</li>
                    }
                    @if (Summary.OtherVotes > 0)
                    {
                        <li>@PublishedFacetSummaryView.OtherVotes(Summary) <a href="@MethodLink(PublishedFacetSummaryView.OtherVotesAnchor)">@PublishedFacetSummaryView.OtherVotesLinkText</a></li>
                    }
                }
                <li>@PublishedFacetSummaryView.Bills(Summary, KindName)</li>
            </ul>
            @if (Summary.SplitVotes + Summary.PartiesAgreedVotes > 0)
            {
                <p class="muted small">@PublishedFacetSummaryView.PartiesNote</p>
            }
        </Panel>
    }
    <Panel Label="Records">
        <PublishedRecordTable Records="Facet.RecordsOnPage(Page)" Caption="@Facet.Name" RootPath="../" Columns="RecordTableColumns.Facet" Sort="Sort" />
        <Pager Label="Pages" Summary="@($"Page {Page} of {Facet.PageCount}")" NewerText="Previous" OlderText="Next"
               NewerHref="@(Page > 1 ? "../" + Facet.PagePath(Page - 1) : null)"
               OlderHref="@(Page < Facet.PageCount ? "../" + Facet.PagePath(Page + 1) : null)" />
    </Panel>
</PublicPage>

@code {
    private IReadOnlyList<Crumb> Crumbs => [PublicCrumbs.Home("../"), PublicCrumbs.Section(PublicSection.Issues, "../"), new(Facet.Name)];

    [Parameter, EditorRequired] public ReleaseFacet Facet { get; set; } = default!;
    [Parameter, EditorRequired] public int Page { get; set; }
    [Parameter] public string? PublicApiUrl { get; set; }

    private RecordSort? Sort => PublicApiUrl is null ? null
        : new(PublicApiUrl, Facet.Records.Length, $"{(IsIssue ? "issue" : "policyArea")}={Facet.Id}");

    private FacetSummary? summary;

    private FacetSummary Summary => summary ??= FacetSummary.From(Facet.Records);

    private bool IsIssue => Facet.Kind == FacetKind.Issue;

    private static string MethodLink(string anchor) => "../" + PublicationProtocol.MethodPagePath + anchor;

    private string KindName => KindLabel.ToLowerInvariant();

    private string KindLabel => IsIssue ? "Issue" : "Policy area";
}
