@using CivicLens.Host.Components.Ui

<Panel Title="Timeline" Id="timeline-title" Padded="true">
    <DataTable Roles="true" Items="Events" Caption="Dated events of this record">
        <Head><TableCell Header Class="fit num">@PublicColumn.Date</TableCell><TableCell Header>Event</TableCell></Head>
        <Row Context="item">
            <TableCell Class="fit num" Label="@PublicColumn.Date">@Moment.Day(item.Day)</TableCell>
            <TableCell Main>@item.Text</TableCell>
        </Row>
    </DataTable>
</Panel>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TimelineEvent> Events { get; set; } = [];
}
