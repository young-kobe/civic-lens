@using CivicLens.Publication.Contracts

<PublicPage Title="@Record.Headline" RootPath="../">
    <a class="back-link" href="@("../" + PublicationProtocol.IndexPagePath(1))">All records</a>
    <RecordView HeadingLevel="1" Headline="@Record.Headline" Summary="@Record.Summary" Significance="@Record.Significance"
                Limits="@Record.Limits" Facts="RecordFacts" />

    <Panel Title="What changed" Id="changes-title" Padded="true">
        <DocumentComparisonView Hunks="PublishedRecordView.Hunks(Record)" ViewId="@Record.RecordId" />
    </Panel>

    <Panel Title="Citations" Id="citations-title" Padded="true">
        <p class="muted small">Each quote is the exact text of the source version. Follow its link to see it marked in the full version.</p>
        <ul class="choices">
            @for (var index = 0; index < Record.Citations.Length; index++)
            {
                var citation = Record.Citations[index];
                var anchor = "#" + PublishedRecordView.CitationAnchor(index);
                <li>
                    <CitationQuote Label="@VersionLabel(citation)" Quote="@citation.Quote">
                        <a href="@anchor">Show in the full version</a>
                    </CitationQuote>
                </li>
            }
            @if (Record.ChangeDateEvidence is { } evidence)
            {
                <li>
                    <CitationQuote Label="@($"Evidence for the actual change date, {VersionLabel(evidence).ToLowerInvariant()}")" Quote="@evidence.Quote">
                        <a href="@($"#{PublishedRecordView.ChangeDateAnchor}")">Show in the full version</a>
                    </CitationQuote>
                </li>
            }
        </ul>
    </Panel>

    <Panel Title="Earlier version" Id="earlier-title" Padded="true">
        <VersionSource Version="Record.Before" />
        <DocumentText Label="Earlier version text" Runs="CitedText.Split(Record.Before.Text, PublishedRecordView.RangesIn(Record, Record.Before))" />
    </Panel>
    <Panel Title="Later version" Id="later-title" Padded="true">
        <VersionSource Version="Record.After" />
        <DocumentText Label="Later version text" Runs="CitedText.Split(Record.After.Text, PublishedRecordView.RangesIn(Record, Record.After))" />
    </Panel>

    <Caveat>Observation times show when each version was captured. They do not show when or why the source changed.</Caveat>
</PublicPage>

@code {
    [Parameter, EditorRequired] public PublishedDocumentChange Record { get; set; } = default!;

    private string VersionLabel(PublishedCitation citation) =>
        citation.ExtractionId == Record.Before.ExtractionId ? "Earlier version" : "Later version";

    private IReadOnlyList<Fact> RecordFacts
    {
        get
        {
            var facts = new List<Fact> { new("Source institution", Record.Institution) };
            if (Record.ChangeDate is { } date) facts.Add(new("Actual change date", Moment.Iso(date)));
            facts.Add(new("Observed", $"Earlier version {Moment.Full(Record.Before.ObservedAtUtc)}; later version {Moment.Full(Record.After.ObservedAtUtc)}"));
            facts.Add(new("Officials", Record.Officials.Length == 0 ? "None" : string.Join(", ", Record.Officials.Select(official => official.Name))));
            facts.Add(new("Issues", Record.IssueIds.Length == 0 ? "None" : string.Join(", ", Record.IssueIds)));
            facts.Add(new("Published", $"Approved {Moment.Full(Record.ApprovedAtUtc)}; first published {Moment.Full(Record.FirstPublishedAtUtc)}"));
            facts.Add(new("Revision", Record.RevisionNumber.ToString(System.Globalization.CultureInfo.InvariantCulture)));
            return facts;
        }
    }
}
