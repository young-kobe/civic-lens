@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.AllRecords" CanonicalPath="@PublicationProtocol.RecordPagePath(Withdrawal.RecordId)" Title="@Title" Description="A person withdrew this record. Its content is no longer published." RootPath="../" UsesRecordFont="true" NoIndex="true">
    <RecordView HeadingLevel="1" Headline="This record was withdrawn"
                Summary="A person withdrew this record. Its content is no longer published."
                Facts="PublishedWithdrawalView.Facts(Withdrawal)" />
    <PublishedCorrectionList Corrections="Withdrawal.Corrections" />
</PublicPage>

@code {

    private string Title => $"Withdrawn {PublishedRecordLabels.Kind(Withdrawal.Kind).ToLowerInvariant()}: {Withdrawal.RecordId[..12]}";

    [Parameter, EditorRequired] public PublishedWithdrawal Withdrawal { get; set; } = default!;
}
