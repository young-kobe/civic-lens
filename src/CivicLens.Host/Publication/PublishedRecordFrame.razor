@using CivicLens.Host.Components.Layout
@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.AllRecords" Title="@Headline" Description="@(string.IsNullOrWhiteSpace(Summary) ? Headline : Summary)" IsArticle="true" RootPath="../" Crumbs="Crumbs">
    <RecordView HeadingLevel="1" Headline="@Headline" Summary="@Summary" Significance="@Significance"
                Limits="@Limits" Facts="Facts" />
    <PublishedCorrectionList Corrections="Corrections" />
    @ChildContent
    <Caveat>@Caveat</Caveat>
    <p class="muted small"><a href="@("../" + PublicationProtocol.ReportPageLink(RecordId, RevisionNumber))">Report a problem with this record</a></p>
</PublicPage>

@code {
    private IReadOnlyList<Crumb> Crumbs => [PublicCrumbs.Home("../"), PublicCrumbs.AllRecords("../"), new(Headline)];

    [Parameter, EditorRequired] public string RecordId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int RevisionNumber { get; set; }
    [Parameter, EditorRequired] public string Headline { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Summary { get; set; } = string.Empty;
    [Parameter] public string? Significance { get; set; }
    [Parameter] public string? Limits { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<Fact> Facts { get; set; } = [];
    [Parameter, EditorRequired] public string Caveat { get; set; } = string.Empty;
    [Parameter] public PublishedCorrection[] Corrections { get; set; } = [];
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
