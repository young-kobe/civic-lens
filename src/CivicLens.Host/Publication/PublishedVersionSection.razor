@using CivicLens.Host.Pages
@using CivicLens.Publication.Contracts
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering

<details class="public-version" open>
    <summary>@Heading</summary>
    <div class="public-version-body">
        <p>Observed @PublishedRecordView.Moment(Version.ObservedAtUtc). Source: <a href="@Version.Url" rel="noopener noreferrer nofollow">@Version.Url</a></p>
        <pre class="public-text">@foreach (var run in Runs) { @Run(run, 0) }</pre>
    </div>
</details>

@code {
    [Parameter, EditorRequired] public string Heading { get; set; } = string.Empty;
    [Parameter, EditorRequired] public PublishedDocumentVersion Version { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<TextRun> Runs { get; set; } = default!;

    private static RenderFragment Run(TextRun run, int depth) => builder =>
    {
        if (depth == run.Marks.Count)
        {
            builder.AddContent(0, EncodedEvidence.Markup(run.Text));
            return;
        }
        var mark = run.Marks[depth];
        builder.OpenElement(1, "mark");
        if (mark.CarriesAnchor) builder.AddAttribute(2, "id", mark.AnchorId);
        builder.AddContent(3, Run(run, depth + 1));
        builder.CloseElement();
    };
}
