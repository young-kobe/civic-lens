<div class="theme-menu" hidden>
    <button class="theme-menu-button" type="button" popovertarget="theme-menu"><Icon Name="IconName.Theme" /><span class="visually-hidden">Theme</span></button>
    <div class="theme-menu-list" id="theme-menu" popover>
        <button type="button" data-theme-choice="light" aria-pressed="false"><Icon Name="IconName.Light" />Light</button>
        <button type="button" data-theme-choice="" aria-pressed="true"><Icon Name="IconName.System" />Match system</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false"><Icon Name="IconName.Dark" />Dark</button>
    </div>
</div>
