@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

@if (Issues.Any(issue => issue.HasPages))
{
    <section class="home-section" id="issues" aria-labelledby="home-issues-title">
        <h2 id="home-issues-title">Start with an issue</h2>
        <p class="home-section-lede">See the votes and bills on what matters to you, and who led them.</p>
        <ul class="issue-tiles" role="list">
            @foreach (var issue in Issues.Where(issue => issue.HasPages))
            {
                <li><a class="issue-tile" href="@issue.PagePath(1)"><IssueIcon Name="@issue.Icon" />@issue.Name</a></li>
            }
        </ul>
    </section>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ReleaseFacet> Issues { get; set; } = [];
}
