@using CivicLens.Publication.Contracts

<PublishedRecordFrame Kind="PublishedRecordKind.Brief" Section="null" Corrections="Record.Corrections" RecordId="@Record.RecordId" RevisionNumber="@Record.RevisionNumber" ShortName="@PublishedBriefView.ShortName(Record.WeekStart)" Headline="@Record.Headline" Summary="" Facts="PublishedBriefView.Facts(Record)"
                      Caveat="@PublishedBriefView.Sample(Record)">
    <PublishedTimeline Events="PublishedTimelineView.For(Record)" />

    <Panel Title="Brief" Id="brief-title" Padded="true">
        <PublishedBriefText Paragraphs="Record.Paragraphs" />
    </Panel>

    <Panel Title="@PublishedBriefView.CitedRecordsTitle" Id="citations-title" Padded="true">
        <PublishedBriefCitations Citations="Record.Citations" RecordHref="PublishedRecordView.RecordLink" />
    </Panel>
</PublishedRecordFrame>

@code {
    [Parameter, EditorRequired] public PublishedBrief Record { get; set; } = default!;
}
