@using CivicLens.Publication.Contracts

<PublishedRecordFrame Headline="@Record.Headline" Summary="" Facts="PublishedBriefView.Facts(Record)"
                      Caveat="@PublishedBriefView.Sample(Record)">
    <Panel Title="Brief" Id="brief-title" Padded="true">
        @foreach (var paragraph in Record.Paragraphs)
        {
            <p class="record-body">
                @paragraph.Text
                @foreach (var id in paragraph.CitationIds)
                {
                    <a class="small" href="@("#" + PublishedBriefView.CitationAnchor(id))">[@id]</a>
                }
            </p>
        }
    </Panel>

    <Panel Title="Cited records" Id="citations-title" Padded="true">
        <ul class="choices">
            @foreach (var citation in Record.Citations)
            {
                <li id="@PublishedBriefView.CitationAnchor(citation.Id)">
                    <span class="choice-label">@citation.Id</span>
                    <a href="@PublishedBriefView.RecordLink(citation)">@citation.Headline</a>
                    <span class="muted small">@PublishedRecordLabels.Kind(citation.Kind), revision @citation.RevisionNumber</span>
                </li>
            }
        </ul>
    </Panel>
</PublishedRecordFrame>

@code {
    [Parameter, EditorRequired] public PublishedBrief Record { get; set; } = default!;
}
