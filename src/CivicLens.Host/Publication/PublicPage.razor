@using CivicLens.Application.Publication
@using CivicLens.Host.Components.Layout
@using CivicLens.Publication.Contracts
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@documentTitle</title>
    <meta name="description" content="@description" />
    <meta property="og:title" content="@documentTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="@(IsArticle ? "article" : "website")" />
    <meta property="og:site_name" content="@PublicHead.SiteName" />
    @if (canonicalUrl is not null)
    {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:url" content="@canonicalUrl" />
    }
    @if (NoIndex)
    {
        <meta name="robots" content="noindex" />
    }
    <link rel="icon" type="image/svg+xml" href="@(RootPath + PublicAssets.Favicon)" />
    <link rel="preload" href="@(RootPath + PublicAssets.InstrumentSansFont)" as="font" type="font/woff2" crossorigin />
    @if (UsesRecordFont)
    {
        <link rel="preload" href="@(RootPath + PublicAssets.NewsreaderFont)" as="font" type="font/woff2" crossorigin />
    }
    @foreach (var stylesheet in PublicAssets.Stylesheets)
    {
        <link rel="stylesheet" href="@(RootPath + stylesheet)" />
    }
    <script src="@(RootPath + PublicAssets.ThemeScript)"></script>
    <script src="@(RootPath + PublicAssets.Script)" defer></script>
    <script src="@(RootPath + PublicAssets.PublicScript)" defer></script>
    @if (ExternalScript is not null)
    {
        <script src="@ExternalScript" async defer></script>
    }
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="public-header">
        <a class="public-brand" href="@(RootPath + PublicationProtocol.HomePath)"><BrandMark />Civic Lens</a>
        <nav class="public-nav" aria-label="Site">
            @foreach (var link in SectionLinks)
            {
                <a href="@(RootPath + link.Path)" aria-current="@(link.Section == Section ? "page" : null)">@link.Label</a>
            }
        </nav>
        <div class="topbar-tools"><ThemeToggle /></div>
    </header>
    <main class="public-main" id="main" tabindex="-1"><div class="content"><PublicBreadcrumb Crumbs="Crumbs" />@ChildContent</div></main>
    <footer class="public-footer">
        <p>Each record shows its sources and the exact text it cites.</p>
        <nav class="public-footer-nav" aria-label="Footer">
            <a href="@(RootPath + PublicationProtocol.MethodPagePath)">Method</a>
            <a href="@(RootPath + PublicationProtocol.ReportPagePath)">Report a problem</a>
        </nav>
    </footer>
</body>
</html>

@code {
    private static readonly (PublicSection Section, string Label, string Path)[] SectionLinks =
    [
        (PublicSection.Officials, "Officials", PublicationProtocol.OfficialsPagePath),
        (PublicSection.Issues, "Issues", PublicationProtocol.FacetsPath),
        (PublicSection.AllRecords, "All records", PublicationProtocol.AllRecordsPagePath(1)),
        (PublicSection.Search, "Search", PublicationProtocol.SearchPagePath)
    ];

    private string documentTitle = string.Empty;
    private string description = string.Empty;
    private string? canonicalUrl;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageCount { get; set; } = 1;
    [Parameter] public PublicSection? Section { get; set; }
    [Parameter] public bool IsArticle { get; set; }
    [Parameter] public bool UsesRecordFont { get; set; }
    [Parameter] public bool NoIndex { get; set; }
    [Parameter, EditorRequired] public string? CanonicalPath { get; set; }
    [Parameter] public string? ExternalScript { get; set; }
    [Parameter] public string RootPath { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<Crumb> Crumbs { get; set; } = [];
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Inject] private IServiceProvider Services { get; set; } = default!;

    protected override void OnParametersSet()
    {
        documentTitle = PublicHead.DocumentTitle(Title, Page, PageCount);
        description = PublicHead.Description(Description);
        canonicalUrl = CanonicalPath is null ? null : Services.GetService<PublicBaseUrl>()?.Join(CanonicalPath);
    }
}
