@using CivicLens.Application.Publication
@using CivicLens.Core.Relationships
@using CivicLens.Publication.Contracts

<PublicPage Title="@Title" Description="@Description" RootPath="@Page.RootPath">
    @if (Page.IsCurrent)
    {
        <a class="back-link" href="@(Page.RootPath + PublicationProtocol.OfficialsPagePath)">Officials</a>
    }
    else
    {
        <a class="back-link" href="@(Page.RootPath + PublicationProtocol.OfficialPagePath(Page.Profile.Id))">@Page.Profile.Name</a>
    }
    <PageHeader Title="@Page.Profile.Name" Lede="@Lede" />
    @if (Page.IsCurrent)
    {
        <Panel Title="Offices">
            <DataTable Items="Page.Profile.Terms" Caption="@($"Offices of {Page.Profile.Name}")">
                <Head><th>Office</th><th>Party</th><th class="fit num">From</th><th class="fit num">To</th></Head>
                <Row Context="term">
                    <td>@PublishedOfficialView.Office(term)</td>
                    <td>@term.Party</td>
                    <td class="fit num">@Moment.Iso(term.Start)</td>
                    <td class="fit num">@(term.End is { } end ? Moment.Iso(end) : "Present")</td>
                </Row>
                <Empty><EmptyState Title="No office on record" Text="@NoOfficeText" /></Empty>
            </DataTable>
        </Panel>
    }
    @if (Page.TalkAndAction is { } profile)
    {
        <Panel Title="@($"Talk and action in Congress {Page.Congress}")">
            <DataTable Items="profile.IssueIds" Caption="@($"Share of statements, sponsorships, and votes of {Page.Profile.Name} on each issue")">
                <Head><th>Issue</th><th class="num">Statements</th><th class="num">Sponsorships</th><th class="num">Votes</th></Head>
                <Row Context="issueId">
                    <td>@issueId</td>
                    <td class="num">@PublishedOfficialView.Share(profile.Statements, issueId)</td>
                    <td class="num">@PublishedOfficialView.Share(profile.Sponsorships, issueId)</td>
                    <td class="num">@PublishedOfficialView.Share(profile.Votes, issueId)</td>
                </Row>
                <Empty><EmptyState Title="No tracked issue" Text="No statement, sponsorship, or substantive vote of this Congress has a tracked issue." /></Empty>
            </DataTable>
            <p class="muted small">
                Records with no tracked issue: @profile.Statements.WithoutIssue statements, @profile.Sponsorships.WithoutIssue sponsorships,
                @profile.Votes.WithoutIssue votes. Substantive roll calls marked Not Voting: @profile.NotVotingRolls. Procedural votes left out: @profile.ProceduralVotes.
                <a href="@(Page.RootPath + PublicationProtocol.MethodPagePath)">How the profile works</a>
            </p>
        </Panel>
    }
    <Panel Title="Records">
        <DataTable Items="Rows" Caption="@($"Published records of {Page.Profile.Name}")">
            <Head><th class="fit num">Date</th><th>Record</th><th class="hide-narrow">Cast</th></Head>
            <Row Context="row">
                <td class="fit num">@Moment.Iso(row.Date)</td>
                <td>
                    <a class="cell-title" href="@(Page.RootPath + PublicationProtocol.RecordPagePath(row.RecordId))">@row.Headline</a>
                    <StatusBadge Text="@PublishedRecordLabels.Kind(row.Kind)" />
                    @if (row.Detail is not null)
                    {
                        <div class="muted small">@row.Detail</div>
                    }
                </td>
                <td class="hide-narrow">@row.Cast</td>
            </Row>
            <Empty><EmptyState Title="No records yet" Text="There are no records here." /></Empty>
        </DataTable>
    </Panel>
    @if (!Page.PastCongresses.IsEmpty)
    {
        <Panel Title="Earlier Congresses" Padded="true">
            <ul class="choices">
                @foreach (var congress in Page.PastCongresses)
                {
                    <li><a href="@(Page.RootPath + PublicationProtocol.OfficialCongressPagePath(Page.Profile.Id, congress))">Votes in Congress @congress</a></li>
                }
            </ul>
        </Panel>
    }
</PublicPage>

@code {
    [Parameter, EditorRequired] public ReleaseOfficialPage Page { get; set; } = default!;

    private string NoOfficeText => Page.IsTracked
        ? "The rosters and the configuration list no dated office for this official."
        : "Civic Lens no longer tracks this official, so it lists no office. The records below stay published.";

    private IReadOnlyList<PublishedOfficialRow> Rows => PublishedOfficialView.Rows(Page);

    private string Title => Page.IsCurrent ? Page.Profile.Name : $"{Page.Profile.Name}, Congress {Page.Congress}";

    private string Description => OfficeInPage() is { } term
        ? $"{Page.Profile.Name}, {PublishedOfficialView.Office(term)}. {Lede}"
        : $"{Page.Profile.Name}. {Lede}";

    private PublishedOfficeTerm? OfficeInPage() =>
        Page.Profile.Terms.OrderBy(term => term.Start).LastOrDefault(term => Page.Congress is not { } congress || HeldIn(term, congress));

    private static bool HeldIn(PublishedOfficeTerm term, int congress) =>
        term.Start < CongressCalendar.StartOf(congress + 1) && (term.End is not { } end || end > CongressCalendar.StartOf(congress));

    private string Lede => Page.IsCurrent
        ? Page.Congress is { } congress
            ? $"{Page.Records.Length} records name this official. The votes are those of Congress {congress}. Rows are newest first."
            : $"{Page.Records.Length} records name this official. Rows are newest first."
        : $"Votes in Congress {Page.Congress}, newest first.";
}
