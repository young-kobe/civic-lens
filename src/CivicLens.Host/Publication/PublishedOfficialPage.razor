@using CivicLens.Application.Publication
@using CivicLens.Core.Relationships
@using CivicLens.Host.Components.Layout
@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.Officials" CanonicalPath="@Page.PagePath" Title="@Title" Description="@Description" RootPath="@Page.RootPath" Crumbs="Crumbs">
    <PageHeader Title="@Page.Profile.Name" Lede="@Lede" />
    @if (Page.IsCurrent)
    {
        <OfficialPortrait Profile="Page.Profile" RootPath="@Page.RootPath" />
        @if (Page.Profile.Website is { } website)
        {
            <p><a href="@website" rel="noopener noreferrer">Official website (@PublishedOfficialView.WebsiteHost(website))</a></p>
        }
        <Panel Title="Offices">
            <DataTable Roles="true" Items="Page.Profile.Terms" Caption="@($"Offices of {Page.Profile.Name}")">
                <Head><TableCell Header>Office</TableCell><TableCell Header>@PublicColumn.Party</TableCell><TableCell Header Class="fit num">@PublicColumn.From</TableCell><TableCell Header Class="fit num">@PublicColumn.To</TableCell></Head>
                <Row Context="term">
                    <TableCell Main>@PublishedOfficialView.Office(term)</TableCell>
                    <TableCell Label="@PublicColumn.Party">@term.Party</TableCell>
                    <TableCell Class="fit num" Label="@PublicColumn.From">@Moment.Iso(term.Start)</TableCell>
                    <TableCell Class="fit num" Label="@PublicColumn.To">@(term.End is { } end ? Moment.Iso(end) : "Present")</TableCell>
                </Row>
                <Empty><EmptyState Title="No office on record" Text="@NoOfficeText" /></Empty>
            </DataTable>
        </Panel>
    }
    @if (Page.TalkAndAction is { } profile)
    {
        <Panel Title="Issues they work on">
            <DataTable Roles="true" Items="profile.IssueIds" Caption="@($"Statements, sponsored bills, and votes of {Page.Profile.Name} on each tracked issue in Congress {Page.Congress}")">
                <Head><TableCell Header>Issue</TableCell><TableCell Header Class="num">@PublicColumn.TheirStatements</TableCell><TableCell Header>@PublicColumn.BillsTheySponsored</TableCell><TableCell Header Class="num">@PublicColumn.VotesTheyCast</TableCell></Head>
                <Row Context="issueId">
                    @{
                        var issue = PublishedRecordView.IssueLink(issueId, Catalog, Page.RootPath);
                        var bills = profile.SponsoredOn(issueId);
                    }
                    <TableCell Main>
                        @if (issue.Href is not null)
                        {
                            <a class="cell-title" href="@issue.Href">@issue.Text</a>
                        }
                        else
                        {
                            <span class="cell-title">@issue.Text</span>
                        }
                    </TableCell>
                    <TableCell Class="num" Label="@PublicColumn.TheirStatements"><CountFilter Count="profile.Statements.CountOf(issueId)" Key="@TalkAndActionProfile.CountKey(TalkAndActionProfile.StatementCount, issueId)"
                        Label="@PublishedOfficialView.CountFilterLabel(profile.Statements.CountOf(issueId), PublishedOfficialView.StatementsSubject, issue.Text)"
                        Notice="@PublishedOfficialView.CountFilterNotice(PublishedOfficialView.StatementsSubject, issue.Text, Page.Congress!.Value, profile.Statements.CountOf(issueId))" /></TableCell>
                    <TableCell Label="@PublicColumn.BillsTheySponsored">
                        <CountFilter Count="bills.Length" Key="@TalkAndActionProfile.CountKey(TalkAndActionProfile.BillCount, issueId)"
                            Label="@PublishedOfficialView.CountFilterLabel(bills.Length, PublishedOfficialView.BillsSubject, issue.Text)"
                            Notice="@PublishedOfficialView.CountFilterNotice(PublishedOfficialView.BillsSubject, issue.Text, Page.Congress!.Value, bills.Length)" />
                        @if (!bills.IsEmpty)
                        {
                            <ul class="choices">
                                @foreach (var bill in bills)
                                {
                                    <li><a href="@(Page.RootPath + PublicationProtocol.RecordPagePath(bill.RecordId))">@bill.BillTitle</a></li>
                                }
                            </ul>
                        }
                    </TableCell>
                    <TableCell Class="num" Label="@PublicColumn.VotesTheyCast"><CountFilter Count="profile.Votes.CountOf(issueId)" Key="@TalkAndActionProfile.CountKey(TalkAndActionProfile.VoteCount, issueId)"
                        Label="@PublishedOfficialView.CountFilterLabel(profile.Votes.CountOf(issueId), PublishedOfficialView.VotesSubject, issue.Text)"
                        Notice="@PublishedOfficialView.CountFilterNotice(PublishedOfficialView.VotesSubject, issue.Text, Page.Congress!.Value, profile.Votes.CountOf(issueId))" /></TableCell>
                </Row>
                <Empty><EmptyState Title="No tracked issue" Text="None of their statements, sponsored bills, or votes in this Congress is on a tracked issue." /></Empty>
            </DataTable>
            <p class="muted small">Each count is for this Congress. "Votes they cast" counts only substantive votes. A statement, bill, or vote on several issues counts once for each issue. <a href="@(Page.RootPath + PublicationProtocol.MethodPagePath)">How these counts work</a></p>
        </Panel>
        <Panel Title="@($"Missed votes in Congress {Page.Congress}")" Padded="true">
            @foreach (var missed in profile.MissedByChamber)
            {
                <p>@PublishedOfficialView.MissedVotes(missed, Page.Congress!.Value)</p>
            }
            <p class="muted small">@PublishedOfficialView.MissedVoteMeaning</p>
        </Panel>
        <Panel Title="What they said and what they did" Padded="true">
            <p class="muted small">@PublishedOfficialView.LinkMeaning <a href="@(Page.RootPath + PublicationProtocol.MethodPagePath)">What a link is</a></p>
            @if (Page.Pairs.IsDefaultOrEmpty)
            {
                <p>@PublishedOfficialView.NoLinks</p>
            }
            else
            {
                <DataTable Roles="true" Items="Page.Pairs" Caption="@($"Reviewed links between statements of {Page.Profile.Name} and their bills or votes")">
                    <Head><TableCell Header Class="fit num">@PublicColumn.StatementDate</TableCell><TableCell Header>@PublicColumn.WhatTheySaid</TableCell><TableCell Header>@PublicColumn.Link</TableCell><TableCell Header>@PublicColumn.WhatTheyDid</TableCell><TableCell Header>@PublicColumn.TheirVote</TableCell></Head>
                    <Row Context="pair">
                        <TableCell Class="fit num" Label="@PublicColumn.StatementDate">@PublishedOfficialView.StatementDay(pair)</TableCell>
                        <TableCell Main><a class="cell-title" href="@(Page.RootPath + PublicationProtocol.RecordPagePath(pair.StatementRecordId))">@pair.StatementHeadline</a></TableCell>
                        <TableCell Label="@PublicColumn.Link">@PublishedRecordLabels.RelationshipType(pair.Type)</TableCell>
                        <TableCell Label="@PublicColumn.WhatTheyDid"><a href="@(Page.RootPath + PublicationProtocol.RecordPagePath(pair.TargetRecordId))">@pair.TargetTitle</a></TableCell>
                        <TableCell Label="@PublicColumn.TheirVote">@PublishedOfficialView.TheirVote(pair)</TableCell>
                    </Row>
                </DataTable>
            }
        </Panel>
        @if (!profile.WithPartyByChamber.IsEmpty)
        {
            <Panel Title="Votes with their party" Padded="true">
                @foreach (var withParty in profile.WithPartyByChamber)
                {
                    <p>@PublishedOfficialView.WithParty(withParty, Page.Congress!.Value)</p>
                }
                <p class="muted small">@PublishedOfficialView.SplitVoteMeaning</p>
                @if (profile.WithPartyByChamber.Any(withParty => withParty.Cast > 0) && profile.WithPartyByChamber.All(withParty => withParty.Breaks.IsEmpty))
                {
                    <p>No votes against most of their party.</p>
                }
                @foreach (var withParty in profile.WithPartyByChamber.Where(withParty => !withParty.Breaks.IsEmpty))
                {
                    <DataTable Roles="true" Items="withParty.Breaks" Caption="@($"Votes of {Page.Profile.Name} against most {PublishedOfficialView.PartyOf(withParty)}")">
                        <Head><TableCell Header Class="fit num">@PublicColumn.Date</TableCell><TableCell Header>@PublicColumn.Vote</TableCell><TableCell Header>@PublicColumn.TheirVote</TableCell><TableCell Header>Most @PublishedOfficialView.PartyOf(withParty)</TableCell><TableCell Header>@PublicColumn.Result</TableCell></Head>
                        <Row Context="vote">
                            <TableCell Class="fit num" Label="@PublicColumn.Date">@Moment.Iso(vote.VotedOn)</TableCell>
                            <TableCell Main><a class="cell-title" href="@(Page.RootPath + PublicationProtocol.RecordPagePath(vote.RecordId))">@vote.Headline</a></TableCell>
                            <TableCell Label="@PublicColumn.TheirVote">@vote.Cast</TableCell>
                            <TableCell Label="@($"Most {PublishedOfficialView.PartyOf(withParty)}")">@vote.PartyMajority</TableCell>
                            <TableCell Label="@PublicColumn.Result">@vote.Result</TableCell>
                        </Row>
                    </DataTable>
                }
            </Panel>
        }
    }
    <Panel Title="Records" Aside="@RecordFilter" data-layout="@(RecordFilter is null ? null : PublishedOfficialView.RecordFilters[0].Value)" data-records="@(Page.TalkAndAction is null ? null : "")">
        @if (Page.TalkAndAction is not null)
        {
            <div class="visually-hidden" role="status" data-filter-status></div>
            <div class="notice" data-filter-notice hidden>
                <span data-filter-text></span>
                <button class="btn" type="button" data-filter-clear>@PublishedOfficialView.ShowAllRecords</button>
            </div>
        }
        <DataTable Roles="true" Items="Rows" RowClass="@(row => row.AgainstParty ? "against-party" : null)" RowFilterKeys="@(row => row.FilterKeys)" Caption="@($"Published records of {Page.Profile.Name}")">
            <Head><TableCell Header Class="fit num">@PublicColumn.Date</TableCell><TableCell Header>Record</TableCell><TableCell Header>@PublicColumn.Cast</TableCell></Head>
            <Row Context="row">
                <TableCell Class="fit num" Label="@PublicColumn.Date">@Moment.Iso(row.Date)</TableCell>
                <TableCell Main>
                    <a class="cell-title" href="@(Page.RootPath + PublicationProtocol.RecordPagePath(row.RecordId))">@row.Headline</a>
                    <StatusBadge Text="@PublishedRecordLabels.Kind(row.Kind)" />
                    @if (row.Detail is not null)
                    {
                        <div class="muted small">@row.Detail</div>
                    }
                </TableCell>
                <TableCell Label="@PublicColumn.Cast">@row.Cast</TableCell>
            </Row>
            <Empty><EmptyState Title="No records yet" Text="There are no records here." /></Empty>
        </DataTable>
    </Panel>
    @if (!Page.PastCongresses.IsEmpty)
    {
        <Panel Title="Earlier Congresses" Padded="true">
            <ul class="choices">
                @foreach (var congress in Page.PastCongresses)
                {
                    <li><a href="@(Page.RootPath + PublicationProtocol.OfficialCongressPagePath(Page.Profile.Id, congress))">Votes in Congress @congress</a></li>
                }
            </ul>
        </Panel>
    }
</PublicPage>

@code {
    [Parameter, EditorRequired] public ReleaseOfficialPage Page { get; set; } = default!;
    [Parameter, EditorRequired] public PublicationCatalog Catalog { get; set; } = default!;

    private IReadOnlyList<Crumb> Crumbs => Page.IsCurrent
        ? [PublicCrumbs.Home(Page.RootPath), PublicCrumbs.Officials(Page.RootPath), new(Page.Profile.Name)]
        : [PublicCrumbs.Home(Page.RootPath), PublicCrumbs.Officials(Page.RootPath),
            new(Page.Profile.Name, Page.RootPath + PublicationProtocol.OfficialPagePath(Page.Profile.Id)), new(Title)];

    private string NoOfficeText => Page.IsTracked
        ? "The rosters and the configuration list no dated office for this official."
        : "Civic Lens no longer tracks this official, so it lists no office. The records below stay published.";

    private RenderFragment? RecordFilter => Page.TalkAndAction is not null && Rows.Any(row => row.AgainstParty)
        ? @<LayoutSwitch Label="Show records" Choices="PublishedOfficialView.RecordFilters" />
        : null;

    private IReadOnlyList<PublishedOfficialRow>? rows;

    private IReadOnlyList<PublishedOfficialRow> Rows => rows ??= PublishedOfficialView.Rows(Page);

    private string Title => Page.IsCurrent ? Page.Profile.Name : $"{Page.Profile.Name}, Congress {Page.Congress}";

    private string Description => OfficeInPage() is { } term
        ? $"{Page.Profile.Name}, {PublishedOfficialView.Office(term)}. {Lede}"
        : $"{Page.Profile.Name}. {Lede}";

    private PublishedOfficeTerm? OfficeInPage() =>
        PublishedOfficialView.LatestTerm(Page.Profile.Terms.Where(term => Page.Congress is not { } congress || HeldIn(term, congress)));

    private static bool HeldIn(PublishedOfficeTerm term, int congress) =>
        term.Start < CongressCalendar.StartOf(congress + 1) && (term.End is not { } end || end > CongressCalendar.StartOf(congress));

    private string Lede => Page.IsCurrent
        ? Page.Congress is { } congress
            ? $"{Page.Records.Length} records name this official. The votes are those of Congress {congress}. Rows are newest first."
            : $"{Page.Records.Length} records name this official. Rows are newest first."
        : $"Votes in Congress {Page.Congress}, newest first.";
}
