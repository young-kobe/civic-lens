@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.Officials" CanonicalPath="@Page.PagePath" Title="@Title" Description="@Description" RootPath="@Page.RootPath">
    <Hero>
        <div class="official-hero"><PageHeader Title="@Page.Profile.Name" Lede="@Lede" Portrait="Portrait" Meta="Introduction" /></div>
    </Hero>
    <ChildContent>
        @if (Page.Congresses.Length > 1)
        {
            <FilterTabs Label="@PublishedOfficialView.CongressTabsLabel(Page)" Tabs="PublishedOfficialView.CongressTabs(Page)" />
        }
        @if (Page.TalkAndAction is { } profile)
        {
            <PublishedKeyFigures Label="@PublishedKeyFigure.SectionLabel(TalkAndActionCongress)" Figures="PublishedKeyFigure.Of(profile, TalkAndActionCongress)" />
        }
        @if (Page.IsCurrent)
        {
            <nav class="jump-links" aria-label="@PublishedOfficialSectionsView.JumpLabel">
                @foreach (var section in Sections)
                {
                    <a href="@($"#{section.Id}")">@section.Title</a>
                }
            </nav>
        }
        <PublishedVoteStrip Votes="Page.Votes" />
        @if (Page.IsCurrent)
        {
            <PublishedOfficialSections Page="Page" Catalog="Catalog" Sections="Sections" />
            @if (Rows.Count > 0)
            {
                <p class="see-all"><a href="@PublishedOfficialSectionsView.RecordPageLink(Page)">@PublishedOfficialSectionsView.AllRecordsText(Rows.Count)</a></p>
            }
        }
        else
        {
            <PublishedRecordList Page="Page" Catalog="Catalog" RootPath="@Page.RootPath" />
        }
        @if (Page.TalkAndAction is not null)
        {
            <Panel Title="What they said and what they did" Padded="true">
                <p class="muted small">@OfficialPageText.LinkMeaning <a href="@(Page.RootPath + PublicationProtocol.MethodPagePath)">What a link is</a></p>
                @if (Page.Pairs.IsDefaultOrEmpty)
                {
                    <p>@OfficialPageText.NoLinks</p>
                }
                else
                {
                    <DataTable Roles="true" PagedRows="links" Items="Page.Pairs" Caption="@($"Reviewed links between statements of {Page.Profile.Name} and their bills or votes")" DefaultOrder="@PublishedRecordLabels.NewestFirst">
                        <Head><TableCell Header Class="fit num" Sort="SortKind.Date">@PublicColumn.StatementDate</TableCell><TableCell Header Sort="SortKind.Text">@PublicColumn.WhatTheySaid</TableCell><TableCell Header Sort="SortKind.Text">@PublicColumn.Link</TableCell><TableCell Header Sort="SortKind.Text">@PublicColumn.WhatTheyDid</TableCell><TableCell Header Sort="SortKind.Text">@PublicColumn.TheirVote</TableCell></Head>
                        <Row Context="pair">
                            <TableCell Class="fit num" Label="@PublicColumn.StatementDate" SortValue="@(pair.StatementDay is { } day ? Moment.Iso(day) : "")">@PublishedOfficialView.StatementDay(pair)</TableCell>
                            <TableCell Main><PublishedRecordTitle RecordId="@pair.StatementRecordId" RootPath="@Page.RootPath">@pair.StatementHeadline</PublishedRecordTitle></TableCell>
                            <TableCell Label="@PublicColumn.Link">@PublishedRecordLabels.RelationshipType(pair.Type)</TableCell>
                            <TableCell Label="@PublicColumn.WhatTheyDid"><a href="@(Page.RootPath + PublicationProtocol.RecordPagePath(pair.TargetRecordId))">@pair.TargetTitle</a></TableCell>
                            <TableCell Label="@PublicColumn.TheirVote">@PublishedOfficialView.TheirVote(pair)</TableCell>
                        </Row>
                    </DataTable>
                }
            </Panel>
        }
        @if (Page.IsCurrent)
        {
            <Panel Title="Offices">
                <DataTable Roles="true" Items="OfficeStretches" Caption="@($"Offices of {Page.Profile.Name}")" DefaultOrder="@PublishedRecordLabels.DefaultOrder">
                    <Head><TableCell Header Sort="SortKind.Text">Office</TableCell>@if (HasParty){<TableCell Header Sort="SortKind.Text">@PublicColumn.Party</TableCell>}<TableCell Header Class="fit num" Sort="SortKind.Date">@PublicColumn.From</TableCell><TableCell Header Class="fit num">@PublicColumn.To</TableCell></Head>
                    <Row Context="stretch">
                        <TableCell Main>@PublishedOfficialView.Office(stretch.Latest)</TableCell>
                        @if (HasParty)
                        {
                            <TableCell Label="@PublicColumn.Party">@stretch.Latest.Party</TableCell>
                        }
                        <TableCell Class="fit num" Label="@PublicColumn.From" SortValue="@Moment.Iso(stretch.Start)">@Moment.Day(stretch.Start)</TableCell>
                        <TableCell Class="fit num" Label="@PublicColumn.To">@(stretch.End is { } end ? Moment.Day(end) : "Present")</TableCell>
                    </Row>
                    <Empty><EmptyState Title="No office on record" Text="@NoOfficeText" /></Empty>
                </DataTable>
                @if (OfficeStretches.Count > 0)
                {
                    <p class="muted small panel-note">@PublishedOfficialView.OfficeStretchNote(Page.Profile.Terms)</p>
                }
            </Panel>
        }
    </ChildContent>
</PublicPage>

@code {
    [Parameter, EditorRequired] public ReleaseOfficialPage Page { get; set; } = default!;
    [Parameter, EditorRequired] public PublicationCatalog Catalog { get; set; } = default!;

    private RenderFragment? Portrait => Page.IsCurrent
        ? @<OfficialPortrait Name="@Page.Profile.Name" PhotoPath="@Page.Profile.Photo?.Path" PhotoWidth="@Page.Profile.Photo?.Width" PhotoHeight="@Page.Profile.Photo?.Height" PhotoCredit="@Page.Profile.Photo?.Credit" RootPath="@Page.RootPath" />
        : null;

    private RenderFragment? Introduction => Page.IsCurrent && (Tenure is not null || Page.Profile.Website is not null)
        ? @<text>
            @if (Tenure is not null)
            {
                <span>@Tenure</span>
            }
            @if (Page.Profile.Website is { } website)
            {
                <a href="@website" rel="noopener noreferrer">Official website</a>
                <span class="muted small">@PublishedWebsite.Host(website)</span>
            }
        </text>
        : null;

    private string? Tenure => PublishedOfficialView.Tenure(Page.Profile.Terms, Page.PublishedAtUtc);

    private int TalkAndActionCongress => Page.Congress!.Value;

    private string NoOfficeText => Page.IsTracked
        ? "The rosters and the configuration list no dated office for this official."
        : "Civic Lens no longer tracks this official, so it lists no office. The records on this page stay published.";

    private IReadOnlyList<PublishedOfficialRow> Rows => rows ??= PublishedOfficialView.Rows(Page);

    private IReadOnlyList<PublishedOfficialRow>? rows;

    private IReadOnlyList<OfficialSection> Sections => sections ??= PublishedOfficialSectionsView.Of(Page, Rows);

    private IReadOnlyList<OfficialSection>? sections;

    private IReadOnlyList<PublishedOfficeStretch> OfficeStretches => officeStretches ??= PublishedOfficialView.OfficeStretches(Page.Profile.Terms, Page.PublishedAtUtc);

    private IReadOnlyList<PublishedOfficeStretch>? officeStretches;

    private bool HasParty => Page.Profile.Terms.Any(term => term.Party is not null);

    private string Title => Page.IsCurrent ? Page.Profile.Name : $"{Page.Profile.Name}, {PublishedOfficialView.TheCongress(Page.Congress!.Value)}";

    private string Description => Page.IsCurrent
        ? string.Join(' ', new[] { $"{Page.Profile.Name}.", Lede is null ? null : $"{Lede}.", Tenure }.OfType<string>())
        : OfficeInPage() is { } term
            ? $"{Page.Profile.Name}, {PublishedOfficialView.Office(term)}. {Lede}"
            : $"{Page.Profile.Name}. {Lede}";

    private PublishedOfficeTerm? OfficeInPage() =>
        PublishedOfficialView.LatestTerm(Page.Profile.Terms.Where(term => HeldIn(term, Page.Congress!.Value)), Page.PublishedAtUtc);

    private static bool HeldIn(PublishedOfficeTerm term, int congress) =>
        term.Start < CongressCalendar.StartOf(congress + 1) && (term.End is not { } end || end > CongressCalendar.StartOf(congress));

    private string? Lede => Page.IsCurrent
        ? PublishedOfficialView.Lede(Page.Profile.Terms, Page.PublishedAtUtc)
        : $"Votes in {PublishedOfficialView.TheCongress(Page.Congress!.Value)}.";
}
