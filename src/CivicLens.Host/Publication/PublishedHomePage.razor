@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

<PublicPage CanonicalPath="" HasSearch="true" Title="@PublicHead.SiteName" Description="@HomeDescription" UsesRecordFont="@(Brief is not null)">
    <Hero>
        <div class="home-hero">
            <div>
                <h1>Who represents you?</h1>
                <p class="home-lead">See how your representative and senators voted and which bills they introduced. Each fact links to its official source.</p>
                <p class="home-browse">Or <a href="@PublicationProtocol.OfficialsPagePath">browse all @Highlights.OfficialCount officials</a></p>
            </div>
            <PublishedBreakCard Highlights="Highlights" PublishedAtUtc="Release.PublishedAtUtc" />
        </div>
    </Hero>
    <ChildContent>
        @if (Brief is not null)
        {
            <p class="muted small">Weekly brief</p>
            <Panel Title="@Brief.Headline" Padded="true">
                <PublishedBriefText Record="Brief" BriefHref="@PublicationProtocol.RecordPagePath(Brief.RecordId)" />
                <p><a href="@PublicationProtocol.RecordPagePath(Brief.RecordId)">Read the brief with its cited records</a></p>
                <p><a href="@PublicationProtocol.BriefsPagePath(1)">All weekly briefs</a></p>
            </Panel>
        }
        <PublishedHomeIssues Issues="Facets.Issues" />
        <PublishedHomeLatest Highlights="Highlights" />
    </ChildContent>
</PublicPage>

@code {
    [Parameter, EditorRequired] public PublicationRelease Release { get; set; } = default!;
    [Parameter] public PublishedBrief? Brief { get; set; }
    [Parameter, EditorRequired] public ReleaseFacets Facets { get; set; } = default!;
    [Parameter, EditorRequired] public HomeHighlights Highlights { get; set; } = default!;

    private string HomeDescription => Brief?.Headline
        ?? "Civic Lens collects what officials say and do, with the sources and the exact text that each record cites.";
}
