@using CivicLens.Host.Components.Evidence
@using CivicLens.Publication.Contracts

<PublishedRecordFrame Corrections="Record.Corrections" RecordId="@Record.RecordId" RevisionNumber="@Record.RevisionNumber" Headline="@Record.Headline" Summary="" Facts="PublishedExecutiveActionView.Facts(Record)"
                      Caveat="@PublishedExecutiveActionView.Caveat">
    <PublishedTimeline Events="PublishedTimelineView.For(Record)" />

    <Panel Title="Sources" Id="sources-title" Padded="true">
        <SourceLinesNote><Term Key="federal-register">Federal Register</Term> API record</SourceLinesNote>
        @for (var index = 0; index < Record.Sources.Length; index++)
        {
            var source = Record.Sources[index];
            <VersionSource Version="source" Linked="false" />
            <DocumentText Label="@($"Source text {index + 1} of {Record.Sources.Length}")" Runs="CitedText.Split(source.Text, PublishedExecutiveActionView.RangesIn(Record, source))" />
        }
    </Panel>
</PublishedRecordFrame>

@code {
    [Parameter, EditorRequired] public PublishedExecutiveAction Record { get; set; } = default!;
}
