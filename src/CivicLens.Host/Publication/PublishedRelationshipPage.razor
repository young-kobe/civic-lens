@using CivicLens.Host.Components.Evidence
@using CivicLens.Publication.Contracts

<PublishedRecordFrame Headline="@Record.Headline" Summary="@Record.Reason" Facts="PublishedRelationshipView.Facts(Record)"
                      Caveat="A person approved this link between a statement and a record. It states no verdict. It does not say that the statement is true or that it agrees with the record.">
    <Panel Title="Linked records" Id="linked-title" Padded="true">
        <p class="muted small">Each row names the revision that was approved with this link. Its page shows the revision that the release holds.</p>
        <ul class="choices">
            @foreach (var cited in new[] { Record.Statement, Record.Target })
            {
                <li>
                    <a href="@PublishedRecordView.RecordLink(cited.RecordId)">@cited.Headline</a>
                    <span class="muted small">@PublishedRecordLabels.Kind(cited.Kind), revision @cited.RevisionNumber</span>
                </li>
            }
        </ul>
    </Panel>

    <Panel Title="Evidence" Id="evidence-title" Padded="true">
        <ul class="choices">
            <li><CitationQuote Label="Quote from the statement" Quote="@Record.Quote" /></li>
            <li><CitationQuote Label="@($"Fact of the {PublishedRecordLabels.Kind(Record.Target.Kind).ToLowerInvariant()}")" Quote="@Record.TargetFact" /></li>
        </ul>
    </Panel>
</PublishedRecordFrame>

@code {
    [Parameter, EditorRequired] public PublishedRelationship Record { get; set; } = default!;
}
