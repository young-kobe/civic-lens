@using CivicLens.Host.Components.Evidence
@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

<PublishedRecordFrame Kind="PublishedRecordKind.Relationship" Corrections="Record.Corrections" RecordId="@Record.RecordId" RevisionNumber="@Record.RevisionNumber" Headline="@Record.Headline" Summary="@Record.Reason" Facts="PublishedRelationshipView.Facts(Record, Catalog)"
                      Caveat="@RelationshipPageView.Caveat">
    <PublishedTimeline Events="PublishedTimelineView.For(Record)" />

    <Panel Title="@RelationshipPageView.LinkedHeading" Id="linked-title" Padded="true">
        <p class="muted small">@RelationshipPageView.LinkedNote</p>
        <ul class="choices">
            @foreach (var cited in new[] { Record.Statement, Record.Target })
            {
                <li>
                    <a href="@PublishedRecordView.RecordLink(cited.RecordId)">@cited.Headline</a>
                    <span class="muted small">@RelationshipPageView.CitedRevision(cited.Kind, cited.RevisionNumber)</span>
                </li>
            }
        </ul>
    </Panel>

    <Panel Title="@RelationshipPageView.EvidenceHeading" Id="evidence-title" Padded="true">
        <ul class="choices">
            <li><CitationQuote Label="@RelationshipPageView.QuoteLabel" Quote="@Record.Quote" /></li>
            <li><CitationQuote Label="@RelationshipPageView.FactLabel(Record.Target.Kind)" Quote="@Record.TargetFact" /></li>
        </ul>
    </Panel>
</PublishedRecordFrame>

@code {
    [Parameter, EditorRequired] public PublishedRelationship Record { get; set; } = default!;
    [Parameter, EditorRequired] public PublicationCatalog Catalog { get; set; } = default!;
}
