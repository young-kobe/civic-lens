@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

@if (!Highlights.Votes.IsEmpty || !Highlights.ExecutiveActions.IsEmpty)
{
    <section class="home-section" id="latest" aria-labelledby="home-latest-title">
        <h2 id="home-latest-title">Latest from the record</h2>
        <div class="latest-columns">
            @LatestColumn("House votes", IconName.Vote, Highlights.Votes)
            @LatestColumn("Executive actions", IconName.ExecutiveAction, Highlights.ExecutiveActions)
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public HomeHighlights Highlights { get; set; } = default!;

    private static RenderFragment LatestColumn(string title, IconName icon, IReadOnlyList<PublishedRecordEntry> rows) => rows.Count == 0 ? _ => { } : @<div>
        <h3 class="latest-title"><Icon Name="icon" />@title</h3>
        <ul class="latest-rows" role="list">
            @foreach (var row in rows)
            {
                <li>
                    <a href="@PublicationProtocol.RecordPagePath(row.RecordId)">
                        <span>@row.Headline</span>
                        <span class="muted small">@Moment.Day(ReleaseRecordOrder.Day(row))</span>
                    </a>
                </li>
            }
        </ul>
    </div>;
}
