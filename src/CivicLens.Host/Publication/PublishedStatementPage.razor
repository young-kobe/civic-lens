@using System.Collections.Immutable
@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts
@using CivicLens.PublicWeb.Publication

<PublishedRecordFrame Kind="PublishedRecordKind.Statement" Corrections="Record.Corrections" RecordId="@Record.RecordId" RevisionNumber="@Record.RevisionNumber" ShortName="@PublishedStatementView.ShortName(Record)" Headline="@Record.Headline" Summary="@Record.Summary" Facts="PublishedStatementView.Facts(Record, Catalog)"
                      Caveat="@StatementPageView.CaptureCaveat">
    <PublishedRelatedPanel Related="Related" Kind="PublishedRecordKind.Statement" RecordId="@Record.RecordId" />
    <PublishedTimeline Events="PublishedTimelineView.For(Record)" />

    <Panel Title="Quotations" Id="quotations-title" Padded="true">
        <p class="muted small">Each quote is the exact text of the source. Follow its link to see it marked in the full saved text.</p>
        <ul class="choices">
            @for (var index = 0; index < Record.Quotations.Length; index++)
            {
                var quotation = Record.Quotations[index];
                var number = index + 1;
                var target = ContextLink.QuoteTarget("statement", index, Record.Quotations.Length);
                var anchor = "#" + CitedText.Anchor(index);
                <li>
                    <CitationQuote Label="@($"Quote {number}")" Quote="@quotation.Quote">
                        <StatusBadge Text="@PublishedRecordLabels.Quotation(quotation.Kind)" />
                        <ContextLink Href="@anchor" Target="@target" />
                    </CitationQuote>
                </li>
            }
            @if (Record.StatementDateEvidence is { } evidence)
            {
                <DateEvidenceLine Label="Evidence for the statement date" Quote="@evidence.Quote">
                    <ContextLink Href="@("#" + StatementPageView.DateEvidenceAnchor)" Target="@ContextLink.QuoteTarget("statement date")" />
                </DateEvidenceLine>
            }
        </ul>
    </Panel>

    <Panel Title="Source text" Id="source-title" Padded="true">
        @if (Record.ArticleUrl is { } article)
        {
            <p class="muted small">Article: <a href="@article" rel="noopener noreferrer nofollow">@article</a>. @StatementPageView.FeedNote</p>
        }
        <VersionSource Version="Record.Source" />
        <DocumentText Label="Source text" Runs="CitedText.Split(Record.Source.Text, StatementPageView.Ranges(Record.Quotations, Record.StatementDateEvidence))" />
    </Panel>
</PublishedRecordFrame>

@code {
    [Parameter, EditorRequired] public PublishedStatement Record { get; set; } = default!;
    [Parameter, EditorRequired] public PublicationCatalog Catalog { get; set; } = default!;
    [Parameter] public ImmutableArray<PublishedRelationship> Related { get; set; }
}
