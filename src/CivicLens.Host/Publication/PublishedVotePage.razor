@using CivicLens.Host.Components.Evidence
@using System.Collections.Immutable
@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

<PublishedRecordFrame Corrections="Record.Corrections" RecordId="@Record.RecordId" RevisionNumber="@Record.RevisionNumber" Headline="@Record.Headline" Summary="@Record.Summary" Facts="PublishedVoteView.Facts(Record, Catalog)"
                      Caveat="@PublishedVoteView.Caveat(Record)">
    @if (PublishedVoteView.Badge(Record) is { } badge)
    {
        <Panel Title="How the parties voted" Id="parties-title" Padded="true">
            <p><StatusBadge Text="@badge.Text" /></p>
            <p>@badge.Meaning</p>
            <p>@badge.Counts</p>
        </Panel>
    }

    <PublishedRelatedPanel Related="Related" Kind="PublishedRecordKind.Vote" RecordId="@Record.RecordId" />
    <PublishedTimeline Events="PublishedTimelineView.For(Record)" />

    @if (PublishedVoteView.Bill(Record) is { } bill)
    {
        <Panel Title="Bill" Id="bill-title" Padded="true">
            @if (BillActionRecordId is not null)
            {
                <a href="@PublishedRecordView.RecordLink(BillActionRecordId)">@bill</a>
            }
            else
            {
                <span>@bill</span>
            }
        </Panel>
    }

    @if (PublishedVoteView.Breakers(Record).ToArray() is { Length: > 0 } breakers)
    {
        <Panel Title="Members who voted against most of their party" Id="breakers-title" Padded="true">
            <p class="muted small">@PublishedVoteView.BreakMeaning</p>
            @foreach (var party in breakers)
            {
                <section class="member-group">
                    @if (party.Members.Length == 0)
                    {
                        <p class="small">@party.None</p>
                    }
                    else
                    {
                        <h3>@party.Heading</h3>
                        <ul class="member-list">
                            @foreach (var member in party.Members)
                            {
                                <PublishedVoteMember Record="Record" Member="member" ShowCast="true" />
                            }
                        </ul>
                    }
                </section>
            }
        </Panel>
    }

    <Panel Title="How each tracked member voted" Id="members-title" Padded="true">
        @foreach (var group in PublishedVoteView.CastGroups(Record))
        {
            <section class="member-group">
                <h3>@group.Lead<CastWord Cast="@group.Cast">@group.Word</CastWord>@group.Count</h3>
                <ul class="member-list">
                    @foreach (var member in group.Members)
                    {
                        <PublishedVoteMember Record="Record" Member="member" />
                    }
                </ul>
            </section>
        }
    </Panel>

    <Panel Title="Sources" Id="sources-title" Padded="true">
        <SourceLinesNote>@PublishedVoteView.SavedData(Record)</SourceLinesNote>
        @for (var index = 0; index < Record.Sources.Length; index++)
        {
            var source = Record.Sources[index];
            <VersionSource Version="source" Linked="false" />
            <DocumentText Label="@($"Source text {index + 1} of {Record.Sources.Length}")" Runs="CitedText.Split(source.Text, PublishedVoteView.RangesIn(Record, source))" />
        }
    </Panel>
</PublishedRecordFrame>

@code {
    [Parameter, EditorRequired] public PublishedVote Record { get; set; } = default!;
    [Parameter, EditorRequired] public PublicationCatalog Catalog { get; set; } = default!;
    [Parameter] public ImmutableArray<PublishedRelationship> Related { get; set; }
    [Parameter] public string? BillActionRecordId { get; set; }
}
