@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

<PublicPage Section="PublicSection.Officials" CanonicalPath="@Board.PagePath" Title="@PublishedBoardView.Title(Board)" Description="@PublishedBoardView.Description(Page)">
    <PageHeader Title="@PublishedBoardView.Title(Board)" Lede="@PublishedBoardView.Lede(Page)" />
    <FilterTabs Label="@PublishedBoardView.TabsLabel" Tabs="PublishedBoardView.Tabs(Board)" />
    @if (ClosestVote is { } closest)
    {
        <Panel Title="@PublishedBoardView.ClosestTitle(closest)" Padded="true">
            <p><PublishedRecordTitle RecordId="@closest.Entry.RecordId">@closest.Entry.Headline</PublishedRecordTitle><PublishedVoteListFacts Entry="closest.Entry" /></p>
            @if (closest.BillLine is not null)
            {
                <p><PublishedBillLine Line="@closest.BillLine" /></p>
                <PublishedBillLineNote />
            }
            <p>@PublishedBoardView.VoteGap(closest)</p>
            <p class="muted small">@PublishedBoardView.VotePool(closest)</p>
            <p class="muted small">@PublishedBoardView.ClosestRule</p>
        </Panel>
    }
    @if (Agreement is { } agreement)
    {
        <Panel Title="@PublishedBoardView.AgreementTitle(agreement)" Padded="true">
            <p>@BoardWords.AgreementLead(agreement.Chamber, agreement.Congress, agreement.Agreed, agreement.Total)</p>
            @if (agreement.Total > 0)
            {
                <DataTable Roles="true" Items="PublishedBoardView.AgreementRows(agreement)" Caption="@PublishedBoardView.AgreementCaption">
                    <Head><TableCell Header>@PublishedBoardView.AgreementKindHeader</TableCell><TableCell Header>@VoteWords.PartiesAgreedBadge</TableCell></Head>
                    <Row Context="row">
                        <TableCell Main>@row.Label</TableCell>
                        <TableCell Label="@VoteWords.PartiesAgreedBadge">@row.Count</TableCell>
                    </Row>
                </DataTable>
                <p>@BoardWords.AgreementSplit(agreement.Split, agreement.Total)</p>
                @if (agreement.Mixed > 0)
                {
                    <p>@BoardWords.AgreementMixed(agreement.Mixed, agreement.Total)</p>
                }
                @if (BoardWords.ShowsNominationNote(agreement.Nominations, agreement.Total))
                {
                    <p class="muted small">@BoardWords.NominationNote(agreement.Total)</p>
                }
            }
            <p class="muted small">@VoteWords.PartiesAgreedMeaning @BoardWords.AgreementCaution</p>
            <p class="muted small"><a href="@(PublicationProtocol.MethodPagePath + PublishedBoardView.AgreementAnchor)">@PublishedBoardView.AgreementLinkText</a></p>
        </Panel>
    }
    @if (Page.Congress is { } congress)
    {
        @if (Page.NewerCongress is { } newer)
        {
            <p>@BoardWords.KeptCongress(newer, congress)</p>
        }
        @if (Page.NewestRollCall is { } newest)
        {
            <p class="muted small">@BoardWords.NewestRollCall(congress, newest)</p>
        }
        <Panel Title="@PublishedBoardView.BreakersTitle(Board)" Padded="true">
            <p>@VoteWords.SplitMeaning</p>
            <p class="muted small">@PublishedBoardView.RankingRule(Board) @PublishedBoardView.ReadingNote</p>
            @Split(Page.Breakers, PublishedBoardView.BreakersTitle(Board), PublishedBoardView.AgainstShareHeader(Board), member => member.Breaks, member => member.BreakShare, congress)
        </Panel>
        <Panel Title="@PublishedBoardView.LoyalistsTitle(Board)" Padded="true">
            <p class="muted small">@PublishedBoardView.RankingRule(Board)</p>
            @Split(Page.Loyalists, PublishedBoardView.LoyalistsTitle(Board), PublishedBoardView.WithShareHeader(Board), member => member.Matched, member => member.MatchShare, congress)
        </Panel>
        <Panel Title="@PublishedBoardView.MissedTitle(Board)" Padded="true">
            <p>@PublishedOfficialView.MissedVoteMeaning</p>
            <p class="muted small">@PublishedBoardView.Cause</p>
            <DataTable Roles="true" PagedRows="officials" Items="Page.MostMissed" Caption="@PublishedBoardView.MissedTitle(Board)" DefaultOrder="@PublishedBoardView.MostMissedOrder">
                <Head><TableCell Header Sort="SortKind.Text">Official</TableCell><TableCell Header Sort="SortKind.Number" DefaultSort="true">Missed votes</TableCell></Head>
                <Row Context="member">
                    <TableCell Main><CellTitle Href="@member.PagePath">@member.Official.Profile.Name</CellTitle></TableCell>
                    <TableCell Label="Missed votes" SortValue="@member.Missed!.Missed.ToString()">@PublishedOfficialView.MissedVotes(new MissedVotes(member.Missed.Chamber, member.Missed.Missed, member.Missed.Held, member.Missed.First, member.Missed.Last), congress)</TableCell>
                </Row>
                <Empty><EmptyState Title="No roll calls yet" Text="@PublishedBoardView.NoMissedList(Board)" /></Empty>
            </DataTable>
        </Panel>
        @if (!Page.TooFewSplitVotes.IsEmpty)
        {
            <Panel Title="@PublishedBoardView.TooFewTitle" Padded="true">
                <p>@PublishedBoardView.TooFew(Page.TooFewSplitVotes.Length)</p>
                <ul>
                    @foreach (var member in Page.TooFewSplitVotes)
                    {
                        <li><a href="@member.PagePath">@member.Official.Profile.Name</a>: @member.Cast split @PublishedOfficialView.Noun(member.Cast, "vote") cast</li>
                    }
                </ul>
            </Panel>
        }
    }
    <Panel Title="@PublishedBoardView.LeftOutTitle" Padded="true">
        <ul>
            @foreach (var line in PublishedBoardView.LeftOut(Page))
            {
                <li>@line</li>
            }
        </ul>
        <p class="muted small"><a href="@PublicationProtocol.MethodPagePath">How these lists are built</a></p>
    </Panel>
</PublicPage>

@code {
    [Parameter, EditorRequired] public OfficialBoardPage Page { get; set; } = default!;
    [Parameter] public ClosestVote? ClosestVote { get; set; }
    [Parameter] public ChamberAgreement? Agreement { get; set; }

    private OfficialBoard Board => Page.Board;

    private RenderFragment Split(IReadOnlyList<BoardMember> members, string caption, string header, Func<BoardMember, int> counted, Func<BoardMember, double> share, int congress) => @<text>
        <DataTable Roles="true" PagedRows="officials" Items="members" Caption="@caption" DefaultOrder="@PublishedBoardView.ShareOrder">
            <Head><TableCell Header Sort="SortKind.Text">Official</TableCell><TableCell Header Sort="SortKind.Number" SortLabel="@PublishedBoardView.ShareSortName" DefaultSort="true">@header</TableCell></Head>
            <Row Context="member">
                <TableCell Main><CellTitle Href="@member.PagePath">@member.Official.Profile.Name</CellTitle></TableCell>
                <TableCell Label="@header" SortValue="@PublishedBoardView.SortShare(share(member))">@PublishedOfficialView.SplitVoteCount(counted(member), member.Cast)</TableCell>
            </Row>
            <Empty><EmptyState Title="No ranked members" Text="@PublishedBoardView.NoRankedMembers(Board, congress)" /></Empty>
        </DataTable>
    </text>;
}
