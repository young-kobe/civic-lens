@using CivicLens.Publication.Contracts

@if (Corrections.Length > 0)
{
    <ul class="choices corrections" aria-label="Corrections">
        @foreach (var correction in Corrections)
        {
            <li>
                <strong>@if (correction.Note is not null) {<Term Key="correction">@PublishedCorrectionView.Title(correction)</Term>} else {<text>@PublishedCorrectionView.Title(correction)</text>}@PublishedCorrectionView.AfterTitle(correction)</strong>
                @if (correction.Note is not null)
                {
                    <p>@correction.Note</p>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public PublishedCorrection[] Corrections { get; set; } = [];
}
