@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

<DataTable Roles="true" Items="Records" Caption="@Caption">
    <Head>
        <TableCell Header>Record</TableCell>
        @if (FacetColumns)
        {
            <TableCell Header>@PublicColumn.Officials</TableCell>
            <TableCell Header Class="fit num">@PublicColumn.Date</TableCell>
        }
        else
        {
            <TableCell Header Class="fit num">@PublicColumn.FirstPublished</TableCell>
        }
    </Head>
    <Row Context="entry">
        <TableCell Main><a class="cell-title" href="@(RootPath + PublicationProtocol.RecordPagePath(entry.RecordId))">@entry.Headline</a> <StatusBadge Text="@PublishedRecordLabels.Kind(entry.Kind)" /></TableCell>
        @if (FacetColumns)
        {
            <TableCell Label="@PublicColumn.Officials">@string.Join(", ", entry.Officials.Select(official => official.Name))</TableCell>
            <TableCell Class="fit num" Label="@PublicColumn.Date">@Moment.Iso(ReleaseRecordOrder.Day(entry))</TableCell>
        }
        else
        {
            <TableCell Class="time fit num" Label="@PublicColumn.FirstPublished"><Timestamp Value="entry.FirstPublishedAtUtc" Format="TimestampFormat.Day" /></TableCell>
        }
    </Row>
    <Empty><EmptyState Title="No records yet" Text="There are no records here." /></Empty>
</DataTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PublishedRecordEntry> Records { get; set; } = [];
    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;
    [Parameter] public string RootPath { get; set; } = string.Empty;
    [Parameter] public bool FacetColumns { get; set; }
}
