@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

<DataTable Items="Records" Caption="@Caption">
    <Head>
        <th>Record</th>
        @if (FacetColumns)
        {
            <th>@PublicColumn.Officials</th>
            <th class="fit num">@PublicColumn.Date</th>
        }
        else
        {
            <th class="fit num">@PublicColumn.FirstPublished</th>
        }
    </Head>
    <Row Context="entry">
        <td><a class="cell-title" href="@(RootPath + PublicationProtocol.RecordPagePath(entry.RecordId))">@entry.Headline</a> <StatusBadge Text="@PublishedRecordLabels.Kind(entry.Kind)" /></td>
        @if (FacetColumns)
        {
            <td data-label="@PublicColumn.Officials">@string.Join(", ", entry.Officials.Select(official => official.Name))</td>
            <td class="fit num" data-label="@PublicColumn.Date">@Moment.Iso(ReleaseRecordOrder.Day(entry))</td>
        }
        else
        {
            <td class="time fit num" data-label="@PublicColumn.FirstPublished"><Timestamp Value="entry.FirstPublishedAtUtc" Format="TimestampFormat.Day" /></td>
        }
    </Row>
    <Empty><EmptyState Title="No records yet" Text="There are no records here." /></Empty>
</DataTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PublishedRecordEntry> Records { get; set; } = [];
    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;
    [Parameter] public string RootPath { get; set; } = string.Empty;
    [Parameter] public bool FacetColumns { get; set; }
}
