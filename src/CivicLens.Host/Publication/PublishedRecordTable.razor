@using System.Text.Json
@using CivicLens.Application.Publication
@using CivicLens.Publication.Contracts

<DataTable Roles="true" Items="Records" Caption="@Caption" DefaultOrder="@(Sort is null ? null : PublishedRecordLabels.NewestFirst)" data-sort-source="@SortSource">
    <Head>
        <TableCell Header Sort="@Sortable(SortKind.Text)" SortKey="@Key("headline")">Record</TableCell>
        @switch (Columns)
        {
            case RecordTableColumns.Facet:
                <TableCell Header>@PublicColumn.Officials</TableCell>
                <TableCell Header Class="fit num" Sort="@Sortable(SortKind.Date)" SortKey="@Key("date")" DefaultSort="@(Sort is not null)">@PublicColumn.Date</TableCell>
                break;
            case RecordTableColumns.Week:
                <TableCell Header Class="fit num">@PublicColumn.WeekOf</TableCell>
                <TableCell Header Class="fit num">@PublicColumn.FirstPublished</TableCell>
                break;
            case RecordTableColumns.Dated:
                <TableCell Header Class="fit num" Sort="@Sortable(SortKind.Date)" SortKey="@Key("date")" DefaultSort="@(Sort is not null)">@PublicColumn.Date</TableCell>
                break;
        }
    </Head>
    <Row Context="entry">
        <TableCell Main><PublishedRecordTitle RecordId="@entry.RecordId" RootPath="@RootPath">@entry.Headline</PublishedRecordTitle>@if (Columns != RecordTableColumns.Week) {@(" ")<StatusBadge Text="@PublishedRecordLabels.Kind(entry.Kind)" />}@if (entry.Kind == PublishedRecordKind.Vote) {<PublishedVoteListFacts Entry="entry" />}</TableCell>
        @switch (Columns)
        {
            case RecordTableColumns.Facet:
                <TableCell Label="@PublicColumn.Officials">@string.Join(", ", entry.Officials.Select(official => official.Name))</TableCell>
                <TableCell Class="fit num" Label="@PublicColumn.Date">@Moment.Day(ReleaseRecordOrder.Day(entry))</TableCell>
                break;
            case RecordTableColumns.Week:
                <TableCell Class="fit num" Label="@PublicColumn.WeekOf">@Moment.Day(ReleaseRecordOrder.Day(entry))</TableCell>
                <TableCell Class="time fit num" Label="@PublicColumn.FirstPublished"><Timestamp Value="entry.FirstPublishedAtUtc" Format="TimestampFormat.Day" /></TableCell>
                break;
            case RecordTableColumns.Dated:
                <TableCell Class="fit num" Label="@PublicColumn.Date">@Moment.Day(ReleaseRecordOrder.Day(entry))</TableCell>
                break;
        }
    </Row>
    <Empty><EmptyState Title="No records yet" Text="There are no records here." /></Empty>
</DataTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PublishedRecordEntry> Records { get; set; } = [];
    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;
    [Parameter] public string RootPath { get; set; } = string.Empty;
    [Parameter] public RecordTableColumns Columns { get; set; }
    [Parameter] public RecordSort? Sort { get; set; }

    private SortKind Sortable(SortKind kind) => Sort is null ? SortKind.None : kind;

    private string? Key(string key) => Sort is null ? null : key;

    private string? SortSource => Sort is null ? null : JsonSerializer.Serialize(new
    {
        api = Sort.ApiUrl,
        total = Sort.Total,
        filter = Sort.Filter,
        root = RootPath,
        pageSize = PublicationProtocol.PageSize,
        columns = Columns.ForSort(),
        kinds = PublishedRecordLabels.KindLabels
    }, PublicationProtocol.JsonOptions);
}
