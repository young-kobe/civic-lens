@using CivicLens.Publication.Contracts

<DataTable Items="Records" Caption="@Caption">
    <Head><th>Record</th><th class="fit num hide-narrow">First published</th></Head>
    <Row Context="entry">
        <td><a class="cell-title" href="@(RootPath + PublicationProtocol.RecordPagePath(entry.RecordId))">@entry.Headline</a> <StatusBadge Text="@PublishedRecordLabels.Kind(entry.Kind)" /></td>
        <td class="time fit num hide-narrow"><Timestamp Value="entry.FirstPublishedAtUtc" Format="TimestampFormat.Day" /></td>
    </Row>
    <Empty><EmptyState Title="No records yet" Text="There are no records here." /></Empty>
</DataTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PublishedRecordEntry> Records { get; set; } = [];
    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;
    [Parameter] public string RootPath { get; set; } = string.Empty;
}
