@if (Header)
{
    <th scope="col" role="@(Roles ? "columnheader" : null)" class="@Class" data-sort="@SortName" data-sort-key="@SortKey">@ChildContent</th>
}
else
{
    <td role="@(Roles ? (Main ? "rowheader" : "cell") : null)" class="@BodyClass" data-label="@Label" data-sort-value="@SortValue">@ChildContent</td>
}

@code {
    public const string RolesCascade = "TableRoles";

    [CascadingParameter(Name = RolesCascade)] public bool Roles { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Header { get; set; }
    [Parameter] public bool Main { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public SortKind Sort { get; set; }
    [Parameter] public string? SortKey { get; set; }
    [Parameter] public string? SortValue { get; set; }

    private string? SortName => Sort == SortKind.None ? null : Sort.ToString().ToLowerInvariant();
    private string? BodyClass => Main ? Class is null ? "cell-main" : $"cell-main {Class}" : Class;
}
