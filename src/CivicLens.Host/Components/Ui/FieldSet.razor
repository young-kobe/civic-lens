<fieldset class="field" disabled="@Disabled" id="@Id">
    <legend>@Legend@if (Aside is not null) { <span class="field-optional"> @Aside</span> }</legend>
    @ChildContent
    @if (Hint is not null)
    {
        <span class="field-hint">@Hint</span>
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public string Legend { get; set; } = string.Empty;
    [Parameter] public string? Aside { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
