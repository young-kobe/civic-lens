@typeparam TItem

@if (Items.Count == 0)
{
    @Empty
}
else
{
    <div class="@(Scroll ? "table-wrap table-wrap-scroll" : "table-wrap")">
        <table class="@(Stack ? "table table-stack" : "table")" role="@(Roles ? "table" : null)" data-default-order="@DefaultOrder" data-paged="@(PagedRows is null ? null : PagedRowCount)" data-rows-noun="@PagedRows" @attributes="TableAttributes">
            @if (Caption is not null)
            {
                <caption class="visually-hidden">@Caption@(DefaultOrder is null ? null : $". {DefaultOrder}.")</caption>
            }
            <CascadingValue Name="@TableCell.RolesCascade" Value="Roles" IsFixed="true">
                <thead role="@RowGroupRole"><tr role="@RowRole">@Head</tr></thead>
                <tbody role="@RowGroupRole">
                    @foreach (var item in Items)
                    {
                        <tr class="@RowClass?.Invoke(item)" data-filter-keys="@RowFilterKeys?.Invoke(item)" role="@RowRole">@Row(item)</tr>
                    }
                </tbody>
            </CascadingValue>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment Head { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TItem> Row { get; set; } = default!;
    [Parameter] public RenderFragment? Empty { get; set; }
    [Parameter] public string? Caption { get; set; }
    [Parameter] public bool Scroll { get; set; }
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }
    [Parameter] public Func<TItem, string?>? RowFilterKeys { get; set; }
    [Parameter] public bool Roles { get; set; }
    [Parameter] public bool Stack { get; set; }
    [Parameter] public string? DefaultOrder { get; set; }

    /// <summary>The plural noun of the rows. When set, a script shows <see cref="PagedRowCount"/> rows a page. Without the script every row shows.</summary>
    [Parameter] public string? PagedRows { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? TableAttributes { get; set; }

    public const int PagedRowCount = 15;

    protected override void OnParametersSet()
    {
        if (PagedRows is not null && Caption is null)
            throw new ArgumentException("A paged table needs a caption to name its pager.", nameof(Caption));
    }

    private string? RowGroupRole => Roles ? "rowgroup" : null;
    private string? RowRole => Roles ? "row" : null;
}
