@if (Filterable)
{
    <span data-count-filter="@Key" data-filter-label="@Label" data-filter-shows="@Notice">@Text</span>
}
else
{
    @Text
}

@code {
    [Parameter, EditorRequired] public bool Filterable { get; set; }
    [Parameter, EditorRequired] public string Text { get; set; } = default!;
    [Parameter, EditorRequired] public string Key { get; set; } = default!;
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public string Notice { get; set; } = default!;
}
