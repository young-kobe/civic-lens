@if (Href is not null)
{
    <a class="@CssClass" href="@Href" @attributes="AdditionalAttributes">@ChildContent</a>
}
else
{
    <button class="@CssClass" type="@Type" disabled="@Disabled" @onclick="OnClick" @attributes="AdditionalAttributes">@ChildContent</button>
}

@code {
    [Parameter] public ButtonVariant Variant { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass
    {
        get
        {
            var variant = Variant switch
            {
                ButtonVariant.Primary => " btn-primary",
                ButtonVariant.Danger => " btn-danger",
                ButtonVariant.Quiet => " btn-quiet",
                _ => ""
            };
            return $"btn{variant}{(Small ? " btn-small" : "")}";
        }
    }
}
