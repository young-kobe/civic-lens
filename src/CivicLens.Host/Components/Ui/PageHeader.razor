<header class="@HeaderClass">
    @if (Portrait is not null)
    {
        <div class="page-header-portrait">@Portrait</div>
    }
    <div>
        <h1>@Title</h1>
        @if (Lede is not null)
        {
            <p class="page-header-lede">@Lede</p>
        }
        @if (Meta is not null)
        {
            <div class="page-header-meta row">@Meta</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Lede { get; set; }
    [Parameter] public bool Serif { get; set; }
    [Parameter] public RenderFragment? Portrait { get; set; }
    [Parameter] public RenderFragment? Meta { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    private string HeaderClass => Serif ? "page-header page-header-serif" : "page-header";
}
