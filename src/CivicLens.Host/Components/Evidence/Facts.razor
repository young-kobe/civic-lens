<dl class="facts">
    @foreach (var fact in Items)
    {
        <dt>@fact.Label</dt>
        <dd>
            @if (fact.Links is null)
            {
                @fact.Value
            }
            else
            {
                @for (var index = 0; index < fact.Links.Count; index++)
                {
                    @(index > 0 ? fact.Separator : "")
                    @if (fact.Links[index].Href is { } href)
                    {
                        <a href="@href">@fact.Links[index].Text</a>
                    }
                    else
                    {
                        @fact.Links[index].Text
                    }
                }
            }
        </dd>
    }
</dl>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Fact> Items { get; set; } = [];
}
