@inherits LayoutComponentBase
@using CivicLens.Core.Review
@using CivicLens.Host.Review
@inject ReviewActorAccessor Actors

<a class="skip" href="#main">Skip to content</a>
<div class="shell">
    <aside class="rail">
        <a class="brand" href="/Review"><BrandMark />Civic Lens</a>
        <nav class="nav" aria-label="Workspace">
            <RailLink Href="/Review" Text="Review" Icon="IconName.Review" Sections="ReviewSections" Excluding="SourcesSection" />
            @if (role == ReviewRole.Owner)
            {
                <RailLink Href="/Review/Sources" Text="Sources" Icon="IconName.Sources" />
            }
        </nav>
        <div class="rail-foot">
            <span class="avatar" aria-hidden="true">@RoleName[0]</span>
            <span>@RoleName</span>
            <form method="post" action="/Review/Logout">
                <AntiforgeryToken />
                <button type="submit" title="Sign out"><Icon Name="IconName.SignOut" /><span class="visually-hidden">Sign out</span></button>
            </form>
        </div>
    </aside>
    <div class="frame">
        <header class="topbar">
            <nav class="crumbs" aria-label="Breadcrumb"><SectionOutlet SectionName="@CrumbsSection" /></nav>
            <div class="topbar-tools"><ThemeToggle /></div>
        </header>
        <main class="main" id="main" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@code {
    public const string CrumbsSection = "topbar-crumbs";

    private static readonly IReadOnlyList<string> ReviewSections = ["/Documents"];
    private static readonly IReadOnlyList<string> SourcesSection = ["/Review/Sources"];
    private ReviewRole role;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string RoleName => role == ReviewRole.Owner ? "Owner" : "Reviewer";

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null) return;
        var state = await AuthenticationState;
        role = Actors.GetActor(state.User).Role;
    }
}
