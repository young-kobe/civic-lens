@page "/Review/Sources"
@model CivicLens.Host.Pages.Review.SourcesModel
@using CivicLens.Application.Collection.Jobs
@using CivicLens.Collection.Contracts
@using CivicLens.Core.Collection
@{
    ViewData["Title"] = "Sources";
}
<header class="review-heading">
    <div><h1>Sources</h1><p>Check official sources and follow new document changes into review.</p></div>
    <a class="review-button review-button-primary" asp-page="/Review/Index">Review inbox</a>
</header>
@if (Model.Error is not null) { <p class="review-error" role="alert">@Model.Error</p> }
@if (Model.Message is not null) { <p class="review-status success" role="status" aria-live="polite">@Model.Message</p> }
@if (Model.Configuration is { } configuration)
{
    <p class="review-help sources-workflow">Checks collect articles, prepare readable text, and send changes to review.</p>
    <p id="activity-refresh-status" class="review-help" role="status" aria-live="polite">Activity updates automatically.</p>
    <section aria-labelledby="sources-title">
        <div class="sources-section-heading"><h2 id="sources-title">Official sources</h2><label class="review-field-label" for="source-search">Find a source</label><input id="source-search" class="workspace-search" type="search" data-list-search="official-source-list" aria-describedby="source-search-status" /></div>
        <p id="source-search-status" class="review-help sources-search-status" role="status" aria-live="polite" data-list-status="official-source-list"></p>
        <div class="review-list" id="official-source-list">
        @foreach (var source in configuration.Sources)
        {
            var mode = source.Mode switch { CollectionMode.Feed => "News feed", CollectionMode.Html => "Newsroom", _ => "Tracked page" };
            var sourceJobs = Model.Jobs.Where(job => job.Definition.SourceId == source.Id && job.Definition.Url == source.Url).ToArray();
            var recentJob = sourceJobs.FirstOrDefault();
            var processing = recentJob is null ? null : Model.Processing.GetValueOrDefault(recentJob.JobId);
            var busy = sourceJobs.Any(job => job.State is CollectionJobState.Pending or CollectionJobState.Running or CollectionJobState.WaitingToRetry) ||
                sourceJobs.Any(job => Model.Processing.GetValueOrDefault(job.JobId)?.IsActive == true);
            <article class="review-list-item collection-source sources-source" data-list-item data-source-id="@source.Id">
                <div class="sources-source-copy">
                    <div class="review-meta"><span>@mode</span><span>@(source.Enabled ? "Enabled" : "Disabled")</span></div>
                    <h3>@Model.SourceLabel(source)</h3>
                    <p><a href="@source.Url" rel="noreferrer">@CivicLens.Host.Pages.Review.SourcesModel.DocumentLabel(source.Url)</a></p>
                    <p class="sources-result" aria-live="polite">
                        @if (processing is not null)
                        {
                            <span class="review-state @(processing.NeedsAttention ? "concern" : "")">@processing.Label</span>
                            @if (!string.IsNullOrWhiteSpace(processing.Detail)) { <span>@processing.Detail</span> }
                        }
                        else if (recentJob is not null)
                        {
                            <span class="review-state">@CivicLens.Host.Pages.Review.SourcesModel.StateLabel(recentJob)</span>
                            <span>Latest check status.</span>
                        }
                        else { <span>No check yet.</span> }
                    </p>
                    <details class="review-details"><summary>Collection limits</summary><p>Up to @(source.JobPolicy?.MaxAttempts ?? 3) attempts, @source.MaxRequests requests per attempt.</p></details>
                </div>
                <form method="post" asp-page-handler="Collect">
                    <input type="hidden" name="sourceId" value="@source.Id" />
                    <input type="hidden" name="requestKey" value="@Model.SourceRequestKey(source.Id)" />
                    <button class="review-button review-button-primary" type="submit" disabled="@(!source.Enabled || busy)">Check</button>
                </form>
            </article>
        }
        </div>
    </section>
    <section class="review-section-spaced sources-activity" aria-labelledby="activity-title">
        <div class="sources-section-heading"><div><h2 id="activity-title">Recent activity</h2><p class="review-help">Latest @CivicLens.Application.Collection.CollectionWorkspace.RecentJobLimit checks across all sources.</p></div></div>
        @if (Model.Jobs.Count == 0)
        {
            <p class="review-empty" data-activity-empty>No checks yet. Choose <strong>Check</strong> on an official source to begin. Its articles and text will be prepared automatically for review.</p>
        }
        <div class="review-list" id="source-activity" data-activity-url="@Url.Page("/Review/Sources", "Activity")">
        @foreach (var job in Model.Jobs)
        {
            var processing = Model.Processing.GetValueOrDefault(job.JobId);
            var label = processing?.Label ?? CivicLens.Host.Pages.Review.SourcesModel.StateLabel(job);
            var isActive = processing?.IsActive ?? (job.State is CollectionJobState.Pending or CollectionJobState.Running or CollectionJobState.WaitingToRetry);
            <article class="review-list-item sources-activity-item" data-job-id="@job.JobId">
                <div>
                    <div class="review-meta"><span class="review-state @(processing?.NeedsAttention == true ? "concern" : "")">@label</span><time datetime="@job.CreatedAt.ToString("O")">@job.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</time></div>
                    <h3>@CivicLens.Host.Pages.Review.SourcesModel.DocumentLabel(job.Definition.Url)</h3>
                    <p>@Model.JobSourceLabel(job)@if (processing?.Detail is { Length: > 0 } detail) { <span> · @detail</span> }</p>
                </div>
                <div class="sources-activity-actions">
                    @if (processing?.ComparisonId is { Length: > 0 } comparisonId)
                    {
                        <form method="post" asp-page="/Review/Index" asp-page-handler="Create">
                            <input type="hidden" name="comparisonId" value="@comparisonId" />
                            <input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                            <button class="review-button review-button-primary" type="submit">Review</button>
                        </form>
                    }
                    else if (job.State is CollectionJobState.Pending or CollectionJobState.Running or CollectionJobState.WaitingToRetry)
                    {
                        <form method="post" asp-page-handler="Cancel">
                            <input type="hidden" name="jobId" value="@job.JobId" />
                            <button class="review-button" type="submit">Stop</button>
                        </form>
                    }
                    else if (!isActive)
                    {
                        <a class="review-button" asp-page="/Review/Sources" asp-route-jobId="@job.JobId" asp-fragment="troubleshooting">Details</a>
                    }
                    else { <span class="review-help">In progress</span> }
                </div>
            </article>
        }
        </div>
    </section>
    @if (Model.SelectedJob is { } selected)
    {
        var source = configuration.Sources.SingleOrDefault(item => item.Id == selected.Definition.SourceId);
        <details class="review-section-spaced sources-troubleshooting" id="troubleshooting" open>
            <summary>Troubleshooting and manual controls</summary>
            <div class="collection-detail" aria-labelledby="selected-title">
                <div class="collection-section-heading"><div><h2 id="selected-title">Source check details</h2><p class="collection-url"><a href="@selected.Definition.Url" rel="noreferrer">@CivicLens.Host.Pages.Review.SourcesModel.DocumentLabel(selected.Definition.Url)</a></p></div><span class="review-state">@CivicLens.Host.Pages.Review.SourcesModel.StateLabel(selected)</span></div>
                <details class="review-details"><summary>Check timing and collection limits</summary><p class="review-help">Queued @selected.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") · @selected.Attempts.Count attempt(s) · @selected.ReservedRequests / @(selected.Definition.Policy.MaxTotalRequests ?? selected.Definition.MaxRequests * selected.Definition.Policy.MaxAttempts) requests charged or reserved</p></details>
                @if (selected.RetryAt is { } retry) { <p class="review-help">Eligible to retry after @retry.ToString("yyyy-MM-dd HH:mm:ss 'UTC'"). Source pacing may delay it further.</p> }
                @if (selected.State is CollectionJobState.Pending or CollectionJobState.Running or CollectionJobState.WaitingToRetry)
                {
                    <form method="post" asp-page-handler="Cancel"><input type="hidden" name="jobId" value="@selected.JobId" /><button class="review-button review-button-danger" type="submit">Stop</button></form>
                    <p class="review-help">If work stays queued, check that the worker is running. This page does not report worker liveness.</p>
                }
                @if (selected.Attempts.Count == 0) { <p class="review-empty">This check is waiting to start. Its status will appear here when the collection worker picks it up.</p> }
                @foreach (var attempt in selected.Attempts.Reverse())
                {
                    var receipt = attempt.Resolution?.Receipt;
                    var retained = Model.RetainedAttempts.GetValueOrDefault(attempt.AttemptId);
                    var discovery = retained?.Discovery?.ToResult() ?? receipt?.Discovery;
                    var captured = retained?.AttemptResult is CapturedAttemptResult || receipt?.Outcome == CollectionOutcome.Captured;
                    <article class="collection-attempt">
                        <h3>Attempt started @attempt.StartedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</h3>
                        @if (receipt is null)
                        {
                            @if (retained is not null) { <p>Imported evidence is retained; the transport receipt is unavailable.</p><p class="review-help">Observed @retained.AttemptResult.ObservedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</p> }
                            else { <p>@(attempt.Resolution is null ? "No settled result yet. Work may be active or awaiting recovery." : "No transport receipt is available. Inspect document history for any imported evidence.")</p>@if (attempt.Resolution?.ErrorCode is { } error) { <p class="review-help">Recorded outcome: @error</p> } }
                        }
                        else
                        {
                            <p>Result: <strong>@receipt.Outcome</strong> · @receipt.RequestCount request(s) · @receipt.BytesReceived.ToString("N0") bytes received</p>
                            @if (receipt.FailureCode is { } failure) { <p class="review-status warning">Collection reported @failure. This is a coverage gap, not evidence of no activity.</p> }
                            @if (receipt.Outcome == CollectionOutcome.NotModified) { <p class="review-help">The server reported no modification. Inspect the earlier captured observation in document history.</p> }
                        }
                        @if (discovery is not null)
                        {
                            <p>Link discovery: <strong>@discovery.Status</strong> · @discovery.Urls.Length candidate(s)</p>
                            @if (discovery.Status == DiscoveryStatus.Parsed && discovery.Urls.Length > 0 && source?.Mode is CollectionMode.Feed or CollectionMode.Html)
                            {
                                <details class="review-details"><summary>Articles found</summary><ol class="collection-candidates">@foreach (var url in discovery.Urls) { <li><a href="@url" rel="noreferrer">@url</a></li> }</ol></details>
                                <form method="post" asp-page-handler="Admit"><input type="hidden" name="jobId" value="@selected.JobId" /><input type="hidden" name="attemptId" value="@attempt.AttemptId" /><input type="hidden" name="requestKey" value="@(Model.RequestKey ?? Guid.NewGuid().ToString("N"))" /><button class="review-button" type="submit">Queue articles</button></form>
                                <p class="review-help">Queues up to @(source.AdmissionPolicy?.MaxJobs ?? 10) articles within your collection limits. Already queued articles are skipped. Some links may be navigation rather than relevant articles.</p>
                            }
                            else if (discovery.Status != DiscoveryStatus.Parsed) { <p class="review-status warning">The response was retained, but discovery did not complete. No partial candidate list was admitted.</p> }
                        }
                        @if (captured && source?.DocumentProfileId is not null && discovery is null)
                        {
                            <form method="post" asp-page-handler="Extract"><input type="hidden" name="jobId" value="@selected.JobId" /><input type="hidden" name="attemptId" value="@attempt.AttemptId" /><button class="review-button" type="submit">Extract text</button></form>
                        }
                    </article>
                }
                @if (selected.Definition.Mode == CollectionMode.Page && selected.State is not (CollectionJobState.Pending or CollectionJobState.Running or CollectionJobState.WaitingToRetry))
                {
                    <form method="post" asp-page-handler="Recollect"><input type="hidden" name="jobId" value="@selected.JobId" /><input type="hidden" name="requestKey" value="@(Model.RequestKey ?? Guid.NewGuid().ToString("N"))" /><button class="review-button" type="submit">Check</button></form>
                }
                <h3>Saved document versions</h3>
                @if (Model.HistoryError is not null) { <p class="review-status warning" role="alert">@Model.HistoryError</p> }
                else if (Model.History is { } history)
                {
                    var versions = history.Observations.SelectMany(item => item.Extractions).DistinctBy(item => item.ExtractionId).OrderByDescending(item => item.SourceAttempt.ObservedAt).ToArray();
                    @if (versions.Length == 0) { <p class="review-empty">No readable version is available yet. A saved page must finish preparation before its text can be compared.</p> }
                    else
                    {
                        <p class="review-help">Select two versions to compare. A first version sets the baseline; a later version is needed to show changes.</p>
                        <form method="post" asp-page-handler="Compare"><input type="hidden" name="jobId" value="@selected.JobId" /><fieldset class="collection-version-picker"><legend>Versions to compare</legend>
                        @foreach (var version in versions)
                        {
                            <div class="collection-version"><div><a asp-page="/Documents/Extraction" asp-route-extractionId="@version.ExtractionId">Observed @version.SourceAttempt.ObservedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</a><details class="review-details"><summary>Processing details</summary><p class="review-help">@version.Text.Length.ToString("N0") text units · @version.ParserVersion · profile @(version.Profile?.RevisionId[..8] ?? "none")</p></details></div><label><input type="radio" name="beforeId" value="@version.ExtractionId" required /> Earlier</label><label><input type="radio" name="afterId" value="@version.ExtractionId" required /> Later</label></div>
                        }
                        </fieldset><button class="review-button" type="submit" disabled="@(versions.Length < 2)">Compare</button></form>
                    }
                }
                <details class="review-details"><summary>Collection identifiers</summary><dl class="review-ids"><div><dt>Job ID</dt><dd>@selected.JobId</dd></div><div><dt>Source ID</dt><dd>@selected.Definition.SourceId</dd></div></dl></details>
            </div>
        </details>
    }
}
