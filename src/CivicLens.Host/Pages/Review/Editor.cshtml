@page "/Review/{draftId}"
@model CivicLens.Host.Pages.Review.EditorModel
@using CivicLens.Core.Review
@{
    ViewData["Title"] = "Edit review draft";
}
<a class="review-back" asp-page="/Review/Index">← Review queue</a>
@if (Model.Error is not null)
{
    <div class="review-error" role="alert">@Model.Error</div>
}
@if (Model.Status is not null)
{
    <p class="review-status @(Model.IsConflict ? "warning" : "success")" role="status">@Model.Status</p>
}
@if (Model.Review is not null)
{
    var revision = Model.Review.CurrentRevision;
    var latestDecision = Model.Review.Decisions.Where(decision => decision.RevisionNumber == revision.RevisionNumber)
        .OrderByDescending(decision => decision.ReviewStateVersion).FirstOrDefault();
    <header class="review-heading">
        <div>
            <h1>@(string.IsNullOrWhiteSpace(revision.Headline) ? "Untitled public record" : revision.Headline)</h1>
            <p>Revision @revision.RevisionNumber · @if (Model.Review.UnresolvedConcerns.Length > 0) { <span class="review-state concern">@Model.Review.UnresolvedConcerns.Length outstanding concern(s)</span> } else if (latestDecision?.Kind == ReviewDecisionKind.Approve) { <span class="review-state approved">Approved for publication</span> } else if (latestDecision?.Kind == ReviewDecisionKind.WithdrawApproval) { <span class="review-state withdrawn">Approval withdrawn</span> } else { <span class="review-state">Awaiting review</span> }</p>
        </div>
    </header>

    @if (Model.Status == "saved")
    {
        <p class="review-banner">A new immutable revision was saved. Review this version before recording a decision.</p>
    }
    @if (Model.Review.UnresolvedConcerns.Length > 0)
    {
        <div class="review-banner warning" role="status"><strong>Approval is blocked by outstanding concerns.</strong> Select each concern you have resolved and write how it was addressed. Saving a revision alone leaves concerns open.</div>
    }
    @if (Model.IsDraftConflict)
    {
        <section class="review-conflict-compare" aria-labelledby="conflict-title">
            <h2 id="conflict-title">Compare the latest saved revision with your unsaved wording</h2>
            <div class="review-pair">
                <article>
                    <h3>Latest saved · Revision @revision.RevisionNumber</h3><p><strong>@(string.IsNullOrWhiteSpace(revision.Headline) ? "Untitled draft" : revision.Headline)</strong></p><p>@revision.Summary</p><p><strong>Why it matters:</strong> @revision.Significance</p><p><strong>Limits:</strong> @revision.Limits</p><p><strong>Institution:</strong> @revision.Institution</p><p><strong>Actual change date:</strong> @(revision.ChangeDate?.ToString("yyyy-MM-dd") ?? "Not established")</p><p><strong>Official links:</strong> @string.Join(", ", revision.OfficialIds)</p><p><strong>Issues:</strong> @string.Join(", ", revision.IssueIds)</p>
                    <details class="review-details"><summary>Latest evidence bindings · @revision.Citations.Length</summary><ol class="review-saved-citations">@foreach (var citation in Model.Citations) { <li><span>@EncodedEvidence.From(citation.Quote)</span></li> }</ol></details>
                </article>
                <article>
                    <h3>Your unsaved edits</h3><p><strong>@(string.IsNullOrWhiteSpace(Model.Input.Headline) ? "Untitled draft" : Model.Input.Headline)</strong></p><p>@Model.Input.Summary</p><p><strong>Why it matters:</strong> @Model.Input.Significance</p><p><strong>Limits:</strong> @Model.Input.Limits</p><p><strong>Institution:</strong> @Model.Input.Institution</p><p><strong>Actual change date:</strong> @(string.IsNullOrWhiteSpace(Model.Input.ChangeDate) ? "Not established" : Model.Input.ChangeDate)</p><p><strong>Official links:</strong> @string.Join(", ", Model.Input.OfficialIds ?? [])</p><p><strong>Issues:</strong> @string.Join(", ", Model.Input.IssueIds ?? [])</p>
                    <details class="review-details"><summary>Your evidence bindings</summary><ol class="review-saved-citations">@foreach (var option in Model.EvidenceOptions.Where(option => (Model.Input.EvidenceSelection ?? []).Contains(option.Key) || (!string.IsNullOrWhiteSpace(Model.Input.ChangeDate) && Model.Input.DateEvidenceSelection == option.Key))) { <li><span>@EncodedEvidence.From(option.Quote)</span></li> }</ol></details>
                </article>
            </div>
            <p>Review both versions before saving. The editor still contains your wording; saving again will create a new revision based on the latest saved version.</p>
        </section>
    }

    <div class="review-columns">
        <section class="review-column" aria-labelledby="preview-title">
            <h2 id="preview-title">Reader preview</h2>
            @{
                var previewHeadline = string.IsNullOrWhiteSpace(Model.Input.Headline) ? "Your headline will appear here" : Model.Input.Headline;
                var previewSummary = string.IsNullOrWhiteSpace(Model.Input.Summary) ? "Add a plain-language summary of what the evidence establishes." : Model.Input.Summary;
                var previewInstitution = string.IsNullOrWhiteSpace(Model.Input.Institution) ? "Add the institution named by the source" : Model.Input.Institution;
                var previewChangeDate = string.IsNullOrWhiteSpace(Model.Input.ChangeDate) ? "Not established" : Model.Input.ChangeDate;
                var previewObserved = $"{Model.BeforeObservedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")} before; {Model.AfterObservedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")} after";
                var previewOfficialLinks = (Model.Input.OfficialIds?.Length ?? 0) == 0 ? "None selected" : string.Join(", ", Model.Input.OfficialIds ?? []);
                var previewIssues = (Model.Input.IssueIds?.Length ?? 0) == 0 ? "None selected" : string.Join(", ", Model.Input.IssueIds ?? []);
            }
            <component type="typeof(RecordPreview)" render-mode="Static"
                       param-RevisionNumber="@revision.RevisionNumber"
                       param-Headline="@previewHeadline"
                       param-Summary="@previewSummary"
                       param-Significance="@Model.Input.Significance"
                       param-Limits="@Model.Input.Limits"
                       param-Institution="@previewInstitution"
                       param-ChangeDate="@previewChangeDate"
                       param-Observed="@previewObserved"
                       param-OfficialLinks="@previewOfficialLinks"
                       param-Issues="@previewIssues" />

            <form method="post" asp-page-handler="Save" class="review-editor-form" data-unsaved-form data-recovered-unsaved="@Model.HasUnsavedInput.ToString().ToLowerInvariant()">
                <input type="hidden" name="draftId" value="@revision.DraftId" />
                <input type="hidden" name="expectedRevisionNumber" value="@revision.RevisionNumber" />
                <input type="hidden" name="idempotencyKey" value="@Model.SaveIdempotencyKey" />
                <h2>Edit public wording</h2>
                <div class="review-field"><label asp-for="Input.Headline">Public headline</label><input asp-for="Input.Headline" maxlength="256" /><small>Maximum 256 characters.</small></div>
                <div class="review-field"><label asp-for="Input.Summary">Plain-language summary</label><textarea asp-for="Input.Summary" maxlength="8000"></textarea><small>Describe what the retained source establishes and keep chronology separate from causation.</small></div>
                <div class="review-field"><label asp-for="Input.Significance">Why it matters <span class="review-help">(optional)</span></label><textarea asp-for="Input.Significance" maxlength="4000"></textarea></div>
                <div class="review-field"><label asp-for="Input.Limits">Limits and uncertainty <span class="review-help">(optional)</span></label><textarea asp-for="Input.Limits" maxlength="4000"></textarea></div>
                <div class="review-field"><label asp-for="Input.Institution">Source institution attribution</label><input asp-for="Input.Institution" maxlength="256" /></div>
                <div class="review-field"><label asp-for="Input.ChangeDate">Actual change date <span class="review-help">(optional)</span></label><input asp-for="Input.ChangeDate" type="date" /><small>Leave blank unless the source supports a date distinct from the observation dates.</small></div>
                <div class="review-field"><label asp-for="Input.DateEvidenceSelection">Evidence supporting the actual change date</label><select asp-for="Input.DateEvidenceSelection"><option value="">No actual change date selected</option>@foreach (var option in Model.EvidenceOptions) { <option value="@option.Key">@option.Label</option> }</select><small>If you enter an actual change date, select the retained passage that supports it. The selected passage will be included in this revision's citations.</small></div>
                <fieldset class="review-fieldset">
                    <legend>Supported official links</legend>
                    @if (Model.AvailableOfficialIds.Length == 0)
                    {
                        <p class="review-help">No official links are configured for this workspace.</p>
                    }
                    else
                    {
                        <ul class="review-check-list">
                        @foreach (var id in Model.AvailableOfficialIds)
                        {
                            <li><label><input type="checkbox" name="Input.OfficialIds" value="@id" checked="@(Model.Input.OfficialIds?.Contains(id) == true)" />@id</label></li>
                        }
                        </ul>
                    }
                </fieldset>
                <fieldset class="review-fieldset">
                    <legend>Configured issue categories</legend>
                    @if (Model.AvailableIssueIds.Length == 0)
                    {
                        <p class="review-help">No issue categories are configured for this workspace.</p>
                    }
                    else
                    {
                        <ul class="review-check-list">
                        @foreach (var id in Model.AvailableIssueIds)
                        {
                            <li><label><input type="checkbox" name="Input.IssueIds" value="@id" checked="@(Model.Input.IssueIds?.Contains(id) == true)" />@id</label></li>
                        }
                        </ul>
                    }
                </fieldset>
                <section class="review-bound-citations" aria-labelledby="citation-title">
                    <h3 id="citation-title">Evidence bindings for this revision</h3>
                    <p class="review-help">Choose the exact changed passages that support the public claims. Their extraction IDs and UTF-16 offsets remain bound to each saved revision.</p>
                    @if (Model.Comparison is not null && Model.Comparison.Hunks.Length > 32)
                    {
                        <p class="review-banner">The first revision starts with passages from 32 comparison hunks. Add any relevant passages from the other changes before saving.</p>
                    }
                    @if (Model.EvidenceOptions.Length == 0)
                    {
                        <p class="review-error">No non-empty changed passage is available to cite in this comparison.</p>
                    }
                    else
                    {
                        <ul class="review-citation-list">
                        @foreach (var option in Model.EvidenceOptions)
                        {
                            <li><label class="review-citation-option"><input type="checkbox" name="Input.EvidenceSelection" value="@option.Key" checked="@Model.Input.EvidenceSelection.Contains(option.Key)" /><span><strong>@option.Label</strong><br /><span>@EncodedEvidence.From(option.Quote)</span></span></label><details class="review-details"><summary>Evidence identifiers</summary><dl class="review-ids"><div><dt>Extraction ID</dt><dd>@option.Citation.ExtractionId</dd></div><div><dt>UTF-16 start</dt><dd>@option.Citation.Start</dd></div><div><dt>Length</dt><dd>@option.Citation.Length</dd></div></dl></details></li>
                        }
                        </ul>
                        <p class="review-help">A revision can bind up to 64 cited passages. Choose relevant spans from the full comparison below.</p>
                    }
                    @if (Model.Citations.Length > 0)
                    {
                        <details class="review-details"><summary>Verify passages already bound to this revision</summary>
                            <ol class="review-saved-citations">
                            @foreach (var citation in Model.Citations)
                            {
                                <li><span>@EncodedEvidence.From(citation.Quote)</span><small>Retained extraction @citation.ExtractionId · UTF-16 @citation.Start + @citation.Length</small></li>
                            }
                            </ol>
                        </details>
                    }
                    @if (Model.Citations.Length != revision.Citations.Length)
                    {
                        <p class="review-error">One or more saved citations could not be verified against retained text. Keep this unresolved before approving.</p>
                    }
                </section>
                <div class="review-actions"><button type="submit" class="review-button review-button-primary">Save new revision</button><a class="review-button" asp-page="/Review/Index">Cancel</a></div>
            </form>
        </section>

        <section class="review-column review-evidence-column" aria-labelledby="evidence-title">
            <h2 id="evidence-title">Check the retained evidence</h2>
            @if (Model.Comparison is not null)
            {
                <p class="review-help">A text difference does not establish that the edit is substantive. Read both versions and check the surrounding source text.</p>
                @foreach (var hunk in Model.Comparison.Hunks)
                {
                    <article class="review-evidence">
                        <div class="review-pair">
                            <div class="review-passage"><h3>Before · @Model.BeforeObservedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")</h3><p><span>@EncodedEvidence.From(hunk.BeforeText.Length == 0 ? "No text at this insertion point." : hunk.BeforeText)</span></p></div>
                            <div class="review-passage"><h3>After · @Model.AfterObservedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")</h3><p><span>@EncodedEvidence.From(hunk.AfterText.Length == 0 ? "No text at this deletion point." : hunk.AfterText)</span></p></div>
                        </div>
                        @if (hunk.BeforeContext.Length > 0 || hunk.AfterContext.Length > 0)
                        {
                            <details class="review-details"><summary>Read surrounding context</summary><div class="review-pair"><div class="review-passage"><h3>Before context</h3><p><span>@EncodedEvidence.From(hunk.BeforeContext)</span></p></div><div class="review-passage"><h3>After context</h3><p><span>@EncodedEvidence.From(hunk.AfterContext)</span></p></div></div></details>
                        }
                    </article>
                }
                <p><a asp-page="/Documents/Extraction" asp-route-extractionId="@Model.Comparison.BeforeExtractionId">Read complete earlier version</a> · <a asp-page="/Documents/Extraction" asp-route-extractionId="@Model.Comparison.AfterExtractionId">Read complete later version</a></p>
                <details class="review-details"><summary>Comparison and source identifiers</summary>
                    <dl class="review-ids">
                        <div><dt>Source</dt><dd>@Model.SourceId</dd></div>
                        <div><dt>Requested URL</dt><dd>@Model.RequestedUrl</dd></div>
                        <div><dt>Before final URL</dt><dd>@Model.BeforeFinalUrl</dd></div>
                        <div><dt>After final URL</dt><dd>@Model.AfterFinalUrl</dd></div>
                        <div><dt>Comparison ID</dt><dd>@revision.ComparisonId</dd></div>
                        <div><dt>Before extraction</dt><dd>@Model.Comparison.BeforeExtractionId</dd></div>
                        <div><dt>After extraction</dt><dd>@Model.Comparison.AfterExtractionId</dd></div>
                    </dl>
                </details>
            }
        </section>
    </div>

    <section class="review-decision" aria-labelledby="decision-title">
        <h2 id="decision-title">Review this exact revision</h2>
                @if (Model.Review.UnresolvedConcerns.Length > 0)
        {
            <fieldset class="review-fieldset">
                <legend>Outstanding concerns to resolve</legend>
                <ul class="review-concern-list">
                @foreach (var concern in Model.Review.UnresolvedConcerns)
                {
                    <li class="review-concern"><label><input type="checkbox" name="Decision.ResolvedDecisionIds" value="@concern.DecisionId" form="decision-form" />
                        <span><strong>@(string.IsNullOrWhiteSpace(concern.Note) ? "Concern without a note" : concern.Note)</strong><br /><small>Decision @concern.DecisionId · Revision @concern.RevisionNumber</small></span>
                    </label></li>
                }
                </ul>
            </fieldset>
        }
        <p id="decision-unsaved-warning" hidden="@Model.CanDecide" class="review-banner warning">Save your edits or reload the saved revision before making a review decision. Decisions apply only to saved wording.</p>
        <form method="post" asp-page-handler="Decide" id="decision-form">
            <fieldset id="decision-controls" disabled="@(!Model.CanDecide)">
            <legend>Decision for saved revision @revision.RevisionNumber</legend>
            <input type="hidden" name="draftId" value="@revision.DraftId" />
            <input type="hidden" name="expectedRevisionNumber" value="@revision.RevisionNumber" />
            <input type="hidden" name="expectedReviewStateVersion" value="@Model.Review.ReviewStateVersion" />
            <input type="hidden" name="idempotencyKey" value="@Model.DecisionIdempotencyKey" />
            <div class="review-field"><label asp-for="Decision.Note">Review note or resolution explanation</label><textarea asp-for="Decision.Note" maxlength="4000" aria-describedby="decision-help"></textarea><small id="decision-help">Request changes and withdrawal require a reason. If concerns are outstanding, approval requires selecting and explaining their resolution.</small></div>
            <div class="review-actions">
                @if (latestDecision?.Kind != ReviewDecisionKind.Approve)
                {
                    <button class="review-button review-button-primary" type="submit" name="kind" value="Approve">Approve revision</button>
                }
                <button class="review-button" type="submit" name="kind" value="RequestChanges">Request changes</button>
                @if (latestDecision?.Kind == ReviewDecisionKind.Approve)
                {
                    <button class="review-button review-button-danger" type="submit" name="kind" value="WithdrawApproval">Withdraw approval</button>
                }
            </div>
            </fieldset>
        </form>
    </section>

    <section class="review-history" aria-labelledby="history-title">
        <h2 id="history-title">Revision and decision history</h2>
        @foreach (var pastRevision in Model.Review.Revisions.OrderByDescending(item => item.RevisionNumber))
        {
            <article class="review-history-item">
                <time>Revision @pastRevision.RevisionNumber<br />@pastRevision.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</time>
                <div><strong>@(string.IsNullOrWhiteSpace(pastRevision.Headline) ? "Untitled draft" : pastRevision.Headline)</strong><p>@pastRevision.Summary</p><p class="review-help">@(pastRevision.AuthorSubject == Model.ActorSubject ? "Created by you" : "Created by another authorized reviewer")</p><details class="review-details"><summary>Revision details</summary><p>Institution: @pastRevision.Institution</p><p>Why it matters: @pastRevision.Significance</p><p>Limits: @pastRevision.Limits</p><p>Actual change date: @(pastRevision.ChangeDate?.ToString("yyyy-MM-dd") ?? "Not established")</p><p>Issue categories: @string.Join(", ", pastRevision.IssueIds)</p><p>Official links: @string.Join(", ", pastRevision.OfficialIds)</p><p>Evidence citations: @pastRevision.Citations.Length</p></details></div>
            </article>
        }
        @foreach (var decision in Model.Review.Decisions.OrderByDescending(item => item.ReviewStateVersion))
        {
            <article class="review-history-item">
                <time>@decision.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</time>
                <div><span class="review-state @(decision.Kind == ReviewDecisionKind.Approve ? "approved" : decision.Kind == ReviewDecisionKind.RequestChanges ? "concern" : "withdrawn")">@decision.Kind</span> <span class="review-help">Revision @decision.RevisionNumber · @(decision.ActorSubject == Model.ActorSubject ? "You" : "Another authorized reviewer")</span>
                    @if (!string.IsNullOrWhiteSpace(decision.Note)) { <p class="review-note">@decision.Note</p> }
                    @if (decision.ResolvedDecisionIds.Length > 0) { <p class="review-help">Resolved concerns: @string.Join(", ", decision.ResolvedDecisionIds)</p> }
                </div>
            </article>
        }
    </section>
}
