@page
@model IndexModel
@{ ViewData["Title"] = "Evidence library"; }
<section class="library-intro">
    <h1>Saved documents</h1>
    <p>Open a document’s retained source history, then inspect its saved text and citations.</p>
</section>
@if (Model.Error is not null) { <p class="notice error" role="alert">@Model.Error</p> }
<section class="library-search" aria-labelledby="search-heading">
    <h2 id="search-heading">Find a saved document</h2>
    <p>Document search is not available yet. Use advanced lookup if you already have a source ID or evidence ID.</p>
    <form role="search" class="document-search" aria-describedby="search-status">
        <label for="evidence-search">Search saved documents</label>
        <div class="search-control"><input id="evidence-search" name="query" type="search" disabled /><button type="submit" disabled>Search</button></div>
        <div id="document-results" class="search-results" aria-live="polite" aria-describedby="search-status"></div>
        <p id="search-status" class="muted">No document search is available yet. Use advanced lookup to open saved evidence by its exact ID.</p>
    </form>
</section>
<details class="advanced-lookup">
    <summary>Advanced lookup by exact ID</summary>
    <div class="lookup-list">
        <section class="lookup">
            <h2>Source history</h2><p>Enter the source ID and exact requested URL to open its retained observations.</p>
            <form method="get" asp-page="/Documents/History">
                <label for="sourceId">Source ID</label><input id="sourceId" name="sourceId" required />
                <label for="requestedUrl">Exact requested URL</label><input id="requestedUrl" name="requestedUrl" required />
                <button type="submit">Open source history</button>
            </form>
        </section>
        <section class="lookup">
            <h2>Saved extraction</h2><p>Open the complete saved text from a source observation.</p>
            <form method="get" asp-page="/Documents/Extraction">
                <label for="extractionId">Extraction ID</label><input id="extractionId" name="extractionId" required maxlength="64" pattern="[a-f0-9]{64}" />
                <button type="submit">Open saved text</button>
            </form>
        </section>
        <section class="lookup">
            <h2>Saved comparison</h2><p>Open a previously saved comparison result.</p>
            <form method="get" asp-page="/Documents/Comparison">
                <label for="comparisonId">Comparison ID</label><input id="comparisonId" name="comparisonId" required maxlength="64" pattern="[a-f0-9]{64}" />
                <button type="submit">Open comparison</button>
            </form>
        </section>
    </div>
</details>
