@page
@model ExtractionModel
@{ ViewData["Title"] = "Saved document text"; }
<p class="back"><a asp-page="/Index">← Saved documents</a></p>
@if (Model.Error is not null) { <section class="notice @(Model.IsMissing ? "" : "error")" role="alert"><h1>@Model.ErrorTitle</h1><p>@Model.Error</p></section> }
else if (Model.Extraction is { } extraction)
{
    <header class="page-heading"><h1>Saved document text</h1><p>Text retained from this source observation.</p></header>
    <p class="observation-date">Observed @extraction.SourceAttempt.ObservedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</p>
    <details class="metadata"><summary>Document, capture, and processing details</summary>
        <dl><dt>Extraction ID</dt><dd><code>@extraction.ExtractionId</code></dd><dt>Source ID</dt><dd><code>@extraction.SourceAttempt.SourceId</code></dd><dt>Requested URL</dt><dd class="break-all">@extraction.SourceAttempt.RequestedUrl</dd><dt>Attempt ID</dt><dd><code>@extraction.SourceAttempt.AttemptId</code></dd><dt>Final URL</dt><dd class="break-all">@extraction.SourceAttempt.FinalUrl</dd><dt>Capture SHA-256</dt><dd><code>@extraction.SourceAttempt.Capture.Sha256</code></dd><dt>Capture bytes</dt><dd>@extraction.SourceAttempt.Capture.ByteLength</dd><dt>HTTP status</dt><dd>@extraction.SourceAttempt.Response.StatusCode</dd><dt>Content type</dt><dd>@(extraction.SourceAttempt.Response.ContentType ?? "Not recorded")</dd><dt>Parser</dt><dd>@extraction.ParserVersion</dd><dt>Normalization</dt><dd>@extraction.NormalizationVersion</dd><dt>Text SHA-256</dt><dd><code>@extraction.TextSha256</code></dd><dt>Text length</dt><dd>@extraction.Text.Length UTF-16 units</dd>@if (extraction.Profile is { } profile) { <dt>Content profile</dt><dd>@profile.Id · revision <code>@profile.RevisionId</code></dd> }
        </dl>
    </details>
    <section class="text-section"><h2>Complete saved text</h2><p>To cite a passage, enter its start and length below. Positions start at zero; some characters count as two units.</p><pre class="evidence-text" tabindex="0"><span>@EncodedEvidence.From(extraction.Text)</span></pre>
        <form method="get" asp-page="/Documents/Citation" class="citation-form">
            <input type="hidden" name="extractionId" value="@extraction.ExtractionId" />
            <label for="start">Start offset</label><input id="start" name="start" type="number" min="0" required />
            <label for="length">Length</label><input id="length" name="length" type="number" min="1" required />
            <button type="submit">Show citation</button>
        </form>
    </section>
}
