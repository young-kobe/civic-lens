@page
@model CitationModel
@{ ViewData["Title"] = "Exact citation"; }
<p class="back"><a asp-page="/Index">← Saved documents</a></p>
@if (Model.Error is not null) { <section class="notice @(Model.IsMissing ? "" : "error")" role="alert"><h1>@Model.ErrorTitle</h1><p>@Model.Error</p>@if (Model.Span is null) { <p><a asp-page="/Documents/Extraction" asp-route-extractionId="@Model.ExtractionId">Return to extraction</a></p> }</section> }
else if (Model.Span is { } span)
{
    <header class="page-heading"><h1>Exact citation</h1><p>This passage is retained verbatim from the saved document text.</p></header>
    <blockquote class="quote"><pre><span>@EncodedEvidence.From(span.Quote)</span></pre></blockquote>
    <p><a asp-page="/Documents/Extraction" asp-route-extractionId="@span.ExtractionId">Return to saved document text</a></p>
    <details class="metadata"><summary>Citation details</summary><dl><dt>Extraction ID</dt><dd><a asp-page="/Documents/Extraction" asp-route-extractionId="@span.ExtractionId"><code>@span.ExtractionId</code></a></dd><dt>Start position</dt><dd>@span.Start</dd><dt>Length</dt><dd>@span.Length UTF-16 units</dd></dl></details>
}
