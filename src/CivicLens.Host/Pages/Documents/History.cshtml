@page
@model HistoryModel
@using CivicLens.Core.Collection
@{ ViewData["Title"] = "Source history"; }
<p class="back"><a asp-page="/Index">← Saved documents</a></p>
@if (Model.Error is not null) { <section class="notice error" role="alert"><h1>@Model.ErrorTitle</h1><p>@Model.Error</p></section> }
else if (Model.History is not null)
{
    <header class="page-heading"><h1>Source history</h1><p>Saved observations for this document, newest first.</p></header>
    <details class="metadata"><summary>Source and URL details</summary><dl><dt>Source ID</dt><dd><code>@Model.SourceId</code></dd><dt>Requested URL</dt><dd class="break-all">@Model.RequestedUrl</dd></dl></details>
    @if (Model.History.Observations.IsEmpty) { <p class="notice">No observations were found for this exact source and URL. Check the identifiers; an empty history does not establish that the source was unchanged.</p> }
    @if (Model.History.Observations.Length == HistoryModel.Limit) { <p class="notice">Showing the bounded history limit of @HistoryModel.Limit observations. A larger history cannot be represented here yet.</p> }
    <section class="history-list" aria-label="Observations">
    @foreach (var item in Model.History.Observations.Reverse())
    {
        var attempt = item.Attempt.AttemptResult;
        var outcome = attempt switch { CapturedAttemptResult => "Captured", NotModifiedAttemptResult => "Not modified", FailedAttemptResult => "Could not capture", DeferredAttemptResult => "Collection deferred", _ => "Unknown outcome" };
        <article class="observation">
            <div class="observation-top"><h2>@outcome</h2><time datetime="@attempt.ObservedAt.ToString("O")">Observed UTC @attempt.ObservedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</time></div>
            @if (attempt.Response is { } response) { <p>HTTP @response.StatusCode @if (!string.IsNullOrEmpty(response.ContentType)) { <span>· @response.ContentType</span> }</p> }
            @if (item.Extractions.IsEmpty) { <p class="muted">No extraction is retained for this observation.</p> }
            else
            {
                <ul class="extraction-links">@foreach (var extraction in item.Extractions) { <li><a asp-page="/Documents/Extraction" asp-route-extractionId="@extraction.ExtractionId">Read saved text</a><details class="inline-details"><summary>Processing details</summary><p>Extraction <code>@extraction.ExtractionId</code> · @extraction.ParserVersion · @extraction.NormalizationVersion@if (extraction.Profile is not null) { <span> · profile @extraction.Profile.Id</span> }</p></details></li> }</ul>
            }
            <details class="metadata"><summary>Capture and attempt details</summary>
                <dl><dt>Attempt ID</dt><dd><code>@attempt.AttemptId</code></dd>
                @if (item.Attempt.PriorCapturedAttempt is { } prior) { <dt>Prior capture attempt</dt><dd><code>@prior.AttemptId</code> · SHA-256 <code>@prior.Capture.Sha256</code> · @prior.Capture.ByteLength bytes</dd> }
                @if (attempt is CapturedAttemptResult captured) { <dt>Capture</dt><dd>SHA-256 <code>@captured.Capture.Sha256</code> · @captured.Capture.ByteLength bytes</dd> }
                @if (attempt is FailedAttemptResult failed) { <dt>Failure code</dt><dd><code>@failed.FailureCode</code></dd> }
                @if (attempt is DeferredAttemptResult deferred) { <dt>Deferral code</dt><dd><code>@deferred.FailureCode</code></dd> }</dl>
            </details>
        </article>
    }
    </section>
}
