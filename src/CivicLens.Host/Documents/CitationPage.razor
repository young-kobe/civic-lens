@page "/Documents/Citation"
@using System.Globalization
@using CivicLens.Application.Documents
@using CivicLens.Core.Documents
@inject IDocumentExtractionStore Extractions

<TopBarTitle Crumbs="Crumbs" />

<div class="content">
    <PageHeader Title="Cited passage" Lede="This passage is kept word for word from the saved text." />
    @if (problem is not null)
    {
        <EvidenceProblemView Problem="problem" />
    }
    else if (span is not null && extraction is not null)
    {
        <CitationQuote Label="Cited passage" Quote="@span.Quote">
            <a href="#@AnchorId">Show in the saved text</a>
            <a href="@EvidenceLinks.Extraction(span.ExtractionId)">Open the saved text</a>
        </CitationQuote>
        <Panel Padded="true" Label="About this passage">
            <Facts Items="@([new Fact("Observed", Moment.Full(extraction.SourceAttempt.ObservedAt)), new Fact("URL", extraction.SourceAttempt.RequestedUrl), new Fact("Start", span.Start.ToString(CultureInfo.InvariantCulture)), new Fact("Length", $"{span.Length} UTF-16 units")])" />
            <TechnicalDetails Items="EvidenceFacts.Identifiers(extraction)" />
        </Panel>
        <Panel Title="Saved text">
            <DocumentText Label="Saved text with the cited passage marked" Runs="CitedText.Split(extraction.Text, [new CitedRange(AnchorId, span.Start, span.Length)])" />
        </Panel>
    }
</div>

@code {
    private const string AnchorId = "cited-passage";
    private static readonly IReadOnlyList<Crumb> Crumbs = [new("Review", "/Review"), new("Cited passage")];
    private DocumentExtraction? extraction;
    private DocumentTextSpan? span;
    private EvidenceProblem? problem;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ExtractionId { get; set; }
    [SupplyParameterFromQuery] private string? Start { get; set; }
    [SupplyParameterFromQuery] private string? Length { get; set; }

    protected override async Task OnInitializedAsync()
    {
        problem = await LoadAsync();
        if (problem is not null) EvidenceProblem.SetStatus(HttpContext.Response, problem.StatusCode);
    }

    private async Task<EvidenceProblem?> LoadAsync()
    {
        if (!EvidenceProblem.IsHash(ExtractionId) || !TryParse(Start, out var start) || !TryParse(Length, out var length) || length == 0)
            return EvidenceProblem.Invalid;
        try
        {
            extraction = await Extractions.GetAsync(ExtractionId!, HttpContext.RequestAborted);
            if (extraction is null) return EvidenceProblem.Missing("Saved text");
            span = new DocumentTextSpan(extraction, start, length);
            return null;
        }
        catch (OperationCanceledException) when (HttpContext.RequestAborted.IsCancellationRequested) { throw; }
        catch (ArgumentException) { return EvidenceProblem.OutsideText; }
        catch (Exception) { return EvidenceProblem.Unavailable; }
    }

    private static bool TryParse(string? value, out int number) =>
        int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out number);
}
