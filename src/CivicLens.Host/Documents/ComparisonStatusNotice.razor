@using CivicLens.Core.Documents

@if (Comparison.Hunks.IsEmpty)
{
    <Notice Title="No text changed">The two saved texts are the same.</Notice>
}
else
{
    <p class="muted small">Text differences alone do not show that a change matters.</p>
}

@code {
    [Parameter, EditorRequired] public DocumentComparison Comparison { get; set; } = default!;
}
